@implements IDisposable
@inject IArchiveWorkflow ArchiveWorkflow
@inject IMessageService Message

<section class="archive-center">
    <div class="mobile-archive-note">
        <Alert Type="@AlertType.Info"
               Message="档案管理以桌面端为主"
               Description="请在较大的屏幕上保存、导入或调阅本机档案；移动端继续保留咨询和速查流程。"
               ShowIcon="true" />
    </div>

    <div class="archive-management-surface">
        <header class="archive-toolbar">
            <div>
                <span>本机档案</span>
                <h2>档案调阅</h2>
                <p>档案保存在当前浏览器中，也可以打开外部档案文档；这些操作不会把文档上传到服务端。</p>
            </div>
            <div class="archive-toolbar-actions">
                @if (CanImport)
                {
                    <Button OnClick="ImportAsync" AutoLoading Disabled="@OperationInProgress">
                        <Icon Type="folder-open" Theme="IconThemeType.Outline" />
                        打开文档
                    </Button>
                }
                @if (CanExportStored)
                {
                    <Button OnClick="ExportStoredAsync"
                            AutoLoading
                            Disabled="@(!selectedDocumentId.HasValue || OperationInProgress)">
                        @if (!exporting)
                        {
                            <Icon Type="download" Theme="IconThemeType.Outline" />
                        }
                        @(exporting ? "正在导出…" : "导出所选档案")
                    </Button>
                }
                @if (CanBrowse)
                {
                    <Button OnClick="LoadRecordsAsync" AutoLoading Disabled="@OperationInProgress">
                        <Icon Type="reload" Theme="IconThemeType.Outline" />
                        刷新列表
                    </Button>
                }
                @if (CanClear && records.Count > 0)
                {
                    <Button Danger
                            Disabled="@OperationInProgress"
                            OnClick="OpenClearDialog">
                        <Icon Type="delete" Theme="IconThemeType.Outline" />
                        清空档案库
                    </Button>
                }
            </div>
        </header>

        @if (feedback is not null)
        {
            <div class="archive-feedback">
                <ArchiveOperationFeedback Result="feedback" />
            </div>
        }

        <div class="archive-workspace">
            <aside class="archive-list" aria-label="本机档案列表">
                @if (loading)
                {
                    <Skeleton Active />
                }
                else if (records.Count == 0)
                {
                    <Empty Description="@("尚未保存本机档案")" />
                }
                else
                {
                    @foreach (var group in PatientGroups)
                    {
                        <section class="archive-patient-group" data-patient-id="@group.PatientId?.ToString("D")">
                            <header class="archive-patient-heading">
                                <div>
                                    <strong>@group.SubjectDisplay</strong>
                                    <small>@group.Consultations.Count 次咨询</small>
                                    @if (group.PatientId is null)
                                    {
                                        <small class="archive-legacy-note">旧版未关联档案</small>
                                    }
                                </div>
                                @if (group.PatientId is not null && OnStartFollowUp.HasDelegate)
                                {
                                    <button type="button"
                                            class="archive-follow-up"
                                            disabled="@OperationInProgress"
                                            @onclick="() => StartFollowUpAsync(group)">
                                        新建后续咨询
                                    </button>
                                }
                            </header>

                            <div class="archive-consultations">
                                @foreach (var record in group.Consultations)
                                {
                                    <div class="archive-record-row">
                                        <button type="button"
                                                class="archive-record @(selectedDocumentId == record.DocumentId ? "selected" : null)"
                                                disabled="@OperationInProgress"
                                                @onclick="() => OpenStoredAsync(record.DocumentId)">
                                            <strong>@record.Title</strong>
                                            <small>
                                                咨询 <LocalDateTimeDisplay Value="@record.ConsultationStartedAt" Format="yyyy-MM-dd" />
                                                · 保存 <LocalDateTimeDisplay Value="@record.LastSavedAt" Format="MM-dd HH:mm" />
                                            </small>
                                        </button>
                                        @if (CanDelete)
                                        {
                                            <button type="button"
                                                    class="archive-record-delete"
                                                    aria-label="@($"删除 {record.Title}")"
                                                    title="删除这次咨询档案"
                                                    disabled="@OperationInProgress"
                                                    @onclick="() => OpenDeleteDialog(record)">
                                                <Icon Type="delete" Theme="IconThemeType.Outline" />
                                                <span>删除</span>
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        </section>
                    }
                }
            </aside>

            <div class="archive-preview">
                @if (opening)
                {
                    <Skeleton Active ParagraphRows="8" />
                }
                else if (review is not null)
                {
                    <ArchiveDocumentReview Review="review" />
                }
                else
                {
                    <Empty Description="@("选择一个本机档案，或打开外部档案文档")" />
                }
            </div>
        </div>
    </div>
</section>

<Modal Title="删除档案"
       @bind-Visible="deleteDialogVisible"
       MaskClosable="@(!mutating)"
       Closable="@(!mutating)"
       OkText="@("删除")"
       CancelText="@("取消")"
       OkButtonProps="@DestructiveOkButtonProps"
       CancelButtonProps="@DestructiveCancelButtonProps"
       ConfirmLoading="@mutating"
       OnCancel="CloseDeleteDialog"
       OnOk="DeleteConfirmedAsync">
    @if (pendingDelete is not null)
    {
        <Alert Type="AlertType.Warning"
               Message="此操作无法撤销"
               Description="只删除当前浏览器中的这一次咨询档案；已经导出的档案文件不受影响。"
               ShowIcon="true" />
        <dl class="archive-delete-summary">
            <div><dt>咨询对象</dt><dd>@pendingDelete.SubjectDisplay</dd></div>
            <div>
                <dt>咨询日期</dt>
                <dd><LocalDateTimeDisplay Value="@pendingDelete.ConsultationStartedAt" Format="yyyy-MM-dd HH:mm" /></dd>
            </div>
        </dl>
    }
</Modal>

<Modal Title="清空本机档案库"
       @bind-Visible="clearDialogVisible"
       MaskClosable="@(!mutating)"
       Closable="@(!mutating)"
       OkText="@("清空档案库")"
       CancelText="@("取消")"
       OkButtonProps="@DestructiveOkButtonProps"
       CancelButtonProps="@DestructiveCancelButtonProps"
       ConfirmLoading="@mutating"
       OnCancel="CloseClearDialog"
       OnOk="ClearConfirmedAsync">
    <Alert Type="AlertType.Warning"
           Message="将删除当前浏览器中的全部本机档案"
           Description="@($"共 {records.Count} 份档案，删除后无法恢复；已经导出的档案文件不受影响。")"
           ShowIcon="true" />
</Modal>

@code {
    [Parameter]
    public EventCallback<ArchivePatientContext> OnStartFollowUp { get; set; }

    private readonly CancellationTokenSource lifetimeCancellation = new();
    private IReadOnlyList<ArchiveRecordSummary> records = Array.Empty<ArchiveRecordSummary>();
    private ArchiveReview? review;
    private ArchiveOperationResult? feedback;
    private Guid? selectedDocumentId;
    private bool loading;
    private bool opening;
    private bool exporting;
    private bool mutating;
    private bool deleteDialogVisible;
    private bool clearDialogVisible;
    private ArchiveRecordSummary? pendingDelete;

    private bool CanBrowse => ArchiveWorkflow.Capabilities.HasFlag(ArchiveWorkflowCapabilities.Browse);

    private bool CanImport => ArchiveWorkflow.Capabilities.HasFlag(ArchiveWorkflowCapabilities.Import);

    private bool CanExportStored =>
        ArchiveWorkflow.Capabilities.HasFlag(ArchiveWorkflowCapabilities.ExportStored);

    private bool CanDelete => ArchiveWorkflow.Capabilities.HasFlag(ArchiveWorkflowCapabilities.Delete);

    private bool CanClear => ArchiveWorkflow.Capabilities.HasFlag(ArchiveWorkflowCapabilities.Clear);

    private bool OperationInProgress =>
        loading || opening || exporting || mutating || deleteDialogVisible || clearDialogVisible;

    private ButtonProps DestructiveOkButtonProps => new() { Danger = true, Disabled = mutating };

    private ButtonProps DestructiveCancelButtonProps => new() { Disabled = mutating };

    private IReadOnlyList<PatientArchiveGroup> PatientGroups => records
        .GroupBy(
            record => record.PatientId is { } patientId
                ? $"patient:{patientId:D}"
                : $"legacy:{record.DocumentId:D}",
            StringComparer.Ordinal)
        .Select(group =>
        {
            var consultations = group
                .OrderByDescending(record => record.ConsultationStartedAt)
                .ThenByDescending(record => record.LastSavedAt)
                .ToArray();
            var latest = consultations[0];
            return new PatientArchiveGroup(
                latest.PatientId,
                latest.SubjectDisplay,
                consultations,
                consultations.Max(record => record.LastSavedAt));
        })
        .OrderByDescending(group => group.LastSavedAt)
        .ToArray();

    protected override async Task OnInitializedAsync() => await LoadRecordsAsync();

    private async Task LoadRecordsAsync()
    {
        if (!CanBrowse || loading)
        {
            return;
        }

        loading = true;
        try
        {
            var result = await ArchiveWorkflow.BrowseAsync(lifetimeCancellation.Token);
            records = result.Records;
            feedback = result.Operation.Notices.Count > 0 ? result.Operation : null;
            if (!result.Operation.IsSuccess)
            {
                await ReportFailureAsync(result.Operation);
            }
        }
        catch (OperationCanceledException) when (lifetimeCancellation.IsCancellationRequested)
        {
        }
        finally
        {
            loading = false;
        }
    }

    private async Task OpenStoredAsync(Guid documentId)
    {
        selectedDocumentId = documentId;
        await OpenAsync(() => ArchiveWorkflow.OpenStoredAsync(documentId, lifetimeCancellation.Token));
    }

    private async Task ImportAsync()
    {
        selectedDocumentId = null;
        await OpenAsync(() => ArchiveWorkflow.ImportAsync(lifetimeCancellation.Token));
    }

    private async Task ExportStoredAsync()
    {
        if (!CanExportStored || OperationInProgress || selectedDocumentId is not { } documentId)
        {
            return;
        }

        exporting = true;
        try
        {
            var result = await ArchiveWorkflow.ExportStoredAsync(documentId, lifetimeCancellation.Token);
            feedback = result.Notices.Count > 0 ? result : null;
            if (result.IsSuccess)
            {
                await Message.SuccessAsync(result.Message);
            }
            else if (result.Status != ArchiveOperationStatus.Cancelled)
            {
                await ReportFailureAsync(result);
            }
        }
        catch (OperationCanceledException) when (lifetimeCancellation.IsCancellationRequested)
        {
        }
        finally
        {
            exporting = false;
        }
    }

    private void OpenDeleteDialog(ArchiveRecordSummary record)
    {
        if (!CanDelete || OperationInProgress)
        {
            return;
        }

        pendingDelete = record;
        deleteDialogVisible = true;
    }

    private void CloseDeleteDialog()
    {
        if (mutating)
        {
            return;
        }

        deleteDialogVisible = false;
        pendingDelete = null;
    }

    private async Task DeleteConfirmedAsync()
    {
        if (mutating || pendingDelete is not { } record)
        {
            return;
        }

        mutating = true;
        try
        {
            var result = await ArchiveWorkflow.DeleteStoredAsync(
                record.DocumentId,
                lifetimeCancellation.Token);
            feedback = result;
            if (!result.IsSuccess)
            {
                await ReportFailureAsync(result);
                return;
            }

            records = records.Where(item => item.DocumentId != record.DocumentId).ToArray();
            if (selectedDocumentId == record.DocumentId)
            {
                selectedDocumentId = null;
                review = null;
            }

            deleteDialogVisible = false;
            pendingDelete = null;
            await Message.SuccessAsync(result.Message);
        }
        catch (OperationCanceledException) when (lifetimeCancellation.IsCancellationRequested)
        {
        }
        finally
        {
            mutating = false;
        }
    }

    private void OpenClearDialog()
    {
        if (!CanClear || records.Count == 0 || OperationInProgress)
        {
            return;
        }

        clearDialogVisible = true;
    }

    private void CloseClearDialog()
    {
        if (!mutating)
        {
            clearDialogVisible = false;
        }
    }

    private async Task ClearConfirmedAsync()
    {
        if (mutating)
        {
            return;
        }

        mutating = true;
        try
        {
            var result = await ArchiveWorkflow.ClearStoredAsync(lifetimeCancellation.Token);
            feedback = result;
            if (!result.IsSuccess)
            {
                await ReportFailureAsync(result);
                return;
            }

            records = [];
            selectedDocumentId = null;
            review = null;
            clearDialogVisible = false;
            await Message.SuccessAsync(result.Message);
        }
        catch (OperationCanceledException) when (lifetimeCancellation.IsCancellationRequested)
        {
        }
        finally
        {
            mutating = false;
        }
    }

    private async Task StartFollowUpAsync(PatientArchiveGroup group)
    {
        if (OperationInProgress || !OnStartFollowUp.HasDelegate || group.PatientId is not { } patientId)
        {
            return;
        }

        var latest = group.Consultations[0];
        selectedDocumentId = latest.DocumentId;
        opening = true;
        try
        {
            var result = await ArchiveWorkflow.OpenStoredAsync(latest.DocumentId, lifetimeCancellation.Token);
            feedback = result.Operation.Notices.Count > 0 ? result.Operation : null;
            if (!result.Operation.IsSuccess)
            {
                if (result.Operation.Status != ArchiveOperationStatus.Cancelled)
                {
                    await ReportFailureAsync(result.Operation);
                }

                return;
            }

            review = result.Review;
            if (review?.PatientContext is not { } patientContext || patientContext.PatientId != patientId)
            {
                await Message.ErrorAsync("这份档案无法安全关联到既有患者，请将其作为独立咨询查看。");
                return;
            }

            await OnStartFollowUp.InvokeAsync(patientContext);
        }
        catch (OperationCanceledException) when (lifetimeCancellation.IsCancellationRequested)
        {
        }
        finally
        {
            opening = false;
        }
    }

    private async Task OpenAsync(Func<ValueTask<ArchiveOpenResult>> action)
    {
        if (opening)
        {
            return;
        }

        opening = true;
        try
        {
            var result = await action();
            feedback = result.Operation.Notices.Count > 0 ? result.Operation : null;
            if (result.Operation.IsSuccess)
            {
                review = result.Review;
            }
            else if (result.Operation.Status != ArchiveOperationStatus.Cancelled)
            {
                await ReportFailureAsync(result.Operation);
            }
        }
        catch (OperationCanceledException) when (lifetimeCancellation.IsCancellationRequested)
        {
        }
        finally
        {
            opening = false;
        }
    }

    private async Task ReportFailureAsync(ArchiveOperationResult operation)
    {
        var message = operation.Notices.Count > 0
            ? operation.Message + " 详细原因已显示在档案调阅区。"
            : operation.Message;
        if (operation.Status is ArchiveOperationStatus.Unavailable or ArchiveOperationStatus.Denied)
        {
            await Message.WarningAsync(message);
            return;
        }

        await Message.ErrorAsync(message);
    }

    public void Dispose()
    {
        lifetimeCancellation.Cancel();
        lifetimeCancellation.Dispose();
    }

    private sealed record PatientArchiveGroup(
        Guid? PatientId,
        string SubjectDisplay,
        IReadOnlyList<ArchiveRecordSummary> Consultations,
        DateTimeOffset LastSavedAt);
}
