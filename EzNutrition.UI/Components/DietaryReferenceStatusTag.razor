@namespace EzNutrition.UI.Components
@using EzNutrition.Domain.Dietary

@if (Row.ReferenceStatus == DietaryReferenceStatus.BelowRange)
{
    <Tag Color="@("orange")"><Icon Type="arrow-down" Theme="IconThemeType.Outline" /> 低于参考</Tag>
}
else if (Row.ReferenceStatus == DietaryReferenceStatus.AboveRange)
{
    <Tag Color="@("red")"><Icon Type="arrow-up" Theme="IconThemeType.Outline" /> 高于参考</Tag>
}
else if (Row.ReferenceStatus == DietaryReferenceStatus.WithinRange)
{
    <Tag Color="@("green")"><Icon Type="check" Theme="IconThemeType.Outline" /> 参考范围内</Tag>
}
else
{
    <Tag><Icon Type="minus" Theme="IconThemeType.Outline" /> 无参考值</Tag>
}

@code {
    [Parameter, EditorRequired]
    public DietaryNutrientAssessment Row { get; set; } = default!;
}
