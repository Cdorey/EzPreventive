@using EzNutrition.Application.Consultations
@using EzNutrition.Application.Ports
@namespace EzNutrition.UI.Components
@using EzNutrition.Domain.Dietary
@using EzNutrition.Shared.Data.Entities
@implements IDisposable
@inject IMessageService Message
@inject ConsultationApplicationService ConsultationService
@inject ILogger<DietarySurvey> Logger

<div class="dietary-survey">
    <div class="component-heading">
        <div>
            <span>膳食摄入</span>
            <h3>24 小时回顾法膳食调查</h3>
        </div>
        <Icon Type="profile" Theme="IconThemeType.Outline" />
    </div>

    @if (DietaryRecallSurvey?.SummaryCalculationTable is null)
    {
        <section class="survey-editor" aria-label="膳食记录编辑区">
            <div class="editor-intro">
                <div>
                    <h4>录入全天食物</h4>
                    <p>逐项记录食物、重量口径与餐次。食物成分按每 100 克可食部核算。</p>
                </div>
                <div class="entry-statistics" aria-label="已录入概况">
                    <span><strong>@EntryCount</strong> 项食物</span>
                    <span><strong>@TotalRecordedWeight.ToString("0.#")</strong> g 记录重量</span>
                </div>
            </div>

            <div class="food-picker">
                <label>添加食物原料</label>
                <FoodSearchSelect @key="DietaryRecallSurvey"
                                  Foods="@DietaryRecallSurvey?.Foods"
                                  OnFoodSelected="OnSelectedItemChangedHandler" />
                <span class="field-help">选择后自动加入下方记录，默认按 100 g 可食重量录入。</span>
            </div>

            @if (EntryCount == 0)
            {
                <div class="empty-guidance">
                    <Icon Type="inbox" Theme="IconThemeType.Outline" />
                    <div>
                        <strong>尚未添加食物</strong>
                        <span>从上方搜索框选择当天摄入的第一种食物。</span>
                    </div>
                </div>
            }
            else
            {
                <div class="entry-table" aria-label="已录入食物">
                    <Table TItem="DietaryRecallEntry"
                           DataSource="@Entries"
                           HidePagination="true"
                           Responsive
                           Size="TableSize.Middle"
                           ScrollX="920"
                           RowKey="entry => entry.EntryId">
                        <PropertyColumn Title="食物" Property="entry => entry.Food.FriendlyName" Width="250">
                            <div class="food-identity">
                                <strong>@context.Food.FriendlyName</strong>
                                <span>@context.Food.FriendlyCode</span>
                            </div>
                        </PropertyColumn>
                        <PropertyColumn Title="重量（g）" Property="entry => entry.Weight" Width="160">
                            <AntDesign.InputNumber TValue="decimal"
                                         Min="0m"
                                         Step="1m"
                                         Precision="1"
                                         Width="132px"
                                         @bind-Value="@context.Weight" />
                        </PropertyColumn>
                        <PropertyColumn Title="重量口径" Property="entry => entry.IsAllEdible" Width="190">
                            <div class="weight-basis">
                                <Switch @bind-Checked="@context.IsAllEdible"
                                        CheckedChildren="可食重量"
                                        UnCheckedChildren="原始重量" />
                                @if (!context.IsAllEdible)
                                {
                                    <span>按可食率 @(context.Food.EdiblePortion ?? 100)% 折算</span>
                                }
                                else
                                {
                                    <span>不再扣除不可食部分</span>
                                }
                            </div>
                        </PropertyColumn>
                        <PropertyColumn Title="餐次" Property="entry => entry.MealOccasion" Width="180">
                            <EnumSelect TEnum="MealOccasion" @bind-Value="@context.MealOccasion" />
                        </PropertyColumn>
                        <ActionColumn Title="操作" Width="80">
                            <Button Shape="ButtonShape.Circle"
                                    Danger
                                    OnClick="() => RemoveRecord(context)"
                                    Icon="@IconType.Outline.Delete"
                                    AriaLabel="@($"删除 {context.Food.FriendlyName}")" />
                        </ActionColumn>
                    </Table>
                </div>
            }

            <div class="calculation-action">
                <div>
                    <strong>核算前请确认</strong>
                    <span>重量口径会直接影响可食部折算；结果仍可返回修改后重新计算。</span>
                </div>
                <Button Class="calculate-button"
                        Type="ButtonType.Primary"
                        Size="ButtonSize.Large"
                        Disabled="@(EntryCount == 0)"
                        OnClick="Calculate"
                        AutoLoading>
                    <Icon Type="calculator" Theme="IconThemeType.Outline" />
                    计算膳食摄入
                </Button>
            </div>
        </section>
    }
    else
    {
        <section class="survey-results" aria-label="膳食调查结果">
            <div class="result-toolbar">
                <div>
                    <Tag Color="@("green")"><Icon Type="check-circle" Theme="IconThemeType.Outline" /> 已完成核算</Tag>
                    <span>@EntryCount 项食物 · @TotalRecordedWeight.ToString("0.#") g 记录重量</span>
                </div>
                <Button OnClick="EditEntries" Icon="@IconType.Outline.Edit">修改记录</Button>
            </div>

            <div class="result-interpretation-note" role="note" aria-label="结果解释">
                <Icon Type="info-circle" Theme="IconThemeType.Outline" />
                <span>本结果基于单日 24 小时膳食回顾，并与适用 DRIs 比较；高于或低于参考值仅作为进一步问询的风险线索，不代表通常摄入水平，也不单独构成营养诊断。</span>
            </div>

            <div class="summary-metrics" aria-label="关键膳食指标">
                @foreach (var metric in KeyMetrics)
                {
                    <article class="summary-metric @(HasReferenceFlag(metric) ? "has-flag" : string.Empty)">
                        <div class="metric-heading">
                            <span>@metric.FriendlyName</span>
                            <DietaryReferenceStatusTag Row="@metric" />
                        </div>
                        <strong>@FormatValue(metric) <small>@metric.Unit</small></strong>
                        @if (metric.HasReference)
                        {
                            <span>参考 @FormatReference(metric) @metric.Unit</span>
                        }
                        else
                        {
                            <span>本次 24 小时回顾核算值</span>
                        }
                    </article>
                }
            </div>

            <Tabs Class="dietary-result-tabs" DefaultActiveKey="summary">
                <ChildContent>
                    <TabPane Key="summary" Tab="营养素结果">
                        @if (DietaryRecallSurvey.NutrientAssessments.Any())
                        {
                            <div class="summary-table desktop-summary-table">
                                <Table TItem="DietaryNutrientAssessment"
                                       DataSource="@DietaryRecallSurvey.NutrientAssessments"
                                       HidePagination="true"
                                       Size="TableSize.Middle"
                                       ScrollX="760"
                                       RowExpandable="@((record) => HasBreakdown(record.Data))">
                                    <ColumnDefinitions>
                                        <PropertyColumn Title="营养素" Property="row => row.FriendlyName" Width="220">
                                            <div class="nutrient-name">
                                                <strong>@context.FriendlyName</strong>
                                                @if (!string.IsNullOrWhiteSpace(context.Abbreviation))
                                                {
                                                    <span>@context.Abbreviation</span>
                                                }
                                            </div>
                                        </PropertyColumn>
                                        <PropertyColumn Title="核算结果" Property="row => row.Value" Width="170">
                                            <strong class="result-value">@FormatValue(context)</strong>
                                            <span class="result-unit">@context.Unit</span>
                                        </PropertyColumn>
                                        <PropertyColumn Title="参考判断" Property="row => row.ReferenceStatus" Width="180">
                                            <DietaryReferenceStatusTag Row="@context" />
                                        </PropertyColumn>
                                        <PropertyColumn Title="参考范围" Property="row => row.LowerReference">
                                            @if (context.HasReference)
                                            {
                                                <span>@FormatReference(context) @context.Unit</span>
                                            }
                                            else
                                            {
                                                <span class="muted-value">未设置</span>
                                            }
                                        </PropertyColumn>
                                    </ColumnDefinitions>
                                    <ExpandTemplate>
                                        @if (HasBreakdown(context.Data))
                                        {
                                            <Descriptions Title="@BreakdownTitle(context.Data)" Column="@(new Dictionary<string, int> { { "xs", 1 }, { "md", 2 }, { "xl", 3 } })">
                                                @foreach (var description in BreakdownItems(context.Data))
                                                {
                                                    <DescriptionsItem Title="@description.Label">@description.Value</DescriptionsItem>
                                                }
                                            </Descriptions>
                                        }
                                    </ExpandTemplate>
                                </Table>
                            </div>

                            <div class="mobile-summary-list">
                                @foreach (var row in DietaryRecallSurvey.NutrientAssessments)
                                {
                                    <article class="mobile-summary-item">
                                        <div>
                                            <strong>@row.FriendlyName</strong>
                                            @if (!string.IsNullOrWhiteSpace(row.Abbreviation))
                                            {
                                                <span>@row.Abbreviation</span>
                                            }
                                        </div>
                                        <div class="mobile-summary-value">
                                            <strong>@FormatValue(row) <small>@row.Unit</small></strong>
                                            <DietaryReferenceStatusTag Row="@row" />
                                        </div>
                                        <span>参考：@(row.HasReference ? $"{FormatReference(row)} {row.Unit}" : "未设置")</span>
                                        @if (HasBreakdown(row))
                                        {
                                            <details>
                                                <summary>@BreakdownTitle(row)</summary>
                                                <dl>
                                                    @foreach (var description in BreakdownItems(row))
                                                    {
                                                        <div><dt>@description.Label</dt><dd>@description.Value</dd></div>
                                                    }
                                                </dl>
                                            </details>
                                        }
                                    </article>
                                }
                            </div>
                        }
                    </TabPane>

                    <TabPane Key="entries" Tab="录入记录">
                        <Table TItem="DietaryRecallEntry"
                               DataSource="@Entries"
                               HidePagination="true"
                               Responsive
                               Size="TableSize.Middle"
                               ScrollX="720"
                               RowKey="entry => entry.EntryId">
                            <PropertyColumn Title="食物" Property="entry => entry.Food.FriendlyName">
                                <div class="food-identity">
                                    <strong>@context.Food.FriendlyName</strong>
                                    <span>@context.Food.FriendlyCode</span>
                                </div>
                            </PropertyColumn>
                            <PropertyColumn Title="记录重量" Property="entry => entry.Weight" Width="150">
                                @context.Weight.ToString("0.#") <span class="muted-value">g</span>
                            </PropertyColumn>
                            <PropertyColumn Title="重量口径" Property="entry => entry.IsAllEdible" Width="190">
                                @if (context.IsAllEdible)
                                {
                                    <Tag Color="@("blue")">可食重量</Tag>
                                }
                                else
                                {
                                    <Tag Color="@("orange")">原始重量 · 可食率 @(context.Food.EdiblePortion ?? 100)%</Tag>
                                }
                            </PropertyColumn>
                            <PropertyColumn Title="餐次" Property="entry => entry.MealOccasion" Width="160">
                                @context.MealOccasion
                            </PropertyColumn>
                        </Table>
                    </TabPane>

                    <TabPane Key="calculation" Tab="核算明细">
                        <div class="calculation-note">
                            <Icon Type="audit" Theme="IconThemeType.Outline" />
                            <span>以下明细用于追溯每种食物对各营养素的贡献；营养素较多时可横向滚动查看。</span>
                        </div>
                        @if (DietaryRecallSurvey.EntryCalculations.Count > 0)
                        {
                            <Table TItem="DietaryRecallEntryCalculation"
                                   DataSource="DietaryRecallSurvey.EntryCalculations"
                                   ScrollX="4000"
                                   HidePagination="true"
                                   Size="TableSize.Middle">
                                <PropertyColumn Property="row => row.FoodName" Title="原料名称" Width="120" Fixed="ColumnFixPlacement.Left" />
                                <PropertyColumn Property="row => row.RecordedWeight" Title="原料原始重量" Width="120" Fixed="ColumnFixPlacement.Left" />
                                <PropertyColumn Property="row => row.IsAllEdible" Title="均为可食部" Width="120" Fixed="ColumnFixPlacement.Left" />
                                @foreach (var nutrient in DietaryRecallSurvey.Nutrients)
                                {
                                    <PropertyColumn Property="row => row.NutrientValues[nutrient.NutrientId]" Title="@nutrient.FriendlyName" Width="120">
                                        @context.NutrientValues[nutrient.NutrientId].ToString("0.##")
                                    </PropertyColumn>
                                }
                            </Table>
                        }
                    </TabPane>
                </ChildContent>
            </Tabs>
        </section>
    }
</div>

@code
{
    [Parameter]
    public DietaryRecallSurvey? DietaryRecallSurvey { get; set; }

    [Parameter]
    public EventCallback OnCalculationCompleted { get; set; }

    public List<DietaryRecallEntry>? Entries => DietaryRecallSurvey?.RecallEntries;

    private int EntryCount => Entries?.Count ?? 0;

    private decimal TotalRecordedWeight => Entries?.Sum(entry => entry.Weight) ?? 0m;

    private IEnumerable<DietaryNutrientAssessment> KeyMetrics =>
        new[] { "总能量", "蛋白质供能比", "脂肪供能比", "碳水化合物供能比" }
            .Select(name => DietaryRecallSurvey?.NutrientAssessments.FirstOrDefault(row => row.FriendlyName == name))
            .Where(row => row is not null)
            .Cast<DietaryNutrientAssessment>();

    private readonly CancellationTokenSource lifetimeCancellation = new();

    private static string FormatValue(DietaryNutrientAssessment assessment) =>
        assessment.FriendlyName == "总能量" || assessment.Unit == "%E"
            ? assessment.Value.ToString("0")
            : assessment.Value.ToString("0.00");

    private static string FormatReference(DietaryNutrientAssessment assessment) =>
        $"{FormatReferenceBound(assessment.LowerReference)}~{FormatReferenceBound(assessment.UpperReference)}";

    private static string FormatReferenceBound(decimal? value) =>
        value is null
            ? string.Empty
            : value.Value.ToString(value.Value % 1m == 0m ? "0" : "0.##");

    private static bool HasBreakdown(DietaryNutrientAssessment assessment) =>
        assessment.MealEnergies.Count > 0 || assessment.FoodContributions.Count > 0;

    private static bool HasReferenceFlag(DietaryNutrientAssessment assessment) =>
        assessment.ReferenceStatus is DietaryReferenceStatus.BelowRange
            or DietaryReferenceStatus.AboveRange;

    private static string BreakdownTitle(DietaryNutrientAssessment assessment) =>
        assessment.FriendlyName switch
        {
            "总能量" => "详细信息",
            "总脂肪" => "脂肪供应顺位",
            _ => $"{assessment.FriendlyName}供应顺位"
        };

    private static IEnumerable<(string Label, string Value)> BreakdownItems(
        DietaryNutrientAssessment assessment)
    {
        foreach (var meal in assessment.MealEnergies)
        {
            yield return (
                $"{MealOccasionLabel(meal.MealOccasion)}供能",
                $"{meal.Energy:0.##}kCal，{meal.PercentageOfTotalEnergy:0}%E");
        }

        foreach (var contribution in assessment.FoodContributions)
        {
            yield return (
                contribution.FoodName,
                $"{contribution.Value:0.00}{contribution.Unit}");
        }
    }

    private static string MealOccasionLabel(MealOccasion occasion) => occasion switch
    {
        MealOccasion.Breakfast => "早餐",
        MealOccasion.MorningSnack => "上午",
        MealOccasion.Lunch => "午餐",
        MealOccasion.AfternoonSnack => "下午",
        MealOccasion.Dinner => "晚餐",
        MealOccasion.LateNightSnack => "宵夜",
        _ => occasion.ToString()
    };

    private void RemoveRecord(DietaryRecallEntry entry)
    {
        Entries?.Remove(entry);
    }

    private async Task EditEntries()
    {
        if (DietaryRecallSurvey is null)
        {
            return;
        }

        DietaryRecallSurvey.ResetCalculation();
        await OnCalculationCompleted.InvokeAsync();
    }

    private async Task OnSelectedItemChangedHandler(Food? food)
    {
        if (food is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(food.FriendlyCode))
        {
            await Message.ErrorAsync("该食物缺少有效编码，无法加载营养成分。");
            return;
        }

        try
        {
            if (food.FoodNutrientValues is null)
            {
                await ConsultationService.LoadFoodCompositionAsync(
                    food,
                    lifetimeCancellation.Token);
            }

            Entries?.Add(new DietaryRecallEntry { Food = food, Weight = 100 });
        }
        catch (OperationCanceledException) when (lifetimeCancellation.IsCancellationRequested)
        {
        }
        catch (NutritionDataAccessException ex)
        {
            Logger.LogWarning(ex, "Unable to load food composition for {FoodCode}.", food.FriendlyCode);
            await Message.ErrorAsync(ex.Message);
        }
    }

    private async Task Calculate()
    {
        if (DietaryRecallSurvey is null)
        {
            await Message.ErrorAsync("问卷系统初始化失败");
            return;
        }

        if (Entries is null || Entries.Count == 0)
        {
            await Message.ErrorAsync("请至少添加一条膳食记录后再计算。");
            return;
        }

        foreach (var entry in Entries)
        {
            if (entry.Weight <= 0)
            {
                await Message.ErrorAsync($"{entry.Food.FriendlyName}的原料重量{entry.Weight}(g)不符合逻辑");
                return;
            }
        }

        try
        {
            DietaryRecallSurvey.Calculate();
            await OnCalculationCompleted.InvokeAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Dietary recall calculation failed.");
            DietaryRecallSurvey.ResetCalculation();
            await Message.ErrorAsync("膳食调查核算失败，请检查录入数据和食物成分资料。");
        }
    }

    public void Dispose()
    {
        lifetimeCancellation.Cancel();
        lifetimeCancellation.Dispose();
    }
}
