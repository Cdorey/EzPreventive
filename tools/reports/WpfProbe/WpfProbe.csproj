<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../Hosts/EzNutrition.Wpf/EzNutrition.Wpf.csproj" />
  </ItemGroup>
  <!-- 探针使用产品宿主的真实资源清单；不作为第二个 Razor 宿主重复收集 Blazor 脚本。 -->
  <Target Name="UseHostStaticWebAssets" AfterTargets="Build">
    <Copy SourceFiles="$(TargetDir)EzNutrition.Wpf.staticwebassets.runtime.json"
          DestinationFiles="$(TargetDir)WpfProbe.staticwebassets.runtime.json" />
  </Target>
</Project>
