<Window x:Class="EzNutrition.Wpf.MainWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:presentation="clr-namespace:EzNutrition.Presentation;assembly=EzNutrition.Presentation"
        Title="EzNutrition 营养评估工作台"
        Width="1440"
        Height="900"
        MinWidth="1024"
        MinHeight="700"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="_文件">
                <MenuItem Header="打开档案文件夹"
                          ToolTip="打开由桌面宿主管理的本机档案目录"
                          Click="OpenArchiveFolder" />
                <Separator />
                <MenuItem Header="退出" Click="ExitApplication" />
            </MenuItem>
            <MenuItem Header="_设置">
                <MenuItem Header="服务连接..."
                          ToolTip="配置营养服务端点、传输安全策略和本机登录信息"
                          Click="OpenServerSettings" />
            </MenuItem>
        </Menu>

        <Border x:Name="ConnectionSecurityWarning"
                Grid.Row="1"
                Padding="12,8"
                Background="#FFF1F0"
                BorderBrush="#CF1322"
                BorderThickness="0,0,0,1"
                Visibility="Collapsed">
            <TextBlock x:Name="ConnectionSecurityWarningText"
                       HorizontalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="#A8071A"
                       TextWrapping="Wrap" />
        </Border>

        <blazor:BlazorWebView x:Name="BlazorView"
                              Grid.Row="2"
                              HostPage="wwwroot\hybrid.html"
                              Services="{DynamicResource BlazorServices}"
                              BlazorWebViewInitializing="ConfigureBlazorWebView">
            <blazor:BlazorWebView.RootComponents>
                <blazor:RootComponent Selector="#app" ComponentType="{x:Type presentation:App}" />
            </blazor:BlazorWebView.RootComponents>
        </blazor:BlazorWebView>
    </Grid>
</Window>
