<Window x:Class="EzNutrition.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:presentation="clr-namespace:EzNutrition.Presentation;assembly=EzNutrition.Presentation"
        Title="EzNutrition 营养评估工作台"
        Width="1440"
        Height="900"
        MinWidth="1024"
        MinHeight="700"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="_文件">
                <MenuItem Header="打开档案文件夹"
                          ToolTip="打开由桌面宿主管理的本机档案目录"
                          Click="OpenArchiveFolder" />
                <Separator />
                <MenuItem Header="退出" Click="ExitApplication" />
            </MenuItem>
        </Menu>

        <blazor:BlazorWebView x:Name="BlazorView"
                              Grid.Row="1"
                              HostPage="wwwroot\hybrid.html"
                              Services="{DynamicResource BlazorServices}"
                              BlazorWebViewInitializing="ConfigureBlazorWebView">
            <blazor:BlazorWebView.RootComponents>
                <blazor:RootComponent Selector="#app" ComponentType="{x:Type presentation:App}" />
            </blazor:BlazorWebView.RootComponents>
        </blazor:BlazorWebView>
    </Grid>
</Window>
