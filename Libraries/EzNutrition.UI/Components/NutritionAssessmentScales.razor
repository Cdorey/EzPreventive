@using System.Globalization
@using EzNutrition.Domain.Assessments
@using EzNutrition.Domain.Consultations
@namespace EzNutrition.UI.Components

@if (Assessments.Count == 0)
{
    <Empty Description="@("当前宿主未配置营养筛查量表")" Simple />
}
else
{
    <div class="assessment-list">
        @foreach (var assessment in Assessments)
        {
            <article class="assessment-card">
                <header class="assessment-header">
                    <div>
                        <span>结构化筛查</span>
                        <h3>@assessment.Definition.DisplayName</h3>
                        <p>@assessment.Definition.Description</p>
                    </div>
                    <Tag Color="@("blue")">版本 @assessment.Definition.Version</Tag>
                </header>

                @if (assessment.Subject.BodyMassIndex is { } bodyMassIndex)
                {
                    <div class="assessment-context">
                        本次咨询资料计算的 BMI：
                        <strong>@bodyMassIndex.ToString("0.0", CultureInfo.InvariantCulture) kg/m²</strong>
                    </div>
                }

                @foreach (var section in assessment.Definition.Sections)
                {
                    var applicableItems = section.Items
                        .Where(item => assessment.Evaluation.ApplicableItemCodes.Contains(item.Code))
                        .ToArray();
                    if (applicableItems.Length > 0)
                    {
                        <section class="assessment-section">
                            <div class="assessment-section-heading">
                                <h4>@section.Title</h4>
                                @if (!string.IsNullOrWhiteSpace(section.Description))
                                {
                                    <p>@section.Description</p>
                                }
                            </div>

                            @foreach (var item in applicableItems)
                            {
                                <fieldset class="assessment-item">
                                    <legend>@item.Prompt</legend>
                                    @if (!string.IsNullOrWhiteSpace(item.HelpText))
                                    {
                                        <p class="assessment-help">@item.HelpText</p>
                                    }
                                    <div class="assessment-options">
                                        @foreach (var option in item.Options)
                                        {
                                            var inputId = InputId(assessment, item, option);
                                            <label class="assessment-option" for="@inputId">
                                                <input id="@inputId"
                                                       type="radio"
                                                       name="@InputName(assessment, item)"
                                                       value="@option.Code"
                                                       checked="@IsSelected(assessment, item, option)"
                                                       @onchange="@(() => SelectAnswer(assessment, item, option))" />
                                                <span class="assessment-option-text">@option.Display</span>
                                                @if (option.Score is { } score)
                                                {
                                                    <span class="assessment-option-score">
                                                        @score.ToString("0", CultureInfo.InvariantCulture) 分
                                                    </span>
                                                }
                                            </label>
                                        }
                                    </div>
                                </fieldset>
                            }
                        </section>
                    }
                }

                @if (assessment.Evaluation.IsComplete)
                {
                    <footer class="assessment-result">
                        <div>
                            <span>筛查结果</span>
                            <strong>@(assessment.Evaluation.Interpretation?.Display ?? "已完成")</strong>
                            @if (assessment.Evaluation.TotalScore is { } totalScore)
                            {
                                <Tag Color="@ResultColor(assessment.Evaluation)">
                                    总分 @totalScore.ToString("0", CultureInfo.InvariantCulture)
                                </Tag>
                            }
                        </div>
                        <SoapContributionImport Contributor="assessment.Evaluation"
                                                OnConfirmed="OnSoapContributionConfirmed" />
                    </footer>
                }
                else
                {
                    <div class="assessment-progress" role="status">
                        尚有 @assessment.Evaluation.MissingItemCodes.Count 项必答内容未完成，结果会在作答后自动计算。
                    </div>
                }
            </article>
        }
    </div>
}

@code {
    /// <summary>获取当前咨询已经建立的量表实例。</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<NutritionAssessmentRun> Assessments { get; set; } = [];

    /// <summary>获取专业人员复核量表候选文本后的回调。</summary>
    [Parameter]
    public EventCallback<SoapContribution> OnSoapContributionConfirmed { get; set; }

    private static bool IsSelected(
        NutritionAssessmentRun assessment,
        NutritionAssessmentItem item,
        NutritionAssessmentOption option) => string.Equals(
            assessment.GetAnswer(item.Code),
            option.Code,
            StringComparison.Ordinal);

    private static void SelectAnswer(
        NutritionAssessmentRun assessment,
        NutritionAssessmentItem item,
        NutritionAssessmentOption option) => assessment.SetAnswer(item.Code, option.Code);

    private static string InputName(
        NutritionAssessmentRun assessment,
        NutritionAssessmentItem item) => $"assessment-{assessment.RunId:N}-{item.Code}";

    private static string InputId(
        NutritionAssessmentRun assessment,
        NutritionAssessmentItem item,
        NutritionAssessmentOption option) =>
        $"{InputName(assessment, item)}-{option.Code}";

    private static string ResultColor(NutritionAssessmentEvaluation evaluation) =>
        string.Equals(
            evaluation.Interpretation?.Code,
            "nutritional-risk",
            StringComparison.Ordinal)
            ? "red"
            : "green";
}
