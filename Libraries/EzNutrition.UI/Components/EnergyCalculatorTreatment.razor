@using EzNutrition.Application.Consultations
@using EzNutrition.Application.Ports
@namespace EzNutrition.UI.Components
@using EzNutrition.Domain.Assessments
@using EzNutrition.Domain.Consultations
@implements IDisposable
@inject IMessageService Message
@inject ConsultationApplicationService ConsultationService
@inject ILogger<EnergyCalculatorTreatment> Logger
@if (EnergyCalculator != null)
{
    <div class="energy-calculator">
        <section class="energy-section overview-section">
            <div class="section-heading">
                <div>
                    <span>能量评估</span>
                    <h3>概要</h3>
                </div>
                <Icon Type="dashboard" Theme="IconThemeType.Outline" />
            </div>

            @if (string.IsNullOrEmpty(EnergyCalculator.Summary))
            {
                @if (HasNoEerData)
                {
                    <Alert Type="AlertType.Warning"
                           ShowIcon
                           Message="没有可用的 EER 数据"
                           Description="当前年龄、性别及生理状态没有匹配的能量需要量参考值。如确实需要核定能量，请在下方手工填写。" />
                }
                else
                {
                    <Paragraph>请选择适用的 PAL（身体活动水平），再计算推荐能量。</Paragraph>
                    <div class="pal-controls">
                        @if (IsEerLoading)
                        {
                            <Spin Size="SpinSize.Large">
                                <Indicator>
                                    <Icon Type="loading" Spin />
                                </Indicator>
                            </Spin>
                        }
                        else
                        {
                            <RadioGroup id="pal" @bind-Value="EnergyCalculator.PAL">
                                @foreach (var eer in EnergyCalculator.AvailableEERs)
                                {
                                    @if (eer.PAL != null)
                                    {
                                        <Radio RadioButton Value="@eer.PAL">@eer.PAL</Radio>
                                    }
                                }
                            </RadioGroup>
                        }
                        <Button Type="@ButtonType.Primary"
                                Disabled="@(IsEerLoading || EnergyCalculator.AvailableEERs.Count == 0)"
                                @onclick="OnCalculateBtnClick">
                            计算推荐能量
                        </Button>
                    </div>
                }
            }
            else
            {
                <div class="energy-summary">@EnergyCalculator.Summary</div>
            }
            @if (HasNoEerData || EnergyCalculator.Allocation != null)
            {
                <div class="energy-correction">
                    <label for="corEnergy">手工核定总能量（kcal）</label>
                    <AntDesign.InputNumber TValue="int?"
                                           id="corEnergy"
                                           OnChange="OnCorrectEnergyChanged"
                                           Step="50"
                                           Style="width:100%"
                                           Min="1" />
                </div>
            }
            @if (EnergyCalculator.Allocation is not null)
            {
                <div class="soap-import-action">
                    <SoapContributionImport Contributor="EnergyCalculator"
                                            OnConfirmed="OnSoapContributionConfirmed" />
                </div>
            }
        </section>

        @if (EnergyCalculator.Allocation != null)
        {
            <section class="energy-section macro-section">
                <div class="section-heading">
                    <div>
                        <span>宏量营养素</span>
                        <h3>能量模型</h3>
                    </div>
                    <Icon Type="pie-chart" Theme="IconThemeType.Outline" />
                </div>
                <div class="macro-dashboard-grid">
                    <div>
                    <Progress Type=ProgressType.Dashboard Format="(d) => d+'%'.ToString()+'P'.ToString()" Percent=@ProteinPercentage />
                        <span>蛋白质</span>
                    </div>
                    <div>
                    <Progress Type=ProgressType.Dashboard Format="(d) => d+'%'.ToString()+'C'.ToString()" Percent=@CarbohydratePercentage />
                        <span>碳水化合物</span>
                    </div>
                    <div>
                    <Progress Type=ProgressType.Dashboard Format="(d) => d+'%'.ToString()+'F'.ToString()" Percent=@FatPercentage />
                        <span>脂肪</span>
                    </div>
                </div>
        @if (IsTouchDetected)
        {
                    <div class="touch-macro-controls">
                        <Paragraph>输入蛋白质和脂肪的供能百分比，碳水化合物比例将自动平衡。</Paragraph>
                        <label>
                            <span>蛋白质</span>
                            <AntDesign.InputNumber Formatter="@((value)=>value.ToString() + "%")" Parser="@((value)=>value.Replace("%", ""))" @bind-Value="@ProteinPercentage" Min="0" Max="100" />
                        </label>
                        <label>
                            <span>脂肪</span>
                            <AntDesign.InputNumber Formatter="@((value)=>value.ToString() + "%")" Parser="@((value)=>value.Replace("%", ""))" @bind-Value="@FatPercentage" Min="0" Max="100" />
                        </label>
                    </div>
        }
        else
        {
                    <div class="slider-macro-controls">
                <Paragraph>拖动双向滑块调整蛋白质与脂肪供能比例。</Paragraph>
                <Slider TValue="(double, double)" @bind-Value="@macroPercentage" TipFormatter="(d) => TipFormatter(d)" OnAfterChange="OnMacroPercentageChanged" />
                    </div>
        }
            </section>
            <section class="energy-section allocation-section">
                <div class="section-heading">
                    <div>
                        <span>餐次分配</span>
                        <h3>三餐宏量营养素</h3>
                    </div>
                    <Icon Type="table" Theme="IconThemeType.Outline" />
                </div>
                <div class="data-table-scroll" role="region" aria-label="三餐能量分配表" tabindex="0">
                    <table class="allocation-table">
                        <thead>
                            <tr>
                                <th scope="col">餐次</th>
                                <th scope="col">蛋白质（g）</th>
                                <th scope="col">碳水化合物（g）</th>
                                <th scope="col">脂肪（g）</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <th scope="row">早餐</th>
                                <td>@EnergyCalculator.Allocation.BreakfastProteinContent</td>
                                <td>@EnergyCalculator.Allocation.BreakfastCarbohydrateContent</td>
                                <td>@EnergyCalculator.Allocation.BreakfastFatContent</td>
                            </tr>
                            <tr>
                                <th scope="row">午餐</th>
                                <td>@EnergyCalculator.Allocation.LunchProteinContent</td>
                                <td>@EnergyCalculator.Allocation.LunchCarbohydrateContent</td>
                                <td>@EnergyCalculator.Allocation.LunchFatContent</td>
                            </tr>
                            <tr>
                                <th scope="row">晚餐</th>
                                <td>@EnergyCalculator.Allocation.DinnerProteinContent</td>
                                <td>@EnergyCalculator.Allocation.DinnerCarbohydrateContent</td>
                                <td>@EnergyCalculator.Allocation.DinnerFatContent</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="energy-section allocation-section">
                <div class="section-heading">
                    <div>
                        <span>交换份</span>
                        <h3>三餐食物交换份</h3>
                    </div>
                    <Icon Type="appstore" Theme="IconThemeType.Outline" />
                </div>
                <div class="data-table-scroll" role="region" aria-label="三餐食物交换份表" tabindex="0">
                    <table class="allocation-table">
                        <thead>
                            <tr>
                                <th scope="col">餐次</th>
                                <th scope="col">蛋白质</th>
                                <th scope="col">碳水化合物</th>
                                <th scope="col">脂肪</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <th scope="row">早餐</th>
                                <td>@EnergyCalculator.Allocation.BreakfastProteinPortions</td>
                                <td>@EnergyCalculator.Allocation.BreakfastCarbohydratePortions</td>
                                <td>@EnergyCalculator.Allocation.BreakfastFatPortions</td>
                            </tr>
                            <tr>
                                <th scope="row">午餐</th>
                                <td>@EnergyCalculator.Allocation.LunchProteinPortions</td>
                                <td>@EnergyCalculator.Allocation.LunchCarbohydratePortions</td>
                                <td>@EnergyCalculator.Allocation.LunchFatPortionst</td>
                            </tr>
                            <tr>
                                <th scope="row">晚餐</th>
                                <td>@EnergyCalculator.Allocation.DinnerProteinPortions</td>
                                <td>@EnergyCalculator.Allocation.DinnerCarbohydratePortions</td>
                                <td>@EnergyCalculator.Allocation.DinnerFatPortions</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>
        }
        @if (EnergyCalculator.FoodExchangeAllocation != null)
        {
            <section class="energy-section exchange-adjustment-section">
                <div class="section-heading">
                    <div>
                        <span>食物类别</span>
                        <h3>交换份品类及修正</h3>
                    </div>
                    <Icon Type="edit" Theme="IconThemeType.Outline" />
                </div>
            <Form Model="@EnergyCalculator.FoodExchangeAllocation" Layout="FormLayout.Vertical">
                <GridRow Gutter="(16,16)">
                    <GridCol Xl="8" Lg="8" Md="12" Sm="12" Xs="24">
                        <FormItem Label="谷薯类（自动计算）">
                            <AntDesign.InputNumber TValue="double" Style="width:100%" Min="0" Disabled Value="@context.GrainsAndStarchyFoods" />
                        </FormItem>
                    </GridCol>
                    <GridCol Xl="8" Lg="8" Md="12" Sm="12" Xs="24">
                        <FormItem Label="豆乳类">
                            <AntDesign.InputNumber TValue="double" Style="width:100%" Min="0" @bind-Value="@context.LegumesAndDairyAlternatives" />
                        </FormItem>
                    </GridCol>
                    <GridCol Xl="8" Lg="8" Md="12" Sm="12" Xs="24">
                        <FormItem Label="肉蛋类（自动计算）">
                            <AntDesign.InputNumber TValue="double" Style="width:100%" Min="0" Disabled Value="@context.MeatsAndEggs" />
                        </FormItem>
                    </GridCol>
                    <GridCol Xl="8" Lg="8" Md="12" Sm="12" Xs="24">
                        <FormItem Label="蔬菜类">
                            <AntDesign.InputNumber TValue="double" Style="width:100%" Min="0" @bind-Value="@context.Vegetables" />
                        </FormItem>
                    </GridCol>
                    <GridCol Xl="8" Lg="8" Md="12" Sm="12" Xs="24">
                        <FormItem Label="能量类">
                            <AntDesign.InputNumber TValue="double" Style="width:100%" Min="0" @bind-Value="@context.EnergyFoodsOrFats" />
                        </FormItem>
                    </GridCol>
                    <GridCol Xl="8" Lg="8" Md="12" Sm="12" Xs="24">
                        <FormItem Label="水果类">
                            <AntDesign.InputNumber TValue="double" Style="width:100%" Min="0" @bind-Value="@context.Fruits" />
                        </FormItem>
                    </GridCol>
                </GridRow>
            </Form>
            </section>
        }
    </div>
}

@code {
    private (double, double) macroPercentage = (15, 100 - 25);

    private bool IsEerLoading { get; set; } = true;

    private bool HasNoEerData { get; set; }

    private EnergyCalculator? loadedCalculator;

    private CancellationTokenSource? fetchCancellation;

    private double ProteinPercentage
    {
        get => Math.Round((EnergyCalculator?.Allocation?.ProteinPercentage * 100 ?? 0));
        set
        {
            if (EnergyCalculator?.Allocation != null)
            {
                EnergyCalculator.Allocation.ProteinPercentage = value / 100;
                if ((value + FatPercentage) > 100)
                {
                    FatPercentage = 100 - value;
                }
            }
        }
    }

    private double CarbohydratePercentage
    {
        get => Math.Round((EnergyCalculator?.Allocation?.CarbohydratePercentage * 100 ?? 0));
    }

    private double FatPercentage
    {
        get => Math.Round((EnergyCalculator?.Allocation?.FatPercentage * 100 ?? 0));
        set
        {
            if (EnergyCalculator?.Allocation != null)
            {
                EnergyCalculator.Allocation.FatPercentage = value / 100;
                if ((value + ProteinPercentage) > 100)
                {
                    ProteinPercentage = 100 - value;
                }
            }
        }
    }

    private async Task OnCalculateBtnClick()
    {
        if (EnergyCalculator is not null && !EnergyCalculator.Calculate())
        {
            await Message.ErrorAsync("请先选择一个有效的 PAL（身体活动水平）。");
        }
    }

    private async Task OnCorrectEnergyChanged(int? newEnergy)
    {
        if (newEnergy is { } value && EnergyCalculator?.CorrectEnergy(value) is true)
        {
            await Message.InfoAsync($"核定总能量{value}kCal，依据营养师修正。");
        }
    }

    private string TipFormatter(double currentValue)
    {
        return (currentValue == macroPercentage.Item1 ? currentValue : 100 - currentValue).ToString();
    }

    private void OnMacroPercentageChanged((double, double) args)
    {
        ProteinPercentage = args.Item1;
        FatPercentage = 100 - args.Item2;
    }

    [Parameter]
    public bool IsTouchDetected { get; set; }

    [Parameter]
    public EnergyCalculator? EnergyCalculator { get; set; }

    [Parameter]
    public EventCallback<EnergyCalculator?> EnergyCalculatorChanged { get; set; }

    [Parameter]
    public EventCallback<SoapContribution> OnSoapContributionConfirmed { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (ReferenceEquals(loadedCalculator, EnergyCalculator))
        {
            return;
        }

        fetchCancellation?.Cancel();
        fetchCancellation?.Dispose();
        loadedCalculator = EnergyCalculator;

        if (EnergyCalculator is null)
        {
            IsEerLoading = false;
            return;
        }

        IsEerLoading = true;
        HasNoEerData = false;
        var cancellation = new CancellationTokenSource();
        fetchCancellation = cancellation;
        try
        {
            await ConsultationService.LoadEnergyReferencesAsync(
                EnergyCalculator,
                cancellation.Token);
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
        }
        catch (NutritionDataAccessException ex)
            when (ex.FailureKind == NutritionDataAccessFailureKind.NotFound)
        {
            HasNoEerData = true;
            Logger.LogInformation("No matching EER records were found for the current consultation subject.");
        }
        catch (Exception ex) when (ex is NutritionDataAccessException or InvalidOperationException)
        {
            Logger.LogWarning(ex, "Unable to load EER records.");
            await Message.ErrorAsync("能量参考数据加载失败，请稍后重试。");
        }
        finally
        {
            if (ReferenceEquals(fetchCancellation, cancellation))
            {
                IsEerLoading = false;
            }
        }
    }

    public void Dispose()
    {
        fetchCancellation?.Cancel();
        fetchCancellation?.Dispose();
    }
}
