@using Microsoft.JSInterop
@using EzNutrition.Domain.Consultations
@namespace EzNutrition.UI.Components
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IMessageService Message

<div class="soap-selection-import">
    <div class="soap-selection-source" @ref="selectionSource">
        @ChildContent
    </div>

    @if (CanImport)
    {
        <div class="soap-selection-toolbar" role="group" aria-label="将选中的 AI 文本引入 SOAP">
            <div class="soap-selection-guidance">
                <Icon Type="select" Theme="IconThemeType.Outline" />
                <span>先划选上方 AI 文本，再选择写入位置</span>
            </div>
            <div class="soap-selection-actions">
                <span @onpointerdown:preventDefault="true"
                      @onmousedown:preventDefault="true">
                    <Button OnClick="@(() => OpenReviewAsync(ReviewTarget.Assessment))"
                            AriaLabel="将选中的 AI 文本引入问题评估">
                        引入 A · 问题评估
                    </Button>
                </span>
                <span @onpointerdown:preventDefault="true"
                      @onmousedown:preventDefault="true">
                    <Button OnClick="@(() => OpenReviewAsync(ReviewTarget.Plan))"
                            AriaLabel="将选中的 AI 文本引入处理计划">
                        引入 P · 处理计划
                    </Button>
                </span>
            </div>
        </div>
    }
</div>

<SoapContributionReviewModal @bind-Visible="DialogVisible"
                             Candidate="reviewCandidate"
                             IncludeSubjective="false"
                             IncludeObjective="false"
                             Title="@dialogTitle"
                             Description="这里显示的是从 AI 草稿中划选的文字。可以继续修改；只有确认后的内容才会追加到 SOAP，AI 草稿本身不会被改动。"
                             OnConfirmed="OnConfirmed" />

@code {
    private const string SelectionModulePath =
        "./_content/EzNutrition.UI/js/soap-text-selection.js";

    private ElementReference selectionSource;
    private Task<IJSObjectReference>? selectionModuleTask;
    private bool dialogVisible;
    private string dialogTitle = "确认引入 SOAP";
    private SoapContribution? reviewCandidate;

    [Parameter, EditorRequired]
    public RenderFragment ChildContent { get; set; } = default!;

    [Parameter]
    public bool Enabled { get; set; }

    [Parameter]
    public EventCallback<SoapContribution> OnConfirmed { get; set; }

    private bool DialogVisible
    {
        get => dialogVisible;
        set
        {
            dialogVisible = value;
            if (!value)
            {
                reviewCandidate = null;
                dialogTitle = "确认引入 SOAP";
            }
        }
    }

    private bool CanImport => Enabled && OnConfirmed.HasDelegate;

    private async Task OpenReviewAsync(ReviewTarget target)
    {
        var module = await GetSelectionModuleAsync();
        var selectedText = await module.InvokeAsync<string>(
            "getSelectedTextWithin",
            selectionSource);
        if (string.IsNullOrWhiteSpace(selectedText))
        {
            await Message.InfoAsync("请先在上方 AI 输出中划选需要引入的文字。");
            return;
        }

        var text = selectedText.Trim();
        if (target == ReviewTarget.Assessment)
        {
            reviewCandidate = new SoapContribution(Assessment: text);
            dialogTitle = "确认引入问题评估（A）";
        }
        else
        {
            reviewCandidate = new SoapContribution(Plan: text);
            dialogTitle = "确认引入处理计划（P）";
        }

        DialogVisible = true;
    }

    private async Task<IJSObjectReference> GetSelectionModuleAsync()
    {
        selectionModuleTask ??= JS.InvokeAsync<IJSObjectReference>(
            "import",
            SelectionModulePath).AsTask();
        return await selectionModuleTask;
    }

    public async ValueTask DisposeAsync()
    {
        if (selectionModuleTask is null)
        {
            return;
        }

        try
        {
            var module = await selectionModuleTask;
            await module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }
        catch (TaskCanceledException)
        {
        }
    }

    private enum ReviewTarget
    {
        Assessment,
        Plan
    }
}
