@inject ILocalDateTimeFormatter Formatter

<time datetime="@MachineReadableValue" title="@FullDisplayValue">
    @Formatter.Format(Value, Format)
</time>

@code {
    [Parameter, EditorRequired]
    public DateTimeOffset Value { get; set; }

    [Parameter]
    public string Format { get; set; } = "yyyy-MM-dd HH:mm";

    private string MachineReadableValue =>
        Value.ToUniversalTime().ToString("O", System.Globalization.CultureInfo.InvariantCulture);

    private string FullDisplayValue => Formatter.Format(Value, "yyyy-MM-dd HH:mm:ss");
}
