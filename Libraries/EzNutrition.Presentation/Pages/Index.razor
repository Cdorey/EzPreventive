@page "/"
@using EzNutrition.Presentation.Services;
@using System.ComponentModel.DataAnnotations;
@using System.ComponentModel
@implements IDisposable
@inject UserSessionService UserSession
@inject ConsultationWorkspaceManager WorkspaceManager
@inject NavigationManager Navigator
@inject ILogger<Index> Logger
<PageTitle>首页</PageTitle>
<AuthorizeView>
    <Authorized>
        <section class="home-page">
            @if (!string.IsNullOrEmpty(UserSession.CredentialPersistenceWarning))
            {
                <Alert Class="session-warning"
                       Message="@UserSession.CredentialPersistenceWarning"
                       Type="@AlertType.Error"
                       ShowIcon="true" />
            }
            <header class="page-heading">
                <span class="eyebrow">专业工作台</span>
                <h1>营养评估与膳食干预</h1>
                <p>从咨询对象建档开始，完成能量、参考摄入量、膳食调查与 SOAP 信息核算。</p>
            </header>

            <div class="authorized-grid">
                <article class="surface-panel notice-panel">
                    <div class="panel-heading">
                        <div>
                            <span class="panel-kicker">工作提示</span>
                            <h2>开始前请留意</h2>
                        </div>
                        <Icon Type="notification" Theme="IconThemeType.Outline" />
                    </div>
                    @if (!UserSession.IsSystemInfoLoaded)
                    {
                        <Skeleton Active />
                    }
                    else if (string.IsNullOrEmpty(UserSession.Notice))
                    {
                        <Alert Type="AlertType.Info" Message="工作提示暂时不可用" Description="服务端内容未能加载；核心营养核算功能不受影响。" ShowIcon="true" />
                    }
                    else
                    {
                        @SafeMarkdown.Render(UserSession.Notice)
                    }
                </article>

                <aside class="surface-panel quick-actions" aria-label="快捷操作">
                    <span class="panel-kicker">快捷操作</span>
                    <h2>今天要做什么？</h2>
                    <Button Class="primary-action" Type="@ButtonType.Primary" Block OnClick="@(()=>{Navigator.NavigateTo($"maintreatment/{WorkspaceManager.NewWorkspace()}");})">
                        <Icon Type="plus-circle" Theme="IconThemeType.Outline" />
                        开启新咨询
                    </Button>
                    <Button Block OnClick="@(()=>{Navigator.NavigateTo("drisinsights");})">
                        <Icon Type="medicine-box" Theme="IconThemeType.Outline" />
                        DRIs 速查
                    </Button>
                </aside>
            </div>
        </section>
    </Authorized>
    <NotAuthorized>
        <section class="home-page guest-home">
            <header class="page-heading guest-heading">
                <span class="eyebrow">EzNutrition</span>
                <h1>面向公共卫生医师的营养评估工作台</h1>
                <p>桌面端承担完整咨询流程，平板与手机端保留外勤建档、速查和必要计算。</p>
            </header>

            <div class="guest-grid">
                <section class="surface-panel login-panel" aria-labelledby="login-title">
                    <div class="panel-heading">
                        <div>
                            <span class="panel-kicker">账户访问</span>
                            <h2 id="login-title">登录以开始</h2>
                        </div>
                        <Icon Type="safety-certificate" Theme="IconThemeType.Outline" />
                    </div>

                    <Alert Class="account-notice"
                           Type="AlertType.Warning"
                           Message="临时测试账户已关闭"
                           Description="请注册账户并完成专业身份认证，以使用 AI 辅助拟定健康教育与膳食指导草稿等受限功能。"
                           ShowIcon="true" />

                    @if (UserSession.IsAutomaticSignInInProgress)
                    {
                        <Alert Class="account-notice"
                               Type="@AlertType.Info"
                               Message="正在恢复登录状态…"
                               ShowIcon="true" />
                    }
                    else if (!string.IsNullOrEmpty(UserSession.AutomaticSignInError))
                    {
                        <Alert Class="account-notice"
                               Type="@AlertType.Warning"
                               Message="@UserSession.AutomaticSignInError"
                               ShowIcon="true" />
                    }

                    @if (!string.IsNullOrEmpty(UserSession.CredentialPersistenceWarning))
                    {
                        <Alert Class="account-notice"
                               Type="@AlertType.Error"
                               Message="@UserSession.CredentialPersistenceWarning"
                               ShowIcon="true" />
                    }

                    <Form Model="@innerModel" Layout="FormLayout.Vertical">
                        <ChildContent Context="formContext">
                            <FormItem Label="用户名">
                                <Input Placeholder="请输入用户名" @bind-Value="@formContext.Username" />
                            </FormItem>
                            <FormItem Label="密码">
                                <InputPassword Placeholder="请输入密码" @bind-Value="@formContext.Password" />
                                <div class="account-help-links">
                                    <a href="account/forgot-password">忘记密码</a>
                                    <a href="account/resend-confirmation">重新发送确认邮件</a>
                                </div>
                            </FormItem>
                            @if (UserSession.CanRememberLogin)
                            {
                                <FormItem>
                                    <label class="remember-login-option">
                                        <input type="checkbox" @bind="rememberLogin" />
                                        <span>
                                            在此设备上保持登录
                                            <small>登录信息由 Windows 当前用户范围的数据保护机制加密。</small>
                                        </span>
                                    </label>
                                </FormItem>
                            }
                            <FormItem>
                                <div class="login-actions">
                                    <Button Class="login-button"
                                            Type="@ButtonType.Primary"
                                            OnClick="Login"
                                            Disabled="@UserSession.IsAutomaticSignInInProgress"
                                            AutoLoading>
                                        登录
                                    </Button>
                                    <Button OnClick="@(()=>{Navigator.NavigateTo("register");})">注册新账户</Button>
                                </div>
                                <div class="account-policy-links" aria-label="服务协议与隐私说明">
                                    <span>使用服务前请阅读</span>
                                    <AuxiliaryPageLink Page="AuxiliaryPage.UserAgreement">用户许可协议</AuxiliaryPageLink>
                                    <AuxiliaryPageLink Page="AuxiliaryPage.PrivacyPolicy">隐私条款</AuxiliaryPageLink>
                                </div>
                            </FormItem>
                        </ChildContent>
                    </Form>

                    @if (!string.IsNullOrEmpty(errorInfo))
                    {
                        <Alert Message="@errorInfo" Type="@AlertType.Error" ShowIcon="true" />
                    }
                </section>

                <article class="surface-panel introduction-panel">
                    <div class="panel-heading">
                        <div>
                            <span class="panel-kicker">产品说明</span>
                            <h2>在使用前了解 EzNutrition</h2>
                        </div>
                        <Icon Type="read" Theme="IconThemeType.Outline" />
                    </div>
                    @if (!UserSession.IsSystemInfoLoaded)
                    {
                        <Skeleton Active />
                    }
                    else if (string.IsNullOrEmpty(UserSession.CoverLetter))
                    {
                        <Alert Type="AlertType.Info" Message="产品说明暂时不可用" Description="请检查网络连接后刷新页面。" ShowIcon="true" />
                    }
                    else
                    {
                        @SafeMarkdown.Render(UserSession.CoverLetter)
                    }
                </article>
            </div>
        </section>
    </NotAuthorized>
</AuthorizeView>

@code {
    /// <summary>承载登录表单中的短期输入。</summary>
    public sealed class Model
    {
        [Required, DisplayName("用户名")]
        public string? Username { get; set; }

        [Required, DisplayName("密码")]
        public string? Password { get; set; }
    }

    private readonly Model innerModel = new();

    private readonly CancellationTokenSource lifetimeCancellation = new();

    private string? errorInfo;

    private bool loginInProgress;

    private bool rememberLogin;

    private async Task Login()
    {
        if (loginInProgress)
        {
            return;
        }

        errorInfo = null;
        loginInProgress = true;
        try
        {
            await UserSession.SignInAsync(
                innerModel.Username ?? string.Empty,
                innerModel.Password ?? string.Empty,
                rememberLogin,
                lifetimeCancellation.Token);
            innerModel.Password = null;
        }
        catch (OperationCanceledException) when (lifetimeCancellation.IsCancellationRequested)
        {
        }
        catch (Exception ex) when (ex is InvalidOperationException or HttpRequestException)
        {
            errorInfo = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error while signing in.");
            errorInfo = "登录时发生异常，请稍后重试。";
        }
        finally
        {
            loginInProgress = false;
        }
    }

    protected override void OnInitialized()
    {
        UserSession.StateChanged += HandleSessionStateChanged;
        base.OnInitialized();
    }

    private void HandleSessionStateChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        UserSession.StateChanged -= HandleSessionStateChanged;
        lifetimeCancellation.Cancel();
        lifetimeCancellation.Dispose();
    }
}
