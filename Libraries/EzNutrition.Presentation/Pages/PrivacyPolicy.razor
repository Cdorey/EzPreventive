@page "/privacy-policy"
@using EzNutrition.Presentation.Services
@implements IDisposable
@inject PublicSystemInfoService SystemInfo
<PageTitle>隐私条款</PageTitle>

<PublishedNoticeDocument Title="隐私条款"
                         Description="了解本服务如何处理与保护账户及使用过程中产生的信息。"
                         Markdown="@SystemInfo.PrivacyPolicy"
                         IsLoaded="@SystemInfo.IsLoaded" />

@code {
    /// <inheritdoc />
    protected override void OnInitialized()
    {
        SystemInfo.StateChanged += HandleSystemInfoChanged;
        base.OnInitialized();
    }

    /// <summary>公共内容完成加载后更新隐私条款正文。</summary>
    private void HandleSystemInfoChanged() => _ = InvokeAsync(StateHasChanged);

    /// <inheritdoc />
    public void Dispose() => SystemInfo.StateChanged -= HandleSystemInfoChanged;
}
