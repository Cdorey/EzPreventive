@page "/drisinsights"
@using EzNutrition.Application.Consultations;
@using EzNutrition.Application.Ports;
@using EzNutrition.Domain.Assessments;
@using EzNutrition.Domain.Consultations;
@attribute [Authorize]
@implements IDisposable
@inject ConsultationApplicationService ConsultationService
@inject ILogger<DRIsInSights> Logger
<PageTitle>DRIs 速查</PageTitle>

<section class="dris-page">
    <header class="page-heading">
        <span>参考摄入量工具</span>
        <h1>DRIs 速查</h1>
        <p>根据性别、年龄和特殊生理状态，快速检索当前适用的膳食参考摄入量。</p>
    </header>

    <section class="filter-card" aria-labelledby="dris-filter-title">
        <div class="section-heading">
            <div>
                <span>检索条件</span>
                <h2 id="dris-filter-title">咨询对象特征</h2>
            </div>
            <Icon Type="filter" Theme="IconThemeType.Outline" />
        </div>
        <Form Model="@Info" Layout="FormLayout.Vertical">
            <GridRow Gutter="(16,0)">
                <GridCol Xs="24" Md="8">
                    <FormItem Label="性别">
                        <RadioGroup TValue="string" id="gender" @bind-Value="context.Gender" OnChange="OnGenderChangedAsync">
                            <Radio RadioButton Value="@("男")">男</Radio>
                            <Radio RadioButton Value="@("女")">女</Radio>
                        </RadioGroup>
                    </FormItem>
                </GridCol>
                <GridCol Xs="24" Md="6">
                    <AgeEntry Client="context" Changed="OnCriteriaChangedAsync" />
                </GridCol>
                <GridCol Xs="24" Md="10">
                    <FormItem Label="特殊生理状况">
                        <RadioGroup TValue="string" id="specialPhysiologicalPeriod" @bind-Value="context.SpecialPhysiologicalPeriod" OnChange="OnCriteriaChangedAsync">
                            <Radio RadioButton Value="@string.Empty">无</Radio>
                            <Radio RadioButton Value="@("孕早期")" Disabled="@(!IsFemale)">孕早期</Radio>
                            <Radio RadioButton Value="@("孕中期")" Disabled="@(!IsFemale)">孕中期</Radio>
                            <Radio RadioButton Value="@("孕晚期")" Disabled="@(!IsFemale)">孕晚期</Radio>
                            <Radio RadioButton Value="@("乳母")" Disabled="@(!IsFemale)">乳母</Radio>
                            <Radio RadioButton Value="@("已绝经")" Disabled="@(!IsFemale)">已绝经</Radio>
                        </RadioGroup>
                    </FormItem>
                </GridCol>
            </GridRow>
        </Form>
    </section>

    <section class="results-card" aria-labelledby="dris-results-title">
        <div class="section-heading results-heading">
            <div>
                <span>检索结果</span>
                <h2 id="dris-results-title">适用参考摄入量</h2>
            </div>
            <small>@(LastSuccessfulCriteria ?? "选择条件后自动检索")</small>
        </div>
        @if (LoadState == DriBrowserLoadState.Error)
        {
            <Alert Class="results-alert"
                   Type="AlertType.Error"
                   Message="未能取得适用的参考摄入量"
                   Description="@LoadError"
                   ShowIcon="true" />
        }
        @if (Dris.AggregationIssues.Count > 0)
        {
            <Alert Class="results-alert"
                   Type="AlertType.Warning"
                   Message="部分参考值需要人工核定"
                   Description="@AggregationWarning"
                   ShowIcon="true" />
        }
        <Spin Spinning="@IsLoading">
            <Indicator>
                <Icon Type="loading" Style="font-size: 5rem" Theme="IconThemeType.Outline" Spin />
            </Indicator>
            <ChildContent>
                <div class="results-body">
                    @if (LoadState == DriBrowserLoadState.Initial)
                    {
                        <Empty Description="@("请选择性别并确认年龄")" Simple />
                    }
                    else if (LoadState == DriBrowserLoadState.Error)
                    {
                        <Empty Description="@("当前没有可安全展示的查询结果")" Simple />
                    }
                    else
                    {
                        <DRIsInSightTable NutrientRanges="@Dris.NutrientRanges" />
                    }
                </div>
            </ChildContent>
        </Spin>
    </section>
</section>
@code {
    private const int RequestDebounceMilliseconds = 150;

    private IClient Info => Dris.Client;

    private DRIs Dris { get; set; } = new(new ClientInfo());

    private DriBrowserLoadState LoadState { get; set; } = DriBrowserLoadState.Initial;

    private bool IsLoading => LoadState == DriBrowserLoadState.Loading;

    private bool IsFemale => string.Equals(Info.Gender, "女", StringComparison.Ordinal);

    private string? LoadError { get; set; }

    private string? LastSuccessfulCriteria { get; set; }

    private string AggregationWarning => string.Join(
        "；",
        Dris.AggregationIssues.Select(issue => $"{issue.Nutrient}：{issue.Message}"));

    private CancellationTokenSource? requestCancellation;

    private async Task OnGenderChangedAsync()
    {
        if (!IsFemale && !string.IsNullOrEmpty(Info.SpecialPhysiologicalPeriod))
        {
            Info.SpecialPhysiologicalPeriod = string.Empty;
        }

        await OnCriteriaChangedAsync();
    }

    private async Task OnCriteriaChangedAsync()
    {
        var previousCancellation = requestCancellation;
        requestCancellation = null;
        previousCancellation?.Cancel();

        if (string.IsNullOrWhiteSpace(Info.Gender) || Info.Age is null)
        {
            ClearResults(DriBrowserLoadState.Initial);
            return;
        }

        var cancellation = new CancellationTokenSource();
        requestCancellation = cancellation;

        try
        {
            ClearResults(DriBrowserLoadState.Loading);
            await Task.Delay(RequestDebounceMilliseconds, cancellation.Token);
            await ConsultationService.LoadDietaryReferenceIntakesAsync(
                Dris,
                cancellation.Token);

            if (ReferenceEquals(requestCancellation, cancellation))
            {
                LoadState = DriBrowserLoadState.Success;
                LastSuccessfulCriteria = FormatCriteria();
            }
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
        }
        catch (Exception ex) when (ex is NutritionDataAccessException or InvalidOperationException)
        {
            Logger.LogWarning(ex, "Unable to load DRI records.");
            if (ReferenceEquals(requestCancellation, cancellation))
            {
                ClearResults(DriBrowserLoadState.Error);
                LoadError = "请核对查询条件或稍后重试；上一次结果已隐藏，避免与当前条件混淆。";
            }
        }
        finally
        {
            if (ReferenceEquals(requestCancellation, cancellation))
            {
                requestCancellation = null;
            }

            cancellation.Dispose();
        }
    }

    private void ClearResults(DriBrowserLoadState state)
    {
        Dris.AvailableDRIs = [];
        LoadState = state;
        LoadError = null;
        LastSuccessfulCriteria = null;
    }

    private string FormatCriteria()
    {
        var period = string.IsNullOrWhiteSpace(Info.SpecialPhysiologicalPeriod)
            ? "无特殊生理状况"
            : Info.SpecialPhysiologicalPeriod;
        return $"当前结果：{Info.Gender} · {Info.Age} · {period}";
    }

    public void Dispose()
    {
        var cancellation = requestCancellation;
        requestCancellation = null;
        cancellation?.Cancel();
    }

    private enum DriBrowserLoadState
    {
        Initial,
        Loading,
        Success,
        Error
    }
}
