@page "/administrators"
@using EzNutrition.Shared.Data.DTO
@using EzNutrition.Shared.Identities
@using EzNutrition.Shared.Policies
@using System.ComponentModel.DataAnnotations
@attribute [Authorize(Policy = PolicyList.Admin)]
@implements IDisposable
@inject IHttpClientFactory HttpClientFactory
@inject IMessageService Message
@inject ILogger<Administrators> Logger
<PageTitle>站点管理</PageTitle>
<header class="admin-page-heading">
    <span>系统管理</span>
    <h1>站点管理</h1>
    <p>管理账户、专业认证、角色权限与站内通知。复杂表格建议在桌面端操作。</p>
</header>
<AuthorizeView Policy="@PolicyList.Admin">
    <Authorized>
        <Tabs>
            <TabPane Tab="注册用户列表">
                <Table TItem="UserDto" DataSource="UserList" Size="TableSize.Middle" Style="width:100%" ScrollX="1366">
                    <ChildContent Context="userListContext">
                        <PropertyColumn Property="r=>r.Id" Title="ID"/>
                        <PropertyColumn Property="r=>r.UserName" Title="用户名"/>
                        <PropertyColumn Property="r=>r.NormalizedUserName" Title="标化用户名"/>
                        <PropertyColumn Property="r=>r.Email" Title="邮箱地址"/>
                        <PropertyColumn Property="r=>r.EmailConfirmed" Title="已确认邮箱" Filterable FilterMultiple />
                        <PropertyColumn Property="r=>r.PhoneNumber" Title="手机号码"/>
                        <PropertyColumn Property="r=>r.PhoneNumberConfirmed" Title="已确认手机" Filterable FilterMultiple />
                        <PropertyColumn Property="r=>r.TwoFactorEnabled" Title="双因子认证" Filterable FilterMultiple />
                        <PropertyColumn Property="r=>r.LockoutEnabled" Filterable FilterMultiple />
                        <PropertyColumn Property="r=>r.AccessFailedCount" />
                        <ActionColumn Title="操作" Width="150" Fixed="ColumnFixPlacement.Right">
                            <Space>
                                <SpaceItem>
                                    <Button Type="ButtonType.Primary" OnClick="(x)=>EditBtnClick(userListContext)" AutoLoading>
                                        编辑
                                    </Button>
                                </SpaceItem>
                                <SpaceItem>
                                    <Button Danger OnClick="(x)=>DeleteUser(userListContext)" AutoLoading>
                                        删除
                                    </Button>
                                </SpaceItem>
                            </Space>
                        </ActionColumn>
                    </ChildContent>
                </Table>
            </TabPane>
            <TabPane Tab="专业认证申请列表">
                <Table TItem="ProfessionalCertificationRequestDto" DataSource="ProfessionalCertificationRequestList" Size="TableSize.Middle" Style="width:100%" ScrollX="1366">
                    <ChildContent Context="requestListContext">
                        <PropertyColumn Property="r=>r.Id" />
                        <PropertyColumn Property="r=>r.UserId" />
                        <PropertyColumn Property="r=>r.RequestTime" Title="申请时间">
                            <LocalDateTimeDisplay Value="@requestListContext.RequestTime" />
                        </PropertyColumn>
                        <PropertyColumn Property="r=>r.IdentityType" Filterable FilterMultiple />
                        <PropertyColumn Property="r=>r.InstitutionName" />
                        <PropertyColumn Property="r=>r.Status" Filterable FilterMultiple />
                        <PropertyColumn Property="r=>r.ProcessedTime" Title="审核时间">
                            @if (requestListContext.ProcessedTime is { } processedTime)
                            {
                                <LocalDateTimeDisplay Value="@processedTime" />
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </PropertyColumn>
                        <PropertyColumn Property="r=>r.ProcessDetails" />
                        <PropertyColumn Property="r=>r.CertificateTicket" />
                        <PropertyColumn Property="r=>r.Remarks" />
                        <ActionColumn Title="操作" Width="150" Fixed="ColumnFixPlacement.Right">
                            <Space>
                                <SpaceItem>
                                    <Button Danger OnClick="(x)=>EditBtnClick(requestListContext)" AutoLoading>
                                    审核
                                    </Button>
                                </SpaceItem>
                            </Space>
                        </ActionColumn>
                    </ChildContent>
                </Table>
            </TabPane>
            <TabPane Tab="角色管理">
                <AntList Bordered DataSource="RoleList" ItemLayout="@ListItemLayout.Vertical" Style="width:100%">
                    <Header>角色名称</Header>
                    <ChildContent Context="item">
                        <ListItem>
                            <ChildContent>
                                @($"角色: {item.RoleName}")
                            </ChildContent>
                            <Extra>
                                @foreach (var claim in item.Claims)
                                {
                                    <div class="claim-row">
                                        <Input placeholder="权限声明类型" @bind-Value="claim.Type" />
                                        <Input placeholder="权限声明值" @bind-Value="claim.Value" />
                                        <Button Danger OnClick="@(x => RemoveRoleClaim(claim,item))" Type="ButtonType.Default">删除</Button>
                                    </div>
                                }
                                <div class="claim-actions">
                                    <Button OnClick="@(x=>AddRoleClaim(item))" Type="ButtonType.Primary">添加权限声明</Button>
                                    <Button OnClick="@(x=>SaveRoleClaims(item))" Type="ButtonType.Primary">保存修改</Button>
                                </div>
                            </Extra>
                        </ListItem>
                    </ChildContent>
                    <Footer>
                        <div class="role-create-row">
                            <Input Type="@InputType.Text" Placeholder="新角色名称" @bind-value="@newRole" />
                            <Button Type="@ButtonType.Primary" OnClick="AddRole" AutoLoading>添加角色</Button>
                        </div>
                    </Footer>
                </AntList>
            </TabPane>
            <TabPane Tab="通知">
                <Form Model="NewNotification" Layout="FormLayout.Vertical">
                    <ChildContent Context="notice">
                        <FormItem Label="通知标题">
                            <Input @bind-Value="@notice.NoticeTitle" />
                        </FormItem>
                        <FormItem Label="通知内容">
                            <TextArea @bind-Value="@notice.NoticeDescription" Rows="20" />
                        </FormItem>
                        <FormItem Label="展示方式">
                            <Checkbox @bind-Value="@notice.IsCoverLetter">设为覆盖式通知</Checkbox>
                        </FormItem>
                        <FormItem>
                            <Button Type="ButtonType.Primary" OnClick="SubmitNotification">提交</Button>
                        </FormItem>
                    </ChildContent>
                </Form>
            </TabPane>
        </Tabs>
        <Drawer Width="800" Closable="true" @bind-Visible="drawerVisible" Title="@("编辑用户信息")">
            @if (userInfoDto is not null)
            {
                <Form Model="@userInfoDto">
                    <ChildContent Context="userDtoContext">
                        <!-- 用户ID：只读显示 -->
                        <FormItem Label="用户ID">
                            <Input @bind-Value="userDtoContext.UserId" Disabled="true" />
                        </FormItem>

                        <!-- 用户名 -->
                        <FormItem Label="用户名">
                            <Input @bind-Value="userDtoContext.UserName" />
                        </FormItem>

                        <!-- 邮箱 -->
                        <FormItem Label="邮箱">
                            <Input type="InputType.Email" @bind-Value="userDtoContext.Email" />
                        </FormItem>

                        <!-- 电话 -->
                        <FormItem Label="电话">
                            <Input type="InputType.Text" @bind-Value="userDtoContext.PhoneNumber" />
                        </FormItem>

                        <!-- 角色：使用复选框列表，allRoles 为可选角色列表 -->
                        <FormItem Label="角色">
                            @foreach (var role in RoleList)
                            {
                                <Checkbox Value="@userDtoContext.Roles.Contains(role.RoleName)" Label="@role.RoleName" OnChange="@((e) => ToggleRole(e, role.RoleName))" />
                            }
                        </FormItem>

                        <!-- Claims：展示已有 Claim，每项包含 Type 与 Value，同时提供添加/删除操作 -->
                        <FormItem Label="Claims">
                            @foreach (var claim in userDtoContext.Claims)
                            {
                                <InputGroup Compact>
                                    <Input placeholder="Claim Type" @bind-Value="claim.Type" />
                                    <Input placeholder="Claim Value" @bind-Value="claim.Value" />
                                    <Button Danger OnClick="@((e)=>RemoveClaim(claim))">删除</Button>
                                </InputGroup>
                            }
                            <Button type="ButtonType.Primary" OnClick="AddClaim">添加 Claim</Button>
                        </FormItem>
                        @if (requestDto is null)
                        {
                            <!-- 提交按钮 -->
                            <FormItem>
                                <Button type="ButtonType.Primary" OnClick="UpdateUserBtnClick" AutoLoading>提交</Button>
                            </FormItem>
                        }
                    </ChildContent>
                </Form>
            }

            @if (requestDto is not null)
            {
                <Form Model="@requestDto">
                    <ChildContent Context="requestDtoContext">
                        <!-- 申请时间：只读显示 -->
                        <FormItem Label="申请时间">
                            <LocalDateTimeDisplay Value="@requestDtoContext.RequestTime" />
                        </FormItem>
                        <!-- 申请状态：只读显示 -->
                        <FormItem Label="申请状态">
                            <Input @bind-Value="requestDtoContext.Status" Disabled="true" />
                        </FormItem>
                        <!-- 申请图片 -->
                        <FormItem Label="申请图片">
                            <Image Src="@ImageDataUrl" />
                        </FormItem>
                        <!-- 申请内容 -->
                        <FormItem Label="申请内容">
                            <Input @bind-Value="requestDtoContext.IdentityType" Disabled="true" />
                        </FormItem>
                        <FormItem Label="申请机构">
                            <Input @bind-Value="requestDtoContext.InstitutionName" />
                        </FormItem>
                        <FormItem Label="审核处理意见">
                            <Input @bind-Value="requestDtoContext.ProcessDetails" />
                        </FormItem>
                        <FormItem Label="备注信息">
                            <Input @bind-Value="requestDtoContext.Remarks" />
                        </FormItem>
                    </ChildContent>
                </Form>
                @if (userInfoExtension is not null)
                {
                    <Form Model="@userInfoExtension">
                        <ChildContent Context="userInfoExtensionContext">
                            <FormItem Label="真实姓名">
                                <Input @bind-Value="userInfoExtensionContext.RealName" />
                            </FormItem>
                            <FormItem Label="执业类别">
                                <Input @bind-Value="userInfoExtensionContext.PracticingType" />
                            </FormItem>
                            <FormItem Label="执业范围">
                                <Input @bind-Value="userInfoExtensionContext.PracticingScope" />
                            </FormItem>
                            <FormItem Label="所学专业">
                                <Input @bind-Value="userInfoExtensionContext.Major" />
                            </FormItem>
                            <FormItem Label="所教专业">
                                <Input @bind-Value="userInfoExtensionContext.PrimarySubject" />
                            </FormItem>
                            <FormItem>
                                <Button type="ButtonType.Default" OnClick="ApproveBtnClick">通过</Button>
                                <Button type="ButtonType.Dashed" OnClick="RejectBtnClick">拒绝</Button>
                            </FormItem>
                        </ChildContent>
                    </Form>
                }
            }
        </Drawer>
    </Authorized>
    <NotAuthorized>
        <Paragraph>你没有足够权限访问此内容。</Paragraph>
    </NotAuthorized>
</AuthorizeView>
@code {
    private NotificationDto NewNotification { get; set; } = new NotificationDto();
    private List<UserDto> UserList { get; } = [];
    private List<RoleClaimsDto> RoleList { get; } = [];
    private string newRole = string.Empty;
    private UserInfoDto? userInfoDto;
    // 保存图片的 Base64 字符串
    private string ImageDataUrl { get; set; } = string.Empty;

    private Guid currentRequestId = Guid.Empty;
    private List<ProfessionalCertificationRequestDto> ProfessionalCertificationRequestList { get; } = [];
    private ProfessionalCertificationRequestDto? requestDto => ProfessionalCertificationRequestList.FirstOrDefault(x => x.Id == currentRequestId);
    private UserInfoExtension? userInfoExtension;

    private bool drawerVisible = false;

    private readonly CancellationTokenSource lifetimeCancellation = new();

    private async Task EditBtnClick(object dataContext)
    {
        ImageDataUrl = string.Empty;
        userInfoDto = null;
        currentRequestId = Guid.Empty;
        userInfoExtension = null;
        if (dataContext is UserDto user)
        {
            try
            {
                using var httpClient = HttpClientFactory.CreateClient("Authorize");
                var getRes = await httpClient.GetFromJsonAsync<UserInfoDto>(
                    $"Admin/GetUserInfo/{user.Id}",
                    lifetimeCancellation.Token);
                if (getRes is null)
                {
                    await Message.ErrorAsync("用户信息为空。");
                    return;
                }

                userInfoDto = getRes;
                drawerVisible = true;
            }
            catch (OperationCanceledException) when (lifetimeCancellation.IsCancellationRequested)
            {
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Unable to open user {UserId} for editing.", user.Id);
                await Message.ErrorAsync("用户信息加载失败，请稍后重试。");
            }
        }
        else if (dataContext is ProfessionalCertificationRequestDto requestDto)
        {
            try
            {
                using var httpClient = HttpClientFactory.CreateClient("Authorize");

                // 获取用户信息
                using var userResponse = await httpClient.GetAsync(
                    $"Admin/GetUserInfo/{requestDto.UserId}",
                    lifetimeCancellation.Token);
                if (!userResponse.IsSuccessStatusCode)
                {
                    await Message.ErrorAsync($"获取用户信息失败：{userResponse.ReasonPhrase}");
                    return;
                }

                var getRes = await userResponse.Content.ReadFromJsonAsync<UserInfoDto>(lifetimeCancellation.Token);
                if (getRes is null)
                {
                    await Message.ErrorAsync("用户信息为空。");
                    return;
                }

                userInfoDto = getRes;
                currentRequestId = requestDto.Id;

                // 判断 CertificateTicket 是否有效
                if (requestDto.CertificateTicket is null)
                {
                    await Message.ErrorAsync("证件图片标识为空。");
                }
                else
                {
                    using var imageResponse = await httpClient.GetAsync(
                        $"Admin/CertificateImage/{requestDto.CertificateTicket}",
                        lifetimeCancellation.Token);
                    if (!imageResponse.IsSuccessStatusCode)
                    {
                        await Message.ErrorAsync("获取证件图片失败。");
                    }
                    else
                    {
                        var imageBytes = await imageResponse.Content.ReadAsByteArrayAsync(lifetimeCancellation.Token);
                        if (imageBytes.Length == 0)
                        {
                            await Message.ErrorAsync("证件图片为空或加载失败。");
                        }
                        else
                        {
                            var mediaType = imageResponse.Content.Headers.ContentType?.MediaType;
                            if (mediaType is not ("image/jpeg" or "image/png"))
                            {
                                await Message.ErrorAsync("服务器返回了不支持的证件图片格式。");
                            }
                            else
                            {
                                ImageDataUrl = $"data:{mediaType};base64,{Convert.ToBase64String(imageBytes)}";
                            }
                        }
                    }
                }

                if (requestDto.Status == RequestStatus.Pending)
                {
                    userInfoExtension = new UserInfoExtension();
                }
                drawerVisible = true;
            }
            catch (OperationCanceledException) when (lifetimeCancellation.IsCancellationRequested)
            {
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Unable to open a professional certification request.");
                await Message.ErrorAsync("认证申请详情加载失败，请稍后重试。");
            }
        }
    }

    private async Task DeleteUser(UserDto user)
    {
        if (user is not null)
        {
            try
            {
                using var httpClient = HttpClientFactory.CreateClient("Authorize");
                using var delRes = await httpClient.DeleteAsync(
                    $"Admin/DeleteUser/{user.Id}",
                    lifetimeCancellation.Token);
                if (delRes.IsSuccessStatusCode)
                {
                    await Message.InfoAsync("删除成功");
                }
                else
                {
                    await Message.ErrorAsync("删除失败");
                }
            }
            catch (OperationCanceledException) when (lifetimeCancellation.IsCancellationRequested)
            {
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Unable to delete user {UserId}.", user.Id);
                await Message.ErrorAsync("删除用户请求异常，请稍后重试。");
            }
            finally
            {
                if (!lifetimeCancellation.IsCancellationRequested)
                {
                    await TryRefreshUserListAsync();
                }
            }
        }
    }

    private async Task GetUserList()
    {
        UserList.Clear();
        using var httpClient = HttpClientFactory.CreateClient("Authorize");
        var getRes = await httpClient.GetFromJsonAsync<List<UserDto>>(
            "Admin/Users",
            lifetimeCancellation.Token);
        if (getRes is not null)
        {
            UserList.AddRange(getRes);
        }
    }

    private async Task GetRoleList()
    {
        RoleList.Clear();
        using var httpClient = HttpClientFactory.CreateClient("Authorize");
        var roleNames = await httpClient.GetFromJsonAsync<List<string>>(
            "Admin/Roles",
            lifetimeCancellation.Token);
        if (roleNames?.Count > 0)
        {
            foreach (var roleName in roleNames)
            {
                var roleClaims = await httpClient.GetFromJsonAsync<RoleClaimsDto>(
                    $"Admin/RoleClaims/{Uri.EscapeDataString(roleName)}",
                    lifetimeCancellation.Token);
                if (roleClaims is not null)
                {
                    RoleList.Add(roleClaims);
                }
            }
        }
    }

    private async Task GetCertificationRequestList()
    {
        ProfessionalCertificationRequestList.Clear();
        using var httpClient = HttpClientFactory.CreateClient("Authorize");
        var getRes = await httpClient.GetFromJsonAsync<List<ProfessionalCertificationRequestDto>>(
            "Admin/ProfessionalCertificationRequests",
            lifetimeCancellation.Token);
        if (getRes is not null)
        {
            ProfessionalCertificationRequestList.AddRange(getRes);
        }
    }

    private async Task<bool> UpdateUserAsync()
    {
        if (userInfoDto is null)
        {
            await Message.ErrorAsync("没有可更新的用户信息。");
            return false;
        }

        try
        {
            // 获取带授权的 HttpClient
            using var httpClient = HttpClientFactory.CreateClient("Authorize");

            // 发送 PUT 请求，传入 userInfoDto 对象，注意接口地址应与后端路由匹配
            using var response = await httpClient.PutAsJsonAsync(
                "Admin/UpdateUser",
                userInfoDto,
                lifetimeCancellation.Token);
            if (response.IsSuccessStatusCode)
            {
                await Message.SuccessAsync("用户更新成功！");
                await TryRefreshUserListAsync();
                return true;
            }

            await Message.ErrorAsync("用户更新失败，请检查提交内容。");
        }
        catch (OperationCanceledException) when (lifetimeCancellation.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to update user {UserId}.", userInfoDto.UserId);
            await Message.ErrorAsync("用户更新请求异常，请稍后重试。");
        }

        return false;
    }

    private async Task UpdateUserBtnClick()
    {
        if (await UpdateUserAsync())
        {
            userInfoDto = null;
            drawerVisible = false;
        }
    }

    private async Task ApproveBtnClick()
    {
        if (userInfoDto is null)
            return;

        if (requestDto is null)
            return;

        if (userInfoExtension is null)
            return;

        if (string.IsNullOrWhiteSpace(userInfoExtension.RealName))
        {
            await Message.ErrorAsync("真实姓名不能为空");
            return;
        }


        //根据Require验证UserInfoExtension模型是否合法
        if (!userInfoDto.Roles.Contains(requestDto.IdentityType, StringComparer.Ordinal))
        {
            userInfoDto.Roles.Add(requestDto.IdentityType);
        }
        AddClaimIfMissing(userInfoDto, UserClaimTypes.InstitutionName, requestDto.InstitutionName);
        AddClaimIfMissing(userInfoDto, UserClaimTypes.RealName, userInfoExtension.RealName);

        if (userInfoExtension.PracticingType is not null)
        {
            AddClaimIfMissing(userInfoDto, "PracticingType", userInfoExtension.PracticingType);
        }
        if (userInfoExtension.PracticingScope is not null)
        {
            AddClaimIfMissing(userInfoDto, "PracticingScope", userInfoExtension.PracticingScope);
        }
        if (userInfoExtension.Major is not null)
        {
            AddClaimIfMissing(userInfoDto, "Major", userInfoExtension.Major);
        }
        if (userInfoExtension.PrimarySubject is not null)
        {
            AddClaimIfMissing(userInfoDto, "PrimarySubject", userInfoExtension.PrimarySubject);
        }

        if (!await UpdateUserAsync())
        {
            return;
        }

        try
        {
            requestDto.Status = RequestStatus.Approved;
            // 获取带授权的 HttpClient
            using var httpClient = HttpClientFactory.CreateClient("Authorize");

            // 发送 PUT 请求，传入 userInfoDto 对象，注意接口地址应与后端路由匹配
            using var response = await httpClient.PutAsJsonAsync(
                "Admin/UpdateRequest",
                requestDto,
                lifetimeCancellation.Token);
            if (response.IsSuccessStatusCode)
            {
                await Message.SuccessAsync("审核列表更新成功！");
                ImageDataUrl = string.Empty;
                currentRequestId = Guid.Empty;
                userInfoDto = null;
                userInfoExtension = null;
                drawerVisible = false;
                await TryRefreshCertificationRequestsAsync();
            }
            else
            {
                requestDto.Status = RequestStatus.Pending;
                await Message.ErrorAsync("用户权限已更新，但审核记录更新失败，请立即重试。");
            }
        }
        catch (OperationCanceledException) when (lifetimeCancellation.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            requestDto.Status = RequestStatus.Pending;
            Logger.LogError(ex, "Unable to approve certification request {RequestId}.", requestDto.Id);
            await Message.ErrorAsync("用户权限已更新，但审核记录更新异常，请立即重试。");
        }
    }

    private async Task RejectBtnClick()
    {
        if (requestDto is null)
            return;

        requestDto.Status = RequestStatus.Rejected;

        try
        {
            // 获取带授权的 HttpClient
            using var httpClient = HttpClientFactory.CreateClient("Authorize");
            // 发送 PUT 请求，传入 userInfoDto 对象，注意接口地址应与后端路由匹配
            using var response = await httpClient.PutAsJsonAsync(
                "Admin/UpdateRequest",
                requestDto,
                lifetimeCancellation.Token);
            if (response.IsSuccessStatusCode)
            {
                await Message.SuccessAsync("审核列表更新成功！");
                ImageDataUrl = string.Empty;
                currentRequestId = Guid.Empty;
                userInfoDto = null;
                userInfoExtension = null;
                drawerVisible = false;
                await TryRefreshCertificationRequestsAsync();
            }
            else
            {
                requestDto.Status = RequestStatus.Pending;
                await Message.ErrorAsync("审核记录更新失败，请检查提交内容后重试。");
            }
        }
        catch (OperationCanceledException) when (lifetimeCancellation.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            requestDto.Status = RequestStatus.Pending;
            Logger.LogError(ex, "Unable to reject certification request {RequestId}.", requestDto.Id);
            await Message.ErrorAsync("审核记录更新异常，请稍后重试。");
        }
    }


    protected override async Task OnInitializedAsync()
    {
        try
        {
            await GetUserList();
            await GetRoleList();
            await GetCertificationRequestList();
        }
        catch (OperationCanceledException) when (lifetimeCancellation.IsCancellationRequested)
        {
        }
        catch (Exception ex) when (ex is HttpRequestException or NotSupportedException or System.Text.Json.JsonException)
        {
            Logger.LogError(ex, "Unable to initialize the administration page.");
            await Message.ErrorAsync("管理数据加载失败，请稍后重试。");
        }
    }

    /// <summary>
    /// 切换角色选中状态
    /// </summary>
    private void ToggleRole(bool isChecked, string role)
    {
        if (userInfoDto is not null)
        {
            if (isChecked)
            {
                if (!userInfoDto.Roles.Contains(role))
                {
                    userInfoDto.Roles.Add(role);
                }
            }
            else
            {
                userInfoDto.Roles.Remove(role);
            }
        }
    }

    /// <summary>
    /// 添加一个空 Claim
    /// </summary>
    private void AddClaim()
    {
        if (userInfoDto is not null)
        {
            userInfoDto.Claims.Add(new ClaimDto { Type = string.Empty, Value = string.Empty });
        }
    }

    private static void AddClaimIfMissing(UserInfoDto user, string type, string value)
    {
        if (!user.Claims.Any(claim =>
                string.Equals(claim.Type, type, StringComparison.Ordinal)
                && string.Equals(claim.Value, value, StringComparison.Ordinal)))
        {
            user.Claims.Add(new ClaimDto { Type = type, Value = value });
        }
    }

    private void AddRoleClaim(RoleClaimsDto dto)
    {
        if (dto is not null)
        {
            dto.Claims.Add(new ClaimDto { Type = string.Empty, Value = string.Empty });
        }
    }

    private async Task AddRole()
    {
        try
        {
            if (!string.IsNullOrWhiteSpace(newRole))
            {
                using var httpClient = HttpClientFactory.CreateClient("Authorize");


                using var formContent = new FormUrlEncodedContent([new KeyValuePair<string, string>(nameof(newRole), newRole.Trim())]);

                using var res = await httpClient.PostAsync(
                    "Admin/AddRole",
                    formContent,
                    lifetimeCancellation.Token);
                if (!res.IsSuccessStatusCode)
                {
                    await Message.ErrorAsync("角色添加失败，请确认名称没有重复。");
                }
                else
                {
                    await Message.SuccessAsync("角色添加成功。");
                }
            }
            else
            {
                await Message.ErrorAsync("role name不可为空");
            }
        }
        catch (OperationCanceledException) when (lifetimeCancellation.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to add role {RoleName}.", newRole);
            await Message.ErrorAsync("角色添加请求异常，请稍后重试。");
        }
        finally
        {
            newRole = string.Empty;
            if (!lifetimeCancellation.IsCancellationRequested)
            {
                await TryRefreshRoleListAsync();
            }
        }
    }

    /// <summary>
    /// 删除指定索引的 Claim
    /// </summary>
    /// <param name="claim"></param>
    private void RemoveClaim(ClaimDto claim)
    {
        if (userInfoDto is not null)
        {
            userInfoDto.Claims.Remove(claim);
        }
    }

    private void RemoveRoleClaim(ClaimDto claim, RoleClaimsDto role)
    {
        role.Claims.Remove(claim);
    }

    /// <summary>
    /// 将当前角色的 Claims 更新到后端
    /// </summary>
    private async Task SaveRoleClaims(RoleClaimsDto roleClaimsDto)
    {
        if (roleClaimsDto == null)
        {
            await Message.ErrorAsync("没有加载角色Claims");
            return;
        }

        try
        {
            using var httpClient = HttpClientFactory.CreateClient("Authorize");
            // 调用后端 PUT 接口，传入角色名称和更新后的 Claim 列表
            using var response = await httpClient.PutAsJsonAsync(
                $"Admin/UpdateRoleClaims/{Uri.EscapeDataString(roleClaimsDto.RoleName)}",
                roleClaimsDto.Claims,
                lifetimeCancellation.Token);
            if (response.IsSuccessStatusCode)
            {
                await Message.SuccessAsync("角色Claims更新成功！");
            }
            else
            {
                await Message.ErrorAsync("角色 Claims 更新失败，请检查提交内容。");
            }
        }
        catch (OperationCanceledException) when (lifetimeCancellation.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to update claims for role {RoleName}.", roleClaimsDto.RoleName);
            await Message.ErrorAsync("角色 Claims 更新异常，请稍后重试。");
        }
        finally
        {
            if (!lifetimeCancellation.IsCancellationRequested)
            {
                await TryRefreshRoleListAsync();
            }
        }
    }

    private async Task SubmitNotification()
    {
        try
        {
            using var httpClient = HttpClientFactory.CreateClient("Authorize");
            // 调用后端 PUT 接口，传入角色名称和更新后的 Claim 列表
            using var response = await httpClient.PutAsJsonAsync(
                "Admin/Notification",
                NewNotification,
                lifetimeCancellation.Token);
            if (response.IsSuccessStatusCode)
            {
                await Message.SuccessAsync("通知更新成功！");
            }
            else
            {
                await Message.ErrorAsync("通知更新失败，请检查提交内容。");
            }
        }
        catch (OperationCanceledException) when (lifetimeCancellation.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to update site notification.");
            await Message.ErrorAsync("通知更新异常，请稍后重试。");
        }
        finally
        {
            NewNotification = new NotificationDto();
        }
    }

