@page "/maintreatment/{id?}"
@using EzNutrition.Application.Consultations
@using EzNutrition.Application.Archives
@using EzNutrition.Presentation.Services
@using EzNutrition.Domain.Assessments
@using EzNutrition.Domain.Calculations
@using EzNutrition.Domain.Consultations
@using EzNutrition.Shared.Data.Entities
@attribute [Authorize]
@implements IDisposable
@inject UserSessionService UserSession
@inject PublicSystemInfoService SystemInfo
@inject NavigationManager Navigation
@inject ConsultationWorkspaceManager WorkspaceManager
@inject ConsultationApplicationService ConsultationService
@inject NutritionAssessmentApplicationService NutritionAssessmentService
@inject IMessageService Message
@inject IArchiveWorkflow ArchiveWorkflow
@inject ILogger<MainTreatment> Logger

<PageTitle>营养咨询</PageTitle>

@if (CurrentArchive is not null)
{
    <section class="treatment-page">
        <header class="page-heading treatment-heading">
            <div>
                <span>门诊咨询</span>
                <h1>@PageHeading</h1>
                <p>@PageDescription</p>
            </div>
            @if (!CurrentArchive.ClientInfoFormEnabled)
            {
                <ArchiveActions Workspace="CurrentArchive" />
            }
        </header>

        @if (CurrentArchive.ClientInfoFormEnabled)
        {
            <div class="setup-grid">
                <section class="surface-card patient-form-card" aria-labelledby="patient-info-title">
                    <div class="section-heading">
                        <div>
                            <span>步骤 1</span>
                            <h2 id="patient-info-title">基本信息</h2>
                        </div>
                        <Icon Type="idcard" Theme="IconThemeType.Outline" />
                    </div>

                    @if (CurrentArchive.IsFollowUp)
                    {
                        <Alert Class="follow-up-notice"
                               Type="AlertType.Info"
                               Message="已沿用既有患者身份"
                               Description="姓名沿用既有档案；其余信息已根据上一次咨询预填，请按本次实际情况核对并更新。"
                               ShowIcon="true" />
                    }

                    <Spin Spinning="CurrentArchive.IsLoading">
                        <Form Model="@CurrentArchive.Client" Layout="FormLayout.Vertical">
                            <GridRow Gutter="(16,0)">
                                <GridCol Xs="24">
                                    <FormItem Label="姓名（选填）">
                                        <Input Placeholder="仅用于区分当前应用中的咨询对象，服务器不保存"
                                               id="name"
                                               Disabled="@CurrentArchive.IsFollowUp"
                                               @bind-Value="context.Name" />
                                    </FormItem>
                                </GridCol>
                                <GridCol Xs="24">
                                    <FormItem Label="性别">
                                        <RadioGroup TValue="string" id="gender" @bind-Value="context.Gender">
                                            <Radio RadioButton Value="@("男")">男</Radio>
                                            <Radio RadioButton Value="@("女")">女</Radio>
                                        </RadioGroup>
                                    </FormItem>
                                </GridCol>
                                <GridCol Xs="24">
                                    <AgeEntry Client="context" Inline />
                                </GridCol>
                                <GridCol Xs="24" Sm="12">
                                    <FormItem Label="身高（cm）">
                                        <Input @bind-Value="context.Height" type="InputType.Number" min="0" />
                                        <ConsultationHistoryPanel History="CurrentArchive.History" Item="ConsultationHistoryItem.Height" Title="既往身高" OnLoad="LoadHistoryAsync" />
                                    </FormItem>
                                </GridCol>
                                <GridCol Xs="24" Sm="12">
                                    <FormItem Label="体重（kg）">
                                        <Input @bind-Value="context.Weight" type="InputType.Number" min="0" />
                                        <ConsultationHistoryPanel History="CurrentArchive.History" Item="ConsultationHistoryItem.Weight" Title="既往体重" OnLoad="LoadHistoryAsync" />
                                    </FormItem>
                                </GridCol>
                                <GridCol Xs="24">
                                    <FormItem Label="特殊生理状况">
                                        <RadioGroup TValue="string" id="specialPhysiologicalPeriod" @bind-Value="context.SpecialPhysiologicalPeriod">
                                            <Radio RadioButton Value="@string.Empty">无</Radio>
                                            <Radio RadioButton Value="@("孕早期")">孕早期</Radio>
                                            <Radio RadioButton Value="@("孕中期")">孕中期</Radio>
                                            <Radio RadioButton Value="@("孕晚期")">孕晚期</Radio>
                                            <Radio RadioButton Value="@("乳母")">乳母</Radio>
                                            <Radio RadioButton Value="@("已绝经")">已绝经</Radio>
                                        </RadioGroup>
                                    </FormItem>
                                </GridCol>
                            </GridRow>
                            <div class="form-actions">
                                <Button Type="@ButtonType.Primary" OnClick="OnCalculateBtnClick" AutoLoading>
                                    确认并进入核算
                                    <Icon Type="arrow-right" Theme="IconThemeType.Outline" />
                                </Button>
                            </div>
                        </Form>
                    </Spin>
                </section>

                <aside class="surface-card notice-card" aria-labelledby="consultation-notice-title">
                    <div class="section-heading">
                        <div>
                            <span>工作提示</span>
                            <h2 id="consultation-notice-title">注意事项</h2>
                        </div>
                        <Icon Type="notification" Theme="IconThemeType.Outline" />
                    </div>
                    @if (!SystemInfo.IsLoaded)
                    {
                        <Skeleton Active />
                    }
                    else if (string.IsNullOrEmpty(SystemInfo.Notice))
                    {
                        <Alert Type="AlertType.Info" Message="工作提示暂时不可用" Description="服务端内容未能加载；可以继续进行本地核算。" ShowIcon="true" />
                    }
                    else
                    {
                        @SafeMarkdown.Render(SystemInfo.Notice)
                    }
                </aside>
            </div>
        }
        else
        {
            <div class="active-treatment-layout">
                <aside class="client-context-rail" aria-label="当前咨询对象与页面导航">
                    <section class="surface-card client-card">
                        <div class="section-heading compact-heading">
                            <div>
                                <span>当前咨询对象</span>
                                <h2>@(string.IsNullOrWhiteSpace(CurrentArchive.Client.Name) ? "未命名对象" : CurrentArchive.Client.Name)</h2>
                            </div>
                            <Icon Type="user" Theme="IconThemeType.Outline" />
                        </div>

                        <dl class="client-facts">
                            <div><dt>性别</dt><dd>@CurrentArchive.Client.Gender</dd></div>
                            <div><dt>年龄</dt><dd>@CurrentArchive.Client.Age</dd></div>
                            <div><dt>身高</dt><dd>@CurrentArchive.Client.Height cm</dd></div>
                            <div><dt>体重</dt><dd>@CurrentArchive.Client.Weight kg</dd></div>
                            <div class="wide-fact"><dt>生理状况</dt><dd>@(string.IsNullOrEmpty(CurrentArchive.Client.SpecialPhysiologicalPeriod) ? "无" : CurrentArchive.Client.SpecialPhysiologicalPeriod)</dd></div>
                        </dl>
                        <ConsultationHistoryPanel History="CurrentArchive.History" Item="ConsultationHistoryItem.Height" Title="既往身高" OnLoad="LoadHistoryAsync" />
                        <ConsultationHistoryPanel History="CurrentArchive.History" Item="ConsultationHistoryItem.Weight" Title="既往体重" OnLoad="LoadHistoryAsync" />

                        @if (CurrentArchive.CurrentEnergyCalculator?.BMI is not null)
                        {
                            <div class="client-indicators">
                                <Tag Color="@("blue")">BMI @CurrentArchive.CurrentEnergyCalculator.BMI</Tag>
                            </div>
                        }
                    </section>

                    <nav class="section-navigation" aria-label="本次咨询区段">
                        <span>本次咨询</span>
                        <Anchor Affix="false" Bounds="16" TargetOffset="24">
                            <AnchorLink Href="#nutrition-workspace" Title="专业核算" />
                            <AnchorLink Href="#nutrition-summary" Title="综合结果" />
                            @if (CurrentArchive.SubjectiveObjectiveAssessmentPlanInformation is not null)
                            {
                                <AnchorLink Href="#nutrition-diagnosis" Title="营养问题与诊断" />
                            }
                            <AnchorLink Href="#nutrition-advice" Title="膳食建议" />
                        </Anchor>
                    </nav>
                </aside>

                <div class="treatment-content-flow">
                    <section id="nutrition-workspace" class="surface-card workspace-card" aria-label="营养核算工作区">
                        <Tabs Class="treatment-tabs"
                              Type="TabType.EditableCard"
                              HideAdd
                              @bind-ActiveKey="activeWorkspaceTabKey"
                              OnClose="CloseAssessmentTab">
                            <TabBarExtraContentRight>
                                <Dropdown Trigger="@(new[] { Trigger.Click })"
                                          Disabled="@(!CanAddAssessment)">
                                    <Overlay>
                                        <Menu>
                                            @foreach (var definition in NutritionAssessmentService.Definitions)
                                            {
                                                var isOpen = IsAssessmentOpen(definition);
                                                <MenuItem Disabled="@isOpen"
                                                          OnClick="@(() => AddAssessment(definition))">
                                                    <Icon Type="profile" Theme="IconThemeType.Outline" />
                                                    <span>@definition.DisplayName</span>
                                                    @if (isOpen)
                                                    {
                                                        <span class="assessment-menu-state">已添加</span>
                                                    }
                                                </MenuItem>
                                            }
                                        </Menu>
                                    </Overlay>
                                    <ChildContent>
                                        <Button Class="assessment-add-button"
                                                Type="@ButtonType.Dashed"
                                                Disabled="@(!CanAddAssessment)"
                                                AriaLabel="添加量表">
                                            <Icon Type="plus" Theme="IconThemeType.Outline" />
                                            <span class="assessment-add-label">添加量表</span>
                                            <Icon Type="down" Theme="IconThemeType.Outline" />
                                        </Button>
                                    </ChildContent>
                                </Dropdown>
                            </TabBarExtraContentRight>
                            <ChildContent>
                                <TabPane Key="energy" Tab="能量评估" Closable="false">
                                    @if (CurrentArchive.CurrentEnergyCalculator is not null)
                                    {
                                        <EnergyCalculatorTreatment EnergyCalculator="CurrentArchive.CurrentEnergyCalculator"
                                                                   IsTouchDetected="@UserSession.IsTouchDetected"
                                                                   OnSoapContributionConfirmed="AppendSoapContributionAsync" />
                                        <ConsultationHistoryPanel History="CurrentArchive.History" Item="ConsultationHistoryItem.AdoptedEnergy" Title="既往采用能量" OnLoad="LoadHistoryAsync" />
                                    }
                                </TabPane>
                                <TabPane Key="dri" Tab="参考摄入量" Closable="false">
                                    @if (CurrentArchive.DRIs is not null)
                                    {
                                        <DRIsInSightTable NutrientRanges="CurrentArchive.DRIs.NutrientRanges" />
                                    }
                                </TabPane>
                                <TabPane Key="dietary" Tab="膳食调查" Closable="false">
                                    @if (CurrentArchive.DietaryRecallSurvey is not null)
                                    {
                                        <DietarySurvey DietaryRecallSurvey="CurrentArchive.DietaryRecallSurvey"
                                                       OnCalculationCompleted="DietarySurveyCalculationCompleted"
                                                       OnSoapContributionConfirmed="AppendSoapContributionAsync" />
                                        <ConsultationHistoryPanel History="CurrentArchive.History" Item="ConsultationHistoryItem.DietaryEnergy" Title="既往膳食记录总能量" OnLoad="LoadHistoryAsync" />
                                    }
                                </TabPane>
                                @foreach (var assessment in CurrentArchive.NutritionAssessments)
                                {
                                    <TabPane @key="assessment.RunId"
                                             Key="@AssessmentTabKey(assessment)"
                                             Tab="@assessment.Definition.DisplayName"
                                             Closable="true">
                                        <NutritionAssessmentScale Assessment="assessment"
                                                                  OnSoapContributionConfirmed="AppendSoapContributionAsync" />
                                    </TabPane>
                                }
                            </ChildContent>
                        </Tabs>
                    </section>

                    <section id="nutrition-summary" class="surface-card summary-card">
                        <Summary Archive="@CurrentArchive"
                                 OnSoapContributionConfirmed="AppendSoapContributionAsync" />
                    </section>

                    @if (CurrentArchive.SubjectiveObjectiveAssessmentPlanInformation is { } medicalInformation)
                    {
                        <section id="nutrition-diagnosis" class="surface-card diagnosis-card" aria-label="营养问题与诊断">
                            <MedicalInformation Information="medicalInformation" History="CurrentArchive.History" OnLoadHistory="LoadHistoryAsync" />
                        </section>
                    }

                    <section id="nutrition-advice" class="surface-card advice-card">
                        <div class="section-heading compact-heading">
                            <div>
                                <span>综合输出</span>
                                <h2>膳食建议</h2>
                            </div>
                            <Icon Type="solution" Theme="IconThemeType.Outline" />
                        </div>
                        <Advice CurrentArchive="@CurrentArchive"
                                OnSoapContributionConfirmed="AppendSoapContributionAsync" />
                        <ConsultationHistoryPanel History="CurrentArchive.History" Item="ConsultationHistoryItem.Advice" Title="既往营养建议" OnLoad="LoadHistoryAsync" />
                    </section>
                </div>
            </div>
        }
    </section>
}

@code {
    [Parameter]
    public string? Id { get; set; }

    private readonly CancellationTokenSource lifetimeCancellation = new();

    /// <summary>按需加载当前复诊的共享历史；异常不清空本次咨询，也不自动发送历史给后端。</summary>
    private async Task LoadHistoryAsync(bool reload)
    {
        if (CurrentArchive?.History is not { } history) return;
        try
        {
            if (reload) await history.ReloadAsync(ArchiveWorkflow, lifetimeCancellation.Token);
            else await history.LoadAsync(ArchiveWorkflow, lifetimeCancellation.Token);
        }
        catch (OperationCanceledException) when (lifetimeCancellation.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Unable to load consultation history.");
            await Message.ErrorAsync("既往咨询读取失败，请稍后重新展开历史记录。");
        }
    }
    private const string AssessmentTabPrefix = "assessment-";
    private string activeWorkspaceTabKey = "energy";

    public ConsultationWorkspace? CurrentArchive { get; private set; }

    private bool CanAddAssessment => CurrentArchive is not null
        && NutritionAssessmentService.Definitions.Any(definition =>
            !IsAssessmentOpen(definition));

    private string PageHeading => CurrentArchive switch
    {
        { ClientInfoFormEnabled: true, IsFollowUp: true } => "新建后续咨询",
        { ClientInfoFormEnabled: true } => "新建营养咨询",
        { Client.Name: { } name } when !string.IsNullOrWhiteSpace(name) => $"{name}的营养评估",
        _ => "营养评估工作区"
    };

    private string PageDescription => CurrentArchive?.ClientInfoFormEnabled switch
    {
        true when CurrentArchive.IsFollowUp => "核对本次人体测量与生理信息后，开始一份新的独立咨询记录。",
        true => "先录入必要的人体测量与生理信息，再进入各项专业核算。",
        _ => "依次完成专业核算、综合结果、营养问题与诊断，以及膳食建议。"
    };

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        SystemInfo.StateChanged += HandleSystemInfoChanged;
        base.OnInitialized();
    }

    /// <summary>公共公告完成加载后更新工作台。</summary>
    private void HandleSystemInfoChanged() => _ = InvokeAsync(StateHasChanged);

    protected override void OnParametersSet()
    {
        if (Guid.TryParse(Id, out var archiveId) && WorkspaceManager.TryGetValue(archiveId, out var archive))
        {
            if (!ReferenceEquals(CurrentArchive, archive))
            {
                activeWorkspaceTabKey = "energy";
            }

            CurrentArchive = archive;
            return;
        }

        CurrentArchive = null;
        Navigation.NavigateTo("/");
    }

    private async Task OnCalculateBtnClick()
    {
        if (CurrentArchive is null)
        {
            return;
        }

        await WorkspaceManager.ClientInfoConfirmed(CurrentArchive, lifetimeCancellation.Token);
    }

    private void DietarySurveyCalculationCompleted()
    {
        StateHasChanged();
    }

    private async Task AddAssessment(NutritionAssessmentDefinition definition)
    {
        var archive = CurrentArchive;
        if (archive is null)
        {
            return;
        }

        try
        {
            if (!await UserSession.EnsureAuthenticatedAsync(lifetimeCancellation.Token))
            {
                await Message.ErrorAsync("需要登录");
                Navigation.NavigateTo("/");
                return;
            }
            // 等待续期时用户可能已经切换工作区，不把原操作应用到另一份咨询。
            if (CurrentArchive != archive)
            {
                return;
            }
            var existing = archive.NutritionAssessments.SingleOrDefault(assessment =>
                HasSameIdentity(assessment.Definition, definition));
            var assessment = existing
                ?? NutritionAssessmentService.StartRun(archive, definition, currentUser: UserSession.UserInfo);
            activeWorkspaceTabKey = AssessmentTabKey(assessment);
        }
        catch (OperationCanceledException) when (lifetimeCancellation.IsCancellationRequested)
        {
        }
        catch (InvalidOperationException exception)
        {
            await Message.ErrorAsync(exception.Message);
        }
    }

    private void CloseAssessmentTab(string tabKey)
    {
        if (CurrentArchive is null || !TryGetAssessmentRunId(tabKey, out var runId))
        {
            return;
        }

        var wasActive = string.Equals(activeWorkspaceTabKey, tabKey, StringComparison.Ordinal);
        if (NutritionAssessmentService.RemoveRun(CurrentArchive, runId) && wasActive)
        {
            activeWorkspaceTabKey = "dietary";
        }
    }

    private bool IsAssessmentOpen(NutritionAssessmentDefinition definition) =>
        CurrentArchive?.NutritionAssessments.Any(assessment =>
            HasSameIdentity(assessment.Definition, definition)) == true;

    private static bool HasSameIdentity(
        NutritionAssessmentDefinition left,
        NutritionAssessmentDefinition right) =>
        left.CodeSystem == right.CodeSystem
        && string.Equals(left.Code, right.Code, StringComparison.Ordinal)
        && string.Equals(left.Version, right.Version, StringComparison.Ordinal);

    private static string AssessmentTabKey(NutritionAssessmentRun assessment) =>
        $"{AssessmentTabPrefix}{assessment.RunId:N}";

    private static bool TryGetAssessmentRunId(string tabKey, out Guid runId)
    {
        runId = default;
        return tabKey.StartsWith(AssessmentTabPrefix, StringComparison.Ordinal)
            && Guid.TryParseExact(tabKey[AssessmentTabPrefix.Length..], "N", out runId);
    }

    private async Task AppendSoapContributionAsync(SoapContribution contribution)
    {
        if (CurrentArchive is null
            || !ConsultationService.AppendSoapContribution(CurrentArchive, contribution))
        {
            return;
        }

        await Message.SuccessAsync("已将复核后的内容加入 SOAP 记录。");
    }

    /// <inheritdoc />
    public void Dispose()
    {
        SystemInfo.StateChanged -= HandleSystemInfoChanged;
        lifetimeCancellation.Cancel();
        lifetimeCancellation.Dispose();
    }
}
