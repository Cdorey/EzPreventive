@using EzNutrition.Application.Consultations
@using EzNutrition.Application.Reports
@using EzNutrition.Shared.Policies
@implements IDisposable
@inject ReportWorkflow Workflow
@inject IJSRuntime JS

<div class="report-actions" @ref="previewOwner">
    <AuthorizeView Policy="@PolicyList.IssueReport">
        <Button Disabled="@(busy || !CanIssue)" OnClick="() => BeginPrepareAsync(true)">签发报告</Button>
        <Button Disabled="@(busy || !CanIssue)" OnClick="ChooseRevisionAsync">更正已签发报告</Button>
    </AuthorizeView>
    <AuthorizeView Policy="@PolicyList.PrintReport">
        <Button Disabled="@(busy || (Kind != ReportKind.Assessment && !CanIssue))" OnClick="() => BeginPrepareAsync(false)">打印当前评估稿</Button>
        @if (lastIssuedId is { } savedId)
        {
            <Button Disabled="@busy" OnClick="() => PrintStoredAsync(savedId)">打印已签发报告</Button>
        }
    </AuthorizeView>
</div>
@if (!visible && feedback is not null)
{
    <p role="status">@feedback</p>
}

@* 两个步骤使用独立的固定尺寸弹窗，配置与预览分别管理各自的布局。 *@
<Modal Title="@(Kind == ReportKind.Energy ? "能量报告设置" : "膳食报告设置")" Visible="@(visible && configuration is not null)" Width="520"
       Footer="@null" MaskClosable="@(!busy)" Closable="@(!busy)" OnCancel="CloseAsync">
    <ChildContent>
        @if (configuration is not null)
        {
            @if (feedback is not null)
            {
                <p role="status">@feedback</p>
            }
            @if (Kind == ReportKind.Energy)
            {
                <EnergyReportOptionsEditor Options="energyOptions" Busy="busy" OnConfirm="ConfirmEnergyConfigurationAsync" OnCancel="CloseAsync" />
            }
            else
            {
                <DietaryReportOptionsEditor Options="dietaryOptions" Busy="busy" OnConfirm="ConfirmConfigurationAsync" OnCancel="CloseAsync" />
            }
        }
    </ChildContent>
</Modal>

<Modal Title="@(revisions is not null ? "选择要更正的报告" : prepared?.Draft.Previous is not null ? "报告更正审核" : prepared?.Draft.Signer is null ? "报告评估稿" : "报告签发审核")"
       Visible="@(visible && configuration is null)" Width="1000" Footer="@null" MaskClosable="@(!busy)" Closable="@(!busy)" OnCancel="CloseAsync">
    <ChildContent>
        @if (feedback is not null)
        {
            <p role="status">@feedback</p>
        }
        @if (busy && previewUrl is null)
        {
            <p role="status">正在本机生成报告…</p>
        }
        @if (revisions is not null)
        {
            @foreach (var candidate in revisions)
            {
                <Button Disabled="@busy" OnClick="() => BeginPrepareAsync(true, candidate.DocumentId)">
                    更正第 @candidate.RevisionNumber 版 · @candidate.FinalizedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") · 报告 @candidate.ReportId
                </Button>
            }
        }
        @if (previewUrl is not null)
        {
            @if (issuedId is null && prepared?.Draft.Signer is not null)
            {
                <p>请核对以下固定快照。确认签发后保存此 PDF 原件，后续修改咨询不会改变它。</p>
                @if (prepared.Draft.Previous is { } previous)
                {
                    <p>本次将以第 @prepared.Draft.Report.Metadata.RevisionNumber.Value 版替代第 @previous.Report.Metadata.RevisionNumber.Value 版。旧版原件保留在报告包中；关闭预览不会改变旧版。</p>
                }
            }
            <iframe class="report-preview" title="报告 PDF 预览" src="@(previewUrl + "#toolbar=0&navpanes=0")"></iframe>
        }
    <div class="report-actions">
        <Button Disabled="@busy" OnClick="CloseAsync">关闭</Button>
        @if (prepared is not null && previewUrl is not null && issuedId is null && prepared.Draft.Signer is not null)
        {
            <AuthorizeView Policy="@PolicyList.IssueReport">
                <Button Type="@ButtonType.Primary" Disabled="@busy" OnClick="IssueAsync">@(prepared.Draft.Previous is null ? "确认审核并签发" : "确认更正并签发")</Button>
            </AuthorizeView>
        }
        <AuthorizeView Policy="@PolicyList.PrintReport">
            @if (issuedId is { } documentId)
            {
                <Button Disabled="@busy" OnClick="() => PrintStoredAsync(documentId)">打印原件</Button>
            }
            else if (prepared is not null && prepared.Draft.Signer is null)
            {
                <Button Disabled="@busy" OnClick="PrintEvaluationAsync">打开打印窗口</Button>
            }
        </AuthorizeView>
    </div>
    </ChildContent>
</Modal>

@code {
    /// <summary>获取本次报告所属的当前咨询。</summary>
    [Parameter, EditorRequired] public ConsultationWorkspace Workspace { get; set; } = null!;

    /// <summary>获取用户选定的量表运行实例。</summary>
    [Parameter] public NutritionAssessmentRun? Assessment { get; set; }

    /// <summary>指定本次报告所属的咨询模块。</summary>
    [Parameter] public ReportKind Kind { get; set; }

    private bool CanIssue => Kind switch
    {
        ReportKind.Dietary => Workspace.DietaryRecallSurvey is { SummaryCalculationTable: not null } survey && survey.RecallEntries.Count > 0,
        ReportKind.Energy => Workspace.CurrentEnergyCalculator is { Energy: > 0 },
        ReportKind.Soap => SoapReportFactory.HasContent(Workspace.SubjectiveObjectiveAssessmentPlanInformation),
        _ => Assessment?.Evaluation.IsComplete == true
    };

    private readonly CancellationTokenSource lifetime = new();
    private ElementReference previewOwner;
    private PreparedReport? prepared;
    private IReadOnlyList<ReportRevisionCandidate>? revisions;
    private string? previewUrl;
    private string? feedback;
    private Guid? issuedId;
    private Guid? lastIssuedId;
    private bool busy;
    private bool visible;
    private DateTimeOffset assessmentModifiedAt;
    private string? patientName;
    private DietaryReportOptions dietaryOptions = new();
    private EnergyReportOptions energyOptions = new();
    private PreparationRequest? configuration;
    private sealed record PreparationRequest(bool ForIssuance, Guid? RevisionId);

    private Task BeginPrepareAsync(bool forIssuance, Guid? revisionId = null) => Kind is ReportKind.Assessment or ReportKind.Soap
        ? PrepareAsync(forIssuance, revisionId)
        : RunAsync(async () =>
        {
            visible = true;
            prepared = null;
            issuedId = null;
            revisions = null;
            await ReleasePreviewAsync();
            configuration = new(forIssuance, revisionId);
        });

    private Task ConfirmConfigurationAsync(DietaryReportOptions options)
    {
        if (busy || configuration is not { } request) return Task.CompletedTask;
        dietaryOptions = options;
        configuration = null;
        return PrepareAsync(request.ForIssuance, request.RevisionId);
    }

    private Task ConfirmEnergyConfigurationAsync(EnergyReportOptions options)
    {
        if (busy || configuration is not { } request) return Task.CompletedTask;
        energyOptions = options;
        configuration = null;
        return PrepareAsync(request.ForIssuance, request.RevisionId);
    }

    private Task ChooseRevisionAsync() => RunAsync(async () =>
    {
        visible = true;
        prepared = null;
        issuedId = null;
        revisions = null;
        configuration = null;
        await ReleasePreviewAsync();
        var listed = Kind switch
        {
            ReportKind.Soap => await Workflow.ListSoapRevisableAsync(Workspace, lifetime.Token),
            ReportKind.Energy => await Workflow.ListEnergyRevisableAsync(Workspace, lifetime.Token),
            ReportKind.Dietary => await Workflow.ListDietaryRevisableAsync(Workspace, lifetime.Token),
            _ => await Workflow.ListRevisableAsync(Workspace, Assessment!, lifetime.Token)
        };
        revisions = listed.Candidates;
        if (revisions.Count == 0) feedback = "当前模块还没有可更正的正式报告。";
        if (listed.UnreadableCount > 0)
            feedback = $"已跳过 {listed.UnreadableCount} 份损坏、缺失或无法读取的报告。"
                + (revisions.Count == 0 ? "其余报告中没有当前模块可更正的正式报告。" : "其余可用报告仍可选择更正。");
    });

    private Task PrepareAsync(bool forIssuance, Guid? revisionId = null) => RunAsync(async () =>
    {
        visible = true;
        prepared = null;
        revisions = null;
        issuedId = null;
        await ReleasePreviewAsync();
        assessmentModifiedAt = Assessment?.LastModifiedAt ?? default;
        patientName = Workspace.Client.Name;
        var pending = Kind switch
        {
            ReportKind.Soap => await Workflow.PrepareSoapAsync(Workspace, forIssuance, revisionId, lifetime.Token),
            ReportKind.Energy => await Workflow.PrepareEnergyAsync(Workspace, forIssuance, revisionId, energyOptions, lifetime.Token),
            ReportKind.Dietary => await Workflow.PrepareDietaryAsync(Workspace, forIssuance, revisionId, dietaryOptions, lifetime.Token),
            _ => revisionId is { } id
                ? await Workflow.PrepareRevisionAsync(Workspace, Assessment!, id, lifetime.Token)
                : await Workflow.PrepareAsync(Workspace, Assessment!, forIssuance, lifetime.Token)
        };
        await using (var module = await JS.InvokeAsync<IJSObjectReference>("import", lifetime.Token,
            "./_content/EzNutrition.Presentation/reports/assessment-report.mjs"))
        {
            previewUrl = await module.InvokeAsync<string>("createPreview", lifetime.Token, pending.Pdf.ToArray(), previewOwner);
        }
        if (string.IsNullOrWhiteSpace(previewUrl))
        {
            previewUrl = null;
            throw new InvalidOperationException("PDF 预览未能打开，请重新生成并审核报告。");
        }
        // 预览创建完成后才开放确认，生成或 JS 调用失败不能留下待签发成品。
        lifetime.Token.ThrowIfCancellationRequested();
        prepared = pending;
    });

    private Task IssueAsync() => RunAsync(async () =>
    {
        if (prepared is null || previewUrl is null || issuedId is not null) return;
        if (Workspace.Client.Name != patientName || (Kind == ReportKind.Assessment
            && (Assessment is null || !Workspace.NutritionAssessments.Contains(Assessment) || Assessment.LastModifiedAt != assessmentModifiedAt)))
            throw new InvalidOperationException("报告输入或患者身份已变化，请关闭预览后重新准备报告。");
        issuedId = await Workflow.IssueAsync(prepared, lifetime.Token);
        lastIssuedId = issuedId;
        feedback = "报告已签发并保存到本机档案库。";
    });

    private Task PrintStoredAsync(Guid id) => RunAsync(async () =>
    {
        await Workflow.PrintStoredAsync(id, lifetime.Token);
        feedback = "已打开报告打印窗口，请在查看器中选择打印机。";
    });

    private Task PrintEvaluationAsync() => RunAsync(async () =>
    {
        if (prepared is null) return;
        await Workflow.PrintEvaluationAsync(prepared, lifetime.Token);
        feedback = "已打开带水印评估稿的打印窗口。";
    });

    private async Task RunAsync(Func<Task> operation)
    {
        if (busy) return;
        busy = true;
        feedback = null;
        try { await operation(); }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception exception) when (exception is InvalidOperationException or UnauthorizedAccessException
            or InvalidDataException or NotSupportedException)
        { feedback = exception.Message; }
        catch (JSException) { feedback = "PDF 生成或查看器打开失败，请检查资源是否加载完整，并允许本站打开报告窗口后重试。"; }
        catch (IOException) { feedback = "本机报告文件操作失败，请重试。"; }
        finally { busy = false; }
    }

    private async Task CloseAsync()
    {
        if (busy) return;
        visible = false;
        prepared = null;
        revisions = null;
        configuration = null;
        await ReleasePreviewAsync();
    }

    private async ValueTask ReleasePreviewAsync()
    {
        if (previewUrl is not null)
        {
            var previousUrl = previewUrl;
            previewUrl = null;
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", lifetime.Token,
                "./_content/EzNutrition.Presentation/reports/assessment-report.mjs");
            await module.InvokeVoidAsync("releasePreview", lifetime.Token, previousUrl);
        }
    }

    /// <inheritdoc />
    public void Dispose()
    {
        lifetime.Cancel();
        // DOM 移除时由 JS 观察器回收 Blob；WebView 关闭阶段不能再等待 JS 调用。
        lifetime.Dispose();
    }
}
