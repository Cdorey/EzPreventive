.medical-information {
    min-width: 0;
}

.component-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 6px;
}

.component-heading span {
    color: var(--ez-primary-strong);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
}

.component-heading h3 {
    margin: 2px 0 0;
    color: var(--ez-navy);
    font-size: 1.08rem;
}

.component-heading ::deep .anticon {
    color: var(--ez-primary);
    font-size: 1.25rem;
}

.medical-information > ::deep p {
    color: var(--ez-text-secondary);
}
