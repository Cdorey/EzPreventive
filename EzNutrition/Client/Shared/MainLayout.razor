@using EzNutrition.Client.Services;
@inherits LayoutComponentBase
@inject UserSessionService UserSession

<Layout Style="min-height: 100vh; " >
    <Sider Breakpoint="BreakpointType.Md" CollapsedWidth="0">
        <Layout>
            <Header Style="color:white">
                EzNutrition
            </Header>
            <Content>
                <NavMenu />
            </Content>
        </Layout>
    </Sider>
    <Layout>
        <Content>
            <div class="site-layout-content" @ontouchstart="DetectTouch">
                @Body
            </div>
            @* <BackTop/> *@
        </Content>
        <Footer Style="text-align: center;">
            @if (!string.IsNullOrEmpty(@UserSession.CaseNumber))
            {
                <p><a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">@UserSession.CaseNumber</a></p>
            }
        </Footer>
    </Layout>
</Layout>
<style>
    .site-layout-content {
        background: #fff;
        padding: 24px;
        min-height: 100%;
        margin: 16px;
        overflow: auto;
    }
</style>

@code {
    private void DetectTouch(TouchEventArgs e)
    {
        if (!UserSession.IsTouchDetected)
        {
            UserSession.IsTouchDetected = true;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await UserSession.GetSystemInfoAsync();
    }
}
