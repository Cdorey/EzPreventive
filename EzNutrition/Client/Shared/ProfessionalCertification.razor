@using EzNutrition.Shared.Data.DTO
@using Microsoft.AspNetCore.Components.Forms

<section class="certification-component">
    <Form Model="@ProfessionalIdentityDto" ValidateOnChange Layout="FormLayout.Vertical">
        <GridRow Gutter="(16,0)">
            <GridCol Xs="24">
                <FormItem Label="认证类型">
                    <RadioGroup @bind-Value="ProfessionalIdentityDto.IdentityType">
                        <Radio RadioButton Value="@("Physician")">医师</Radio>
                        <Radio RadioButton Value="@("Nutritionist")">营养技师</Radio>
                        <Radio RadioButton Value="@("RD")">注册营养师</Radio>
                        <Radio RadioButton Value="@("Teacher")">高校教师</Radio>
                        <Radio RadioButton Value="@("Student")">高校学生</Radio>
                    </RadioGroup>
                </FormItem>
            </GridCol>
            <GridCol Xs="24" Lg="12">
                <FormItem Label="所属机构名称">
                    <Input Placeholder="请输入当前执业、任教或就读机构" @bind-Value="ProfessionalIdentityDto.InstitutionName" />
                </FormItem>
            </GridCol>
        </GridRow>
    </Form>

    <Collapse Class="certification-guidance">
        <Panel Header="查看专业资质认证范围与数据处理说明" Key="certification-guidance">
            <div class="guidance-content">
                <Title Level="4">关于专业资质认证</Title>
                <Paragraph>为避免 EzNutrition 接口被滥用，部分功能需认证营养专业资质后方可使用。</Paragraph>
                <Paragraph>营养及营养相关专业的界定与中国营养学会（注册营养师）的相关定义一致：</Paragraph>
                <ul>
                    <li>营养专业本科学历是指：食品卫生与营养学、预防医学；</li>
                    <li>营养相关专业本科学历是指：基础医学、临床医学、中医学、中西医临床医学、药学、临床药学、中药学、护理学、食品质量与安全、食品科学与工程、食品营养与检验教育、烹饪与营养教育、食品营养与健康；</li>
                    <li>营养专业专科学历是指：医学营养、食品营养与健康、预防医学；</li>
                    <li>营养相关专业专科学历是指：临床医学、护理、药学、中医学、中药学、营养配餐、食品检验检测技术、烹调工艺与营养、保健食品质量与管理、健康管理中医养生保健、老年保健与管理；</li>
                </ul>
                <Paragraph>计划限制的功能包括：</Paragraph>
                <ul>
                    <li>（已实装）基于 DeepSeek API 辅助拟定健康教育和膳食指导方案的草稿；</li>
                    <li>（开发中）报告单在线生成和打印。</li>
                </ul>
                <Paragraph>
                    EzNutrition 不会永久保存您上传的认证材料照片。审核完成后，无论审核结果如何，上传照片均将被删除；系统仅保留与专业资质认证相关的必要摘要信息。相关行为可通过审查 EzNutrition.Server 的
                    <a href="https://github.com/Cdorey/EzPreventive/tree/master/EzNutrition/Server/Controllers" target="_blank" rel="noopener noreferrer">Admin 和 Auth 控制器源代码</a>
                    确认。
                </Paragraph>

                <Title Level="4">公共卫生医师和高校教师补充说明</Title>
                <Paragraph>
                    考虑到公共卫生医师通常以团队形式在社区开展工作，而团队中部分成员可能不具备营养或营养相关专业背景，但社区公共卫生服务与营养干预工具密切相关；同时，由于高校教师需要满足教学和专业指导的要求，我们计划为上述用户群体开发额外的“创建工作组”功能。该功能将允许您生成邀请链接，自主邀请其他 EzNutrition 用户加入您的工作组。在工作组中，无论受邀者是否具有独立的专业资质认证，他们均可调用受限接口，但您需对其行为进行监督，并可随时撤销其工作组内的访问权限。如果受邀者本身具备专业认证，退出工作组将不会影响其原本的认证状态。
                </Paragraph>
                <Alert Type="AlertType.Warning" Message="请勿邀请患者加入专业工作组。" ShowIcon="true" />
            </div>
        </Panel>
    </Collapse>

    <section class="upload-section" aria-labelledby="certificate-upload-title">
        <div class="upload-heading">
            <div>
                <h3 id="certificate-upload-title">上传资格证明</h3>
                <p>支持 JPG、JPEG 或 PNG 图片。请仅提交审核所需页面。</p>
            </div>
            <Icon Type="file-protect" Theme="IconThemeType.Outline" />
        </div>

        <div class="required-document">
            @switch (ProfessionalIdentityDto.IdentityType)
            {
                case "Physician":
                    <Paragraph>需要：医师执业证书（请勿上传资格证书）。</Paragraph>
                    break;
                case "Nutritionist":
                    <Paragraph>需要：由卫生健康委和人社部联合颁发的卫生专业技术资格（营养）证书；不包括社会机构颁发的公共营养师证书。</Paragraph>
                    break;
                case "RD":
                    <Paragraph>需要：注册营养师证书，纸质或卡片版本任选其一。</Paragraph>
                    break;
                case "Teacher":
                    <Paragraph>需要：教师资格证书（请勿上传学历证书）或高校聘书。</Paragraph>
                    break;
                case "Student":
                    <Paragraph>需要：能体现预计毕业日期的学生证，或学信网学籍在线验证报告；已毕业用户请勿选择学生认证。</Paragraph>
                    break;
                default:
                    <Paragraph>请先选择认证类型，系统会在这里提示需要提交的材料。</Paragraph>
                    break;
            }
        </div>

        <InputFile id="fileInput" OnChange="OnFileSelected" hidden accept="image/jpeg,image/png,.jpg,.jpeg,.png" />
        <Upload Name="files">
            <label class="ant-btn upload-button" for="fileInput">
                <Icon Type="upload" />选择资格证明图片
            </label>
        </Upload>
        @if (Filename != string.Empty)
        {
            <div class="selected-file" role="status">
                <Icon Type="check-circle" Theme="IconThemeType.Outline" />
                <span>已选择：@Filename</span>
            </div>
        }
    </section>
</section>

@code {
    [Parameter, EditorRequired]
    public ProfessionalIdentityDto ProfessionalIdentityDto { get; set; } = default!;

    [Parameter, EditorRequired]
    public EventCallback<InputFileChangeEventArgs> OnFileSelected { get; set; }

    [Parameter, EditorRequired]
    public string Filename { get; set; } = string.Empty;
}
