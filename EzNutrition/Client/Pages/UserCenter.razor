@using EzNutrition.Client.Models;
@using EzNutrition.Client.Services;
@using EzNutrition.Shared.Data.DTO;
@using System.ComponentModel.DataAnnotations
@attribute [Authorize]
@implements IDisposable
@inject IHttpClientFactory HttpClientFactory
@inject IMessageService Message
@inject CertificateUploadService CertificateUpload
@inject ILogger<UserCenter> Logger
@page "/usercenter"
<Title Level="1">用户中心</Title>
<AuthorizeView>
    <Authorized>
        @if (UserInfo is not null)
        {
            <GridRow Gutter="(16,16)">
                <GridCol Xs="24" Lg="12">
                    <Descriptions Title="@UserInfo.UserName" Bordered Column="2">
                        <DescriptionsItem Title="邮箱">@UserInfo.Email</DescriptionsItem>
                        <DescriptionsItem Title="手机号码">@UserInfo.PhoneNumber</DescriptionsItem>
                        <DescriptionsItem Title="UID">@UserInfo.UserId</DescriptionsItem>
                        <DescriptionsItem Title="有效角色">
                            @foreach (var role in UserInfo.Roles)
                            {
                                @role <br />
                            }
                        </DescriptionsItem>
                    </Descriptions>
                    @* <Button OnClick="GetProfile">刷新</Button> *@
                </GridCol>
                @if (UserInfo.Claims.Count > 0)
                {
                    <GridCol Xs="24" Lg="12">
                        <Descriptions Title="认证声明" Bordered Column="2">
                            @foreach (var claim in UserInfo.Claims)
                            {
                                <DescriptionsItem Title="@($"有效声明（{claim.Type}）")">@claim.Value</DescriptionsItem>
                            }
                        </Descriptions>
                    </GridCol>
                }
                <GridCol Xs="24">
                    <Table DataSource="ProfessionalCertificationRequestDtos">
                        <TitleTemplate>
                            <Flex Justify="FlexJustify.SpaceBetween" Gap="@("10")">
                                <Title Level="3">专业资质认证申请记录</Title>
                                <Button Type="ButtonType.Primary" OnClick="@(()=> createCertificationRequestDialog = true)">提交新的申请</Button>
                            </Flex>
                        </TitleTemplate>
                        <ChildContent Context="requests">
                            <PropertyColumn Property="r=>r.RequestTime" Title="申请时间" />
                            <PropertyColumn Property="r=>r.IdentityType" Title="申请类别" />
                            <PropertyColumn Property="r=>r.ProcessedTime" Title="审核时间" />
                            <PropertyColumn Property="r=>r.ProcessDetails" Title="审核备注" />
                            <PropertyColumn Property="r=>r.Remarks" Title="认证备注" />
                            <PropertyColumn Property="r=>r.Status" Title="审核结果">
                                <EnumSelect TEnum="RequestStatus" Value="@requests.Status" Disabled />
                            </PropertyColumn>
                        </ChildContent>
                    </Table>
                </GridCol>
            </GridRow>
            <Modal Title="专业资质认证申请" @bind-Visible="@createCertificationRequestDialog" Width="1280" OnCancel="InitCertificationRequestDialog" OnOk="SubmitCertificationRequest" ConfirmLoading="@certificationRequestSending">
                <ProfessionalCertification ProfessionalIdentityDto="@professionalIdentityDto" OnFileSelected="HandleFileSelected" Filename="@(currentSelectedFile?.Name??string.Empty)" />
            </Modal>
        }
    </Authorized>
    <NotAuthorized>
        <Paragraph>尚未登录</Paragraph>
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool createCertificationRequestDialog = false;
    private UserInfoDto? UserInfo { get; set; }
    private List<ProfessionalCertificationRequestDto> ProfessionalCertificationRequestDtos { get; set; } = [];

    private ProfessionalIdentityDto professionalIdentityDto { get; set; } = new ProfessionalIdentityDto { IdentityType = string.Empty, InstitutionName = string.Empty };
    private IBrowserFile? currentSelectedFile;
    private bool certificationRequestSending = false;
    private readonly CancellationTokenSource lifetimeCancellation = new();
    private string? pendingUploadTicket;

    private async Task SubmitCertificationRequest()
    {
        if (certificationRequestSending)
        {
            return;
        }

        certificationRequestSending = true;
        try
        {
            if (!TryValidate(professionalIdentityDto, out var validationMessage))
            {
                await Message.Error(validationMessage);
                return;
            }

            if (currentSelectedFile is null)
            {
                await Message.Error("请选择要上传的证明图片。");
                return;
            }

            await Message.Info("正在提交认证信息");
            if (pendingUploadTicket is null)
            {
                var httpClient = HttpClientFactory.CreateClient("Authorize");
                using var response = await httpClient.PostAsJsonAsync(
                    "User/CreateProfessionalIdentity",
                    professionalIdentityDto,
                    lifetimeCancellation.Token);
                if (!response.IsSuccessStatusCode)
                {
                    await Message.Error("认证信息提交失败，请检查填写内容后重试。");
                    return;
                }

                var result = await response.Content.ReadFromJsonAsync<RegistrationResultDto>(
                    lifetimeCancellation.Token);
                if (result?.Success is not true)
                {
                    await Message.Error(result?.Message ?? "认证信息提交失败。");
                    return;
                }

                if (string.IsNullOrWhiteSpace(result.UploadTicket))
                {
                    throw new InvalidOperationException("服务器没有返回有效的证明图片上传票据。");
                }

                pendingUploadTicket = result.UploadTicket;
            }

            await CertificateUpload.UploadAsync(
                pendingUploadTicket,
                currentSelectedFile,
                lifetimeCancellation.Token);
            pendingUploadTicket = null;
            await Message.Success("认证信息提交成功");
            InitCertificationRequestDialog();
            await TryRefreshProfessionalIdentitiesAsync();
        }
        catch (OperationCanceledException) when (lifetimeCancellation.IsCancellationRequested)
        {
        }
        catch (Exception ex) when (ex is InvalidOperationException or HttpRequestException or IOException or NotSupportedException or System.Text.Json.JsonException)
        {
            Logger.LogWarning(ex, "Professional certification submission failed.");
            await Message.Error(
                pendingUploadTicket is not null
                    ? "申请记录已创建，但图片上传失败；请保留当前窗口并再次点击提交重试上传。"
                    : ex is InvalidOperationException
                    ? ex.Message
                    : "认证信息或证明图片提交失败，请稍后重试。");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected professional certification submission error.");
            await Message.Error("认证信息提交过程中发生异常，请稍后重试。");
        }
        finally
        {
            certificationRequestSending = false;
        }
    }

    private void InitCertificationRequestDialog()
    {
        professionalIdentityDto = new ProfessionalIdentityDto { IdentityType = string.Empty, InstitutionName = string.Empty };
        currentSelectedFile = null;
        pendingUploadTicket = null;
        certificationRequestSending = false;
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        currentSelectedFile = e.File;
    }

    private async Task GetProfile()
    {
        var httpClient = HttpClientFactory.CreateClient("Authorize");
        UserInfo = await httpClient.GetFromJsonAsync<UserInfoDto>(
            "User/Profile",
            lifetimeCancellation.Token);
    }

    private async Task GetProfessionalIdentities()
    {
        ProfessionalCertificationRequestDtos.Clear();
        var httpClient = HttpClientFactory.CreateClient("Authorize");
        try
        {
            var x = await httpClient.GetFromJsonAsync<List<ProfessionalCertificationRequestDto>>(
                "User/ProfessionalIdentity",
                lifetimeCancellation.Token);
            if (x?.Count > 0)
            {
                ProfessionalCertificationRequestDtos.AddRange(x);
            }
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            return;
        }
    }

    private async Task TryRefreshProfessionalIdentitiesAsync()
    {
        try
        {
            await GetProfessionalIdentities();
        }
        catch (OperationCanceledException) when (lifetimeCancellation.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Unable to refresh professional certification requests.");
            await Message.Warning("认证信息已提交，但列表刷新失败；请重新打开用户中心确认结果。");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await GetProfile();
            await GetProfessionalIdentities();
        }
        catch (OperationCanceledException) when (lifetimeCancellation.IsCancellationRequested)
        {
        }
        catch (Exception ex) when (ex is HttpRequestException or NotSupportedException or System.Text.Json.JsonException)
        {
            Logger.LogWarning(ex, "Unable to initialize the user center.");
            await Message.Error("用户信息加载失败，请稍后重试。");
        }
    }

    private static bool TryValidate(object value, out string validationMessage)
    {
        var validationResults = new List<ValidationResult>();
        var isValid = Validator.TryValidateObject(
            value,
            new ValidationContext(value),
            validationResults,
            validateAllProperties: true);
        validationMessage = string.Join("；", validationResults.Select(result => result.ErrorMessage));
        return isValid;
    }

    public void Dispose()
    {
        lifetimeCancellation.Cancel();
        lifetimeCancellation.Dispose();
    }
}
