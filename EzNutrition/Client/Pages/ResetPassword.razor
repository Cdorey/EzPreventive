@page "/account/reset-password"
@using EzNutrition.Client.Services
@using EzNutrition.Shared.Data.DTO
@implements IDisposable
@inject AccountService Account
@inject UserSessionService UserSession
@inject NavigationManager Navigator
@inject IJSRuntime JS
@inject ILogger<ResetPassword> Logger
<PageTitle>重置密码</PageTitle>

<AccountActionCard Title="设置新密码"
                   Description="重置链接有效期为三小时；完成后，其他设备上的旧登录凭据也会失效。"
                   IconType="lock">
    @if (completed)
    {
        <Result Status="ResultStatus.Success"
                Title="密码已重置"
                SubTitle="@resultMessage">
            <Extra>
                <Button Type="ButtonType.Primary" OnClick="GoHome">返回登录</Button>
            </Extra>
        </Result>
    }
    else if (!HasValidLink)
    {
        <Result Status="ResultStatus.Error"
                Title="重置链接不完整"
                SubTitle="请使用重置邮件中的完整链接，或重新申请密码重置。">
            <Extra>
                <Button Type="ButtonType.Primary" OnClick="RequestAgain">重新申请</Button>
                <Button OnClick="GoHome">返回登录</Button>
            </Extra>
        </Result>
    }
    else
    {
        <Form Model="@model" Layout="FormLayout.Vertical">
            <ChildContent Context="formContext">
                <FormItem Label="新密码">
                    <InputPassword Placeholder="至少 6 个字符" @bind-Value="@formContext.NewPassword" />
                </FormItem>
                <FormItem Label="确认新密码">
                    <InputPassword Placeholder="再次输入新密码" @bind-Value="@formContext.ConfirmPassword" />
                </FormItem>
                @if (errorMessage is not null)
                {
                    <Alert Message="@errorMessage" Type="AlertType.Error" ShowIcon="true" />
                }
                <FormItem>
                    <div class="action-buttons">
                        <Button Type="ButtonType.Primary" OnClick="SubmitAsync" AutoLoading>重置密码</Button>
                        <Button OnClick="GoHome">取消</Button>
                    </div>
                </FormItem>
            </ChildContent>
        </Form>
    }
</AccountActionCard>

@code {
    [Parameter, SupplyParameterFromQuery(Name = "userId")]
    public string? UserId { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private readonly ResetPasswordDto model = new();
    private readonly CancellationTokenSource lifetimeCancellation = new();
    private bool completed;
    private bool linkCaptured;
    private bool scrubQueryOnNextRender;
    private string? errorMessage;
    private string resultMessage = string.Empty;
    private bool HasValidLink =>
        !string.IsNullOrWhiteSpace(model.UserId) && !string.IsNullOrWhiteSpace(model.Token);

    protected override void OnParametersSet()
    {
        if (linkCaptured)
        {
            return;
        }

        linkCaptured = true;
        model.UserId = UserId ?? string.Empty;
        model.Token = Token ?? string.Empty;
        if (HasValidLink)
        {
            scrubQueryOnNextRender = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!scrubQueryOnNextRender)
        {
            return;
        }

        scrubQueryOnNextRender = false;
        try
        {
            await JS.InvokeVoidAsync("ezNutrition.scrubCurrentQuery");
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Unable to remove the password reset token from the address bar.");
        }
    }

    private async Task SubmitAsync()
    {
        errorMessage = null;
        if (!AccountFormValidation.TryValidate(model, out var validationMessage))
        {
            errorMessage = validationMessage;
            return;
        }

        try
        {
            var result = await Account.ResetPasswordAsync(model, lifetimeCancellation.Token);
            await UserSession.SignOutAsync();
            resultMessage = result.Message;
            completed = true;
        }
        catch (OperationCanceledException) when (lifetimeCancellation.IsCancellationRequested)
        {
        }
        catch (Exception ex) when (ex is InvalidOperationException or HttpRequestException)
        {
            Logger.LogWarning(ex, "Password reset failed in the browser.");
            errorMessage = ex.Message;
        }
    }

    private void RequestAgain() => Navigator.NavigateTo("account/forgot-password");

    private void GoHome() => Navigator.NavigateTo("");

    public void Dispose()
    {
        lifetimeCancellation.Cancel();
        lifetimeCancellation.Dispose();
    }
}
