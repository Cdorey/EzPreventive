@page "/register"
@using EzNutrition.Shared.Data.DTO
@using EzNutrition.Shared.Policies
@using EzNutrition.Client.Services
@using System.ComponentModel.DataAnnotations
@implements IDisposable
@inject IHttpClientFactory HttpClientFactory
@inject IMessageService Message
@inject UserSessionService UserSession
@inject NavigationManager Navigator
@inject CertificateUploadService CertificateUpload
@inject ILogger<Register> Logger
<PageTitle>注册</PageTitle>

<section class="registration-page">
    <header class="registration-heading">
        <span>账户与资质</span>
        <h1>创建 EzNutrition 账户</h1>
        <p>账户信息用于登录；专业资质认证用于控制受限的专业功能访问。</p>
    </header>

    @if (finished)
    {
        <div class="registration-card result-card">
            <Result Status="ResultStatus.Success"
                    Title="信息提交成功"
                    SubTitle="一封确认邮件已发送到您的邮箱，请尽快激活您的账号。">
                <Extra>
                    <Button Type="ButtonType.Primary" OnClick="Login">登录</Button>
                </Extra>
            </Result>
        </div>
    }
    else
    {
        <Spin Spinning="@loading">
            <Indicator>
                <Icon Type="@IconType.Outline.Loading" Style="font-size: 72px" Spin />
            </Indicator>
            <ChildContent>
                <div class="registration-card">
                    <div class="section-heading">
                        <div class="step-index">1</div>
                        <div>
                            <h2>基本信息</h2>
                            <p>请填写可用于接收账户确认信息的邮箱。</p>
                        </div>
                    </div>

                    @if (friendlyRegistError is not null)
                    {
                        <Alert Class="registration-error" Message="@friendlyRegistError" Type="AlertType.Error" Closable AfterClose="@(()=>friendlyRegistError=null)" ShowIcon="true" />
                    }

                    <Form Model="@registrationDto" ValidateOnChange Layout="FormLayout.Vertical">
                        <GridRow Gutter="(16,0)">
                            <GridCol Xs="24" Md="12">
                                <FormItem Label="用户名">
                                    <Input Placeholder="请输入用户名" @bind-Value="@context.UserName" />
                                </FormItem>
                            </GridCol>
                            <GridCol Xs="24" Md="12">
                                <FormItem Label="密码">
                                    <InputPassword Placeholder="请输入密码" @bind-Value="@context.Password" />
                                </FormItem>
                            </GridCol>
                            <GridCol Xs="24" Md="12">
                                <FormItem Label="电子邮箱">
                                    <Input Placeholder="name@example.com" @bind-Value="@context.Email" />
                                </FormItem>
                            </GridCol>
                            <GridCol Xs="24" Md="12">
                                <FormItem Label="手机号码（选填）">
                                    <Input Placeholder="用于必要的账户联系" @bind-Value="@context.PhoneNumber" />
                                </FormItem>
                            </GridCol>
                        </GridRow>
                    </Form>

                    <Divider />

                    <div class="section-heading certification-heading">
                        <div class="step-index">2</div>
                        <div>
                            <h2>专业认证</h2>
                            <p>可以暂时跳过，注册后仍可在用户中心提交申请。</p>
                        </div>
                        <Switch @bind-Value="professionalIdentity" CheckedChildren="本次认证" UnCheckedChildren="暂时跳过" />
                    </div>

                    @if (professionalIdentity)
                    {
                        <ProfessionalCertification ProfessionalIdentityDto="@professionalIdentityDto" OnFileSelected="HandleFileSelected" Filename="@(currentSelectedFile?.Name??string.Empty)" />
                    }

                    <div class="registration-actions">
                        <Button Type="@ButtonType.Primary" OnClick="RegistAsync">提交注册信息</Button>
                        <span>提交即表示您确认所填信息真实有效。</span>
                    </div>
                </div>
            </ChildContent>
        </Spin>
    }
</section>

@code {
    string identityType = string.Empty;
    string? friendlyRegistError = null;

    bool loading = false;
    bool finished = false;

    bool professionalIdentity = true;
    IBrowserFile? currentSelectedFile;

    private readonly CancellationTokenSource lifetimeCancellation = new();
    private bool registrationCreated;
    private bool certificateUploadRequired;
    private string? pendingUploadTicket;

    private readonly RegistrationDto registrationDto = new RegistrationDto { Email = string.Empty, Password = string.Empty, UserName = string.Empty };

    private readonly ProfessionalIdentityDto professionalIdentityDto = new ProfessionalIdentityDto { IdentityType = string.Empty, InstitutionName = string.Empty };

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        currentSelectedFile = e.File;
    }

    private async Task RegistAsync()
    {
        if (loading)
        {
            return;
        }

        friendlyRegistError = null;
        loading = true;
        try
        {
            if (!registrationCreated)
            {
                if (!TryValidate(registrationDto, out var validationMessage))
                {
                    await ShowErrorAsync(validationMessage);
                    return;
                }

                if (professionalIdentity)
                {
                    if (!TryValidate(professionalIdentityDto, out validationMessage))
                    {
                        await ShowErrorAsync(validationMessage);
                        return;
                    }

                    if (currentSelectedFile is null)
                    {
                        await ShowErrorAsync("请选择要上传的证明图片。");
                        return;
                    }

                    registrationDto.ProfessionalIdentity = professionalIdentityDto;
                }
                else
                {
                    registrationDto.ProfessionalIdentity = null;
                }

                await Message.InfoAsync("正在提交注册信息");
                var httpClient = HttpClientFactory.CreateClient("Anonymous");
                using var response = await httpClient.PostAsJsonAsync(
                    "Auth/Register",
                    registrationDto,
                    lifetimeCancellation.Token);
                if (!response.IsSuccessStatusCode)
                {
                    await ShowErrorAsync("提交注册信息失败，请检查填写内容后重试。");
                    return;
                }

                var result = await response.Content.ReadFromJsonAsync<RegistrationResultDto>(
                    lifetimeCancellation.Token);
                if (result?.Success is not true)
                {
                    await ShowErrorAsync(result?.Message ?? "注册失败。");
                    return;
                }

                registrationCreated = true;
                certificateUploadRequired = professionalIdentity;
                pendingUploadTicket = result.UploadTicket;
            }

            if (certificateUploadRequired)
            {
                if (string.IsNullOrWhiteSpace(pendingUploadTicket))
                {
                    throw new InvalidOperationException("账号已注册，但服务器没有返回有效的证明图片上传票据。");
                }

                if (currentSelectedFile is null)
                {
                    await ShowErrorAsync("请选择要上传的证明图片。");
                    return;
                }

                await CertificateUpload.UploadAsync(
                    pendingUploadTicket,
                    currentSelectedFile,
                    lifetimeCancellation.Token);
                pendingUploadTicket = null;
            }

            finished = true;
            await Message.SuccessAsync("注册成功");
        }
        catch (OperationCanceledException) when (lifetimeCancellation.IsCancellationRequested)
        {
        }
        catch (Exception ex) when (ex is InvalidOperationException or HttpRequestException or IOException or NotSupportedException or System.Text.Json.JsonException)
        {
            Logger.LogWarning(ex, "Registration request failed in the browser client.");
            var message = registrationCreated
                ? pendingUploadTicket is not null
                    ? "账号已注册，但证明图片上传失败；请保留当前页面并再次点击注册重试上传。"
                    : "账号已注册，但无法上传证明图片；请激活并登录账号后在用户中心重新提交认证。"
                : ex is InvalidOperationException ? ex.Message : "注册请求失败，请稍后重试。";
            await ShowErrorAsync(message);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected registration error in the browser client.");
            await ShowErrorAsync("注册过程中发生异常，请稍后重试。");
        }
        finally
        {
            loading = false;
        }
    }

    private async Task Login()
    {
        try
        {
            await UserSession.SignInAsync(
                registrationDto.UserName,
                registrationDto.Password,
                lifetimeCancellation.Token);
            Navigator.NavigateTo("");
        }
        catch (OperationCanceledException) when (lifetimeCancellation.IsCancellationRequested)
        {
        }
        catch (Exception ex) when (ex is InvalidOperationException or HttpRequestException)
        {
            await Message.ErrorAsync(ex.Message);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error while signing in after registration.");
            await Message.ErrorAsync("登录时发生异常，请稍后重试。");
        }
    }

    private static bool TryValidate(object value, out string validationMessage)
    {
        var validationResults = new List<ValidationResult>();
        var isValid = Validator.TryValidateObject(
            value,
            new ValidationContext(value),
            validationResults,
            validateAllProperties: true);
        validationMessage = string.Join("；", validationResults.Select(result => result.ErrorMessage));
        return isValid;
    }

    private async Task ShowErrorAsync(string message)
    {
        friendlyRegistError = message;
        await Message.ErrorAsync(message);
    }

    public void Dispose()
    {
        lifetimeCancellation.Cancel();
        lifetimeCancellation.Dispose();
    }
}
