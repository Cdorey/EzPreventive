@page "/maintreatment/{id?}"
@using EzNutrition.Application.Consultations
@using EzNutrition.Client.Services
@using EzNutrition.Domain.Calculations
@using EzNutrition.Shared.Data.Entities
@attribute [Authorize]
@implements IDisposable
@inject UserSessionService UserSession
@inject NavigationManager Navigation
@inject ConsultationWorkspaceManager WorkspaceManager

<PageTitle>营养咨询</PageTitle>

@if (CurrentArchive is not null)
{
    <section class="treatment-page">
        <header class="page-heading treatment-heading">
            <div>
                <span>门诊咨询</span>
                <h1>@PageHeading</h1>
                <p>@PageDescription</p>
            </div>
            @if (!CurrentArchive.ClientInfoFormEnabled)
            {
                <ArchiveActions Workspace="CurrentArchive" />
            }
        </header>

        @if (CurrentArchive.ClientInfoFormEnabled)
        {
            <div class="setup-grid">
                <section class="surface-card patient-form-card" aria-labelledby="patient-info-title">
                    <div class="section-heading">
                        <div>
                            <span>步骤 1</span>
                            <h2 id="patient-info-title">基本信息</h2>
                        </div>
                        <Icon Type="idcard" Theme="IconThemeType.Outline" />
                    </div>

                    @if (CurrentArchive.IsFollowUp)
                    {
                        <Alert Class="follow-up-notice"
                               Type="AlertType.Info"
                               Message="已沿用既有患者身份"
                               Description="姓名沿用既有档案；其余信息已根据上一次咨询预填，请按本次实际情况核对并更新。"
                               ShowIcon="true" />
                    }

                    <Spin Spinning="CurrentArchive.IsLoading">
                        <Form Model="@CurrentArchive.Client" Layout="FormLayout.Vertical">
                            <GridRow Gutter="(16,0)">
                                <GridCol Xs="24">
                                    <FormItem Label="姓名（选填）">
                                        <Input Placeholder="仅用于区分当前浏览器中的咨询对象，服务器不保存"
                                               id="name"
                                               Disabled="@CurrentArchive.IsFollowUp"
                                               @bind-Value="context.Name" />
                                    </FormItem>
                                </GridCol>
                                <GridCol Xs="24">
                                    <FormItem Label="性别">
                                        <RadioGroup TValue="string" id="gender" @bind-Value="context.Gender">
                                            <Radio RadioButton Value="@("男")">男</Radio>
                                            <Radio RadioButton Value="@("女")">女</Radio>
                                        </RadioGroup>
                                    </FormItem>
                                </GridCol>
                                <GridCol Xs="24">
                                    <AgeEntry Client="context" Inline />
                                </GridCol>
                                <GridCol Xs="24" Sm="12">
                                    <FormItem Label="身高（cm）">
                                        <Input @bind-Value="context.Height" type="InputType.Number" min="0" />
                                    </FormItem>
                                </GridCol>
                                <GridCol Xs="24" Sm="12">
                                    <FormItem Label="体重（kg）">
                                        <Input @bind-Value="context.Weight" type="InputType.Number" min="0" />
                                    </FormItem>
                                </GridCol>
                                <GridCol Xs="24">
                                    <FormItem Label="特殊生理状况">
                                        <RadioGroup TValue="string" id="specialPhysiologicalPeriod" @bind-Value="context.SpecialPhysiologicalPeriod">
                                            <Radio RadioButton Value="@string.Empty">无</Radio>
                                            <Radio RadioButton Value="@("孕早期")">孕早期</Radio>
                                            <Radio RadioButton Value="@("孕中期")">孕中期</Radio>
                                            <Radio RadioButton Value="@("孕晚期")">孕晚期</Radio>
                                            <Radio RadioButton Value="@("乳母")">乳母</Radio>
                                            <Radio RadioButton Value="@("已绝经")">已绝经</Radio>
                                        </RadioGroup>
                                    </FormItem>
                                </GridCol>
                            </GridRow>
                            <div class="form-actions">
                                <Button Type="@ButtonType.Primary" OnClick="OnCalculateBtnClick" AutoLoading>
                                    确认并进入核算
                                    <Icon Type="arrow-right" Theme="IconThemeType.Outline" />
                                </Button>
                            </div>
                        </Form>
                    </Spin>
                </section>

                <aside class="surface-card notice-card" aria-labelledby="consultation-notice-title">
                    <div class="section-heading">
                        <div>
                            <span>工作提示</span>
                            <h2 id="consultation-notice-title">注意事项</h2>
                        </div>
                        <Icon Type="notification" Theme="IconThemeType.Outline" />
                    </div>
                    @if (!UserSession.IsSystemInfoLoaded)
                    {
                        <Skeleton Active />
                    }
                    else if (string.IsNullOrEmpty(UserSession.Notice))
                    {
                        <Alert Type="AlertType.Info" Message="工作提示暂时不可用" Description="服务端内容未能加载；可以继续进行本地核算。" ShowIcon="true" />
                    }
                    else
                    {
                        @SafeMarkdown.Render(UserSession.Notice)
                    }
                </aside>
            </div>
        }
        else
        {
            <div class="active-treatment-layout">
                <aside class="client-context-rail" aria-label="当前咨询对象与页面导航">
                    <section class="surface-card client-card">
                        <div class="section-heading compact-heading">
                            <div>
                                <span>当前咨询对象</span>
                                <h2>@(string.IsNullOrWhiteSpace(CurrentArchive.Client.Name) ? "未命名对象" : CurrentArchive.Client.Name)</h2>
                            </div>
                            <Icon Type="user" Theme="IconThemeType.Outline" />
                        </div>

                        <dl class="client-facts">
                            <div><dt>性别</dt><dd>@CurrentArchive.Client.Gender</dd></div>
                            <div><dt>年龄</dt><dd>@CurrentArchive.Client.Age</dd></div>
                            <div><dt>身高</dt><dd>@CurrentArchive.Client.Height cm</dd></div>
                            <div><dt>体重</dt><dd>@CurrentArchive.Client.Weight kg</dd></div>
                            <div class="wide-fact"><dt>生理状况</dt><dd>@(string.IsNullOrEmpty(CurrentArchive.Client.SpecialPhysiologicalPeriod) ? "无" : CurrentArchive.Client.SpecialPhysiologicalPeriod)</dd></div>
                        </dl>

                        @if (CurrentArchive.CurrentEnergyCalculator?.BMI is not null)
                        {
                            <div class="client-indicators">
                                <Tag Color="@("blue")">BMI @CurrentArchive.CurrentEnergyCalculator.BMI</Tag>
                            </div>
                        }
                    </section>

                    <nav class="section-navigation" aria-label="本次咨询区段">
                        <span>本次咨询</span>
                        <Anchor Affix="false" Bounds="16" TargetOffset="24">
                            <AnchorLink Href="#nutrition-workspace" Title="专业核算" />
                            <AnchorLink Href="#nutrition-summary" Title="综合结果" />
                            <AnchorLink Href="#nutrition-advice" Title="膳食建议" />
                        </Anchor>
                    </nav>
                </aside>

                <div class="treatment-content-flow">
                    <section id="nutrition-workspace" class="surface-card workspace-card" aria-label="营养核算工作区">
                        <Tabs Class="treatment-tabs">
                            <ChildContent>
                                <TabPane Key="1" Tab="能量评估">
                                    @if (CurrentArchive.CurrentEnergyCalculator is not null)
                                    {
                                        <EnergyCalculatorTreatment EnergyCalculator="CurrentArchive.CurrentEnergyCalculator" IsTouchDetected="@UserSession.IsTouchDetected" />
                                    }
                                </TabPane>
                                <TabPane Key="2" Tab="参考摄入量">
                                    @if (CurrentArchive.DRIs is not null)
                                    {
                                        <DRIsInSightTable NutrientRanges="CurrentArchive.DRIs.NutrientRanges" />
                                    }
                                </TabPane>
                                <TabPane Key="3" Tab="膳食调查">
                                    @if (CurrentArchive.DietaryRecallSurvey is not null)
                                    {
                                        <DietarySurvey DietaryRecallSurvey="CurrentArchive.DietaryRecallSurvey" OnCalculationCompleted="DietarySurveyCalculationCompleted" />
                                    }
                                </TabPane>
                                <TabPane Key="4" Tab="SOAP 病史">
                                    @if (CurrentArchive.SubjectiveObjectiveAssessmentPlanInformation is not null)
                                    {
                                        <MedicalInformation Information="CurrentArchive.SubjectiveObjectiveAssessmentPlanInformation" />
                                    }
                                </TabPane>
                            </ChildContent>
                        </Tabs>
                    </section>

                    <section id="nutrition-summary" class="surface-card summary-card">
                        <Summary Archive="@CurrentArchive" />
                    </section>

                    <section id="nutrition-advice" class="surface-card advice-card">
                        <div class="section-heading compact-heading">
                            <div>
                                <span>综合输出</span>
                                <h2>膳食建议</h2>
                            </div>
                            <Icon Type="solution" Theme="IconThemeType.Outline" />
                        </div>
                        <Advice CurrentArchive="@CurrentArchive" />
                    </section>
                </div>
            </div>
        }
    </section>
}

@code {
    [Parameter]
    public string? Id { get; set; }

    private readonly CancellationTokenSource lifetimeCancellation = new();

    public ConsultationWorkspace? CurrentArchive { get; private set; }

    private string PageHeading => CurrentArchive switch
    {
        { ClientInfoFormEnabled: true, IsFollowUp: true } => "新建后续咨询",
        { ClientInfoFormEnabled: true } => "新建营养咨询",
        { Client.Name: { } name } when !string.IsNullOrWhiteSpace(name) => $"{name}的营养评估",
        _ => "营养评估工作区"
    };

    private string PageDescription => CurrentArchive?.ClientInfoFormEnabled switch
    {
        true when CurrentArchive.IsFollowUp => "核对本次人体测量与生理信息后，开始一份新的独立咨询记录。",
        true => "先录入必要的人体测量与生理信息，再进入各项专业核算。",
        _ => "按需切换能量评估、参考摄入量、膳食调查与 SOAP 病史。"
    };

    protected override void OnParametersSet()
    {
        if (Guid.TryParse(Id, out var archiveId) && WorkspaceManager.TryGetValue(archiveId, out var archive))
        {
            CurrentArchive = archive;
            return;
        }

        CurrentArchive = null;
        Navigation.NavigateTo("/");
    }

    private async Task OnCalculateBtnClick()
    {
        if (CurrentArchive is null)
        {
            return;
        }

        await WorkspaceManager.ClientInfoConfirmed(CurrentArchive, lifetimeCancellation.Token);
    }

    private void DietarySurveyCalculationCompleted()
    {
        StateHasChanged();
    }

    public void Dispose()
    {
        lifetimeCancellation.Cancel();
        lifetimeCancellation.Dispose();
    }
}
