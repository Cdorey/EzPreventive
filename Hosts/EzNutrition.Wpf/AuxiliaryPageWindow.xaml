<Window x:Class="EzNutrition.Wpf.AuxiliaryPageWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:presentation="clr-namespace:EzNutrition.Presentation;assembly=EzNutrition.Presentation"
        Width="1100"
        Height="800"
        MinWidth="820"
        MinHeight="600"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <blazor:BlazorWebView x:Name="BlazorView"
                          HostPage="wwwroot\hybrid.html"
                          Services="{DynamicResource BlazorServices}"
                          BlazorWebViewInitializing="ConfigureBlazorWebView">
        <blazor:BlazorWebView.RootComponents>
            <blazor:RootComponent Selector="#app" ComponentType="{x:Type presentation:App}" />
        </blazor:BlazorWebView.RootComponents>
    </blazor:BlazorWebView>
</Window>
