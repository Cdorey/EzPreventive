<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ApplicationIcon>..\..\Libraries\EzNutrition.Presentation\wwwroot\favicon.ico</ApplicationIcon>
    <Description>EzNutrition 的 WPF Blazor Hybrid 本地宿主。</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="10.0.100" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Libraries\EzNutrition.Assessments.Common\EzNutrition.Assessments.Common.csproj" />
    <ProjectReference Include="..\..\Libraries\EzNutrition.Presentation\EzNutrition.Presentation.csproj" />
    <ProjectReference Include="..\..\Libraries\EzNutrition.Application\EzNutrition.Application.csproj" />
    <ProjectReference Include="..\..\Libraries\EzNutrition.Archives.Contracts\EzNutrition.Archives.Contracts.csproj" />
    <ProjectReference Include="..\..\Libraries\EzNutrition.Archives.Xml\EzNutrition.Archives.Xml.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\hybrid.html" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EzNutrition.Wpf.Tests" />
  </ItemGroup>

</Project>
