# Keep repository text deterministic across Windows, Linux, CI, and containers.
* text=auto eol=lf

# Windows command scripts require CRLF for the broadest compatibility.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets must never pass through line-ending conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.eot binary
*.otf binary
*.ttf binary

# These files contain intentional end-of-line spaces in embedded or vendored content.
EzNutrition.Server/Services/SmtpEmailSender.cs whitespace=-blank-at-eol
Libraries/EzNutrition.Presentation/wwwroot/css/open-iconic/** whitespace=-blank-at-eol
