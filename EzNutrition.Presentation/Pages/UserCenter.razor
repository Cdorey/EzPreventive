@using EzNutrition.Presentation.Services;
@using EzNutrition.Shared.Data.DTO;
@using System.ComponentModel.DataAnnotations
@attribute [Authorize]
@implements IDisposable
@inject IHttpClientFactory HttpClientFactory
@inject AccountService Account
@inject UserSessionService UserSession
@inject NavigationManager Navigator
@inject IMessageService Message
@inject CertificateUploadService CertificateUpload
@inject ILogger<UserCenter> Logger
@page "/usercenter"
<PageTitle>用户中心</PageTitle>

<section class="user-center-page">
    <header class="page-heading">
        <span>账户与权限</span>
        <h1>用户中心</h1>
        <p>查看账户资料、有效权限及专业资质认证进度。</p>
    </header>

    <AuthorizeView>
        <Authorized>
            @if (UserInfo is not null)
            {
                <div class="profile-grid">
                    <section class="surface-card">
                        <div class="card-heading">
                            <div>
                                <span>账户资料</span>
                                <h2>@UserInfo.UserName</h2>
                            </div>
                            <Icon Type="user" Theme="IconThemeType.Outline" />
                        </div>
                        <Descriptions Bordered Column="@(new Dictionary<string,int>{{ "xs", 1}, {"md", 2}})">
                            <DescriptionsItem Title="邮箱">
                                <div class="verified-value">
                                    <span class="breakable">@UserInfo.Email</span>
                                    <Tag Color="@(UserInfo.EmailConfirmed ? "success" : "warning")">
                                        @(UserInfo.EmailConfirmed ? "已验证" : "未验证")
                                    </Tag>
                                </div>
                            </DescriptionsItem>
                            <DescriptionsItem Title="手机号码">
                                <div class="verified-value">
                                    <span>@(string.IsNullOrWhiteSpace(UserInfo.PhoneNumber) ? "未填写" : UserInfo.PhoneNumber)</span>
                                    <Tag Color="@(UserInfo.PhoneNumberConfirmed ? "success" : "default")">
                                        @(UserInfo.PhoneNumberConfirmed ? "已验证" : "未验证")
                                    </Tag>
                                </div>
                            </DescriptionsItem>
                            <DescriptionsItem Title="UID"><span class="breakable">@UserInfo.UserId</span></DescriptionsItem>
                            <DescriptionsItem Title="有效角色">
                                <div class="tag-list">
                                    @foreach (var role in UserInfo.Roles)
                                    {
                                        <Tag Color="@("blue")">@role</Tag>
                                    }
                                </div>
                            </DescriptionsItem>
                        </Descriptions>
                    </section>

                    <section class="surface-card">
                        <div class="card-heading">
                            <div>
                                <span>安全操作</span>
                                <h2>账户安全</h2>
                            </div>
                            <Icon Type="lock" Theme="IconThemeType.Outline" />
                        </div>
                        <div class="account-security-actions">
                            @if (!UserInfo.EmailConfirmed)
                            {
                                <Button OnClick="ResendConfirmationAsync" AutoLoading>
                                    <Icon Type="mail" Theme="IconThemeType.Outline" />
                                    重发确认邮件
                                </Button>
                            }
                            <Button OnClick="OpenEmailChange">
                                <Icon Type="swap" Theme="IconThemeType.Outline" />
                                修改邮箱
                            </Button>
                            <Button OnClick="OpenPhoneChange">
                                <Icon Type="phone" Theme="IconThemeType.Outline" />
                                修改手机号码
                            </Button>
                            <Button Type="ButtonType.Primary" OnClick="OpenPasswordChange">
                                <Icon Type="key" Theme="IconThemeType.Outline" />
                                修改密码
                            </Button>
                        </div>
                        <Alert Class="phone-verification-note"
                               Type="AlertType.Info"
                               Message="手机号码修改后为未验证状态"
                               Description="当前版本尚未接入短信验证码；未验证号码不会用于密码找回或可信身份判断。"
                               ShowIcon="true" />
                    </section>

                    @if (UserInfo.Claims.Count > 0)
                    {
                        <section class="surface-card">
                            <div class="card-heading">
                                <div>
                                    <span>专业权限</span>
                                    <h2>有效认证声明</h2>
                                </div>
                                <Icon Type="safety-certificate" Theme="IconThemeType.Outline" />
                            </div>
                            <Descriptions Bordered Column="1">
                                @foreach (var claim in UserInfo.Claims)
                                {
                                    <DescriptionsItem Title="@claim.Type"><span class="breakable">@claim.Value</span></DescriptionsItem>
                                }
                            </Descriptions>
                        </section>
                    }
                </div>

                <Modal Title="修改密码"
                       @bind-Visible="changePasswordDialog"
                       MaskClosable="@(!accountOperationSending)"
                       Closable="@(!accountOperationSending)"
                       CancelButtonProps="@AccountCancelButtonProps"
                       OnCancel="ClosePasswordChange"
                       OnOk="SubmitPasswordChangeAsync"
                       ConfirmLoading="accountOperationSending">
                    <Form Model="@changePasswordDto" Layout="FormLayout.Vertical">
                        <ChildContent Context="formContext">
                            <FormItem Label="当前密码">
                                <InputPassword @bind-Value="@formContext.CurrentPassword" />
                            </FormItem>
                            <FormItem Label="新密码">
                                <InputPassword Placeholder="至少 6 个字符" @bind-Value="@formContext.NewPassword" />
                            </FormItem>
                            <FormItem Label="确认新密码">
                                <InputPassword @bind-Value="@formContext.ConfirmPassword" />
                            </FormItem>
                        </ChildContent>
                    </Form>
                </Modal>

                <Modal Title="修改电子邮箱"
                       @bind-Visible="changeEmailDialog"
                       MaskClosable="@(!accountOperationSending)"
                       Closable="@(!accountOperationSending)"
                       CancelButtonProps="@AccountCancelButtonProps"
                       OnCancel="CloseEmailChange"
                       OnOk="SubmitEmailChangeAsync"
                       ConfirmLoading="accountOperationSending">
                    <Alert Class="modal-note"
                           Type="AlertType.Info"
                           Message="新邮箱需要再次确认"
                           Description="确认邮件会发送到新邮箱；点击邮件中的确认按钮前，当前邮箱保持不变。"
                           ShowIcon="true" />
                    <Form Model="@requestEmailChangeDto" Layout="FormLayout.Vertical">
                        <ChildContent Context="formContext">
                            <FormItem Label="新电子邮箱">
                                <Input Placeholder="name@example.com" @bind-Value="@formContext.NewEmail" />
                            </FormItem>
                            <FormItem Label="当前密码">
                                <InputPassword @bind-Value="@formContext.CurrentPassword" />
                            </FormItem>
                        </ChildContent>
                    </Form>
                </Modal>

                <Modal Title="修改手机号码"
                       @bind-Visible="changePhoneDialog"
                       MaskClosable="@(!accountOperationSending)"
                       Closable="@(!accountOperationSending)"
                       CancelButtonProps="@AccountCancelButtonProps"
                       OnCancel="ClosePhoneChange"
                       OnOk="SubmitPhoneChangeAsync"
                       ConfirmLoading="accountOperationSending">
                    <Alert Class="modal-note"
                           Type="AlertType.Warning"
                           Message="当前仅修改联系方式"
                           Description="留空可清除手机号码；新号码会标记为未验证。"
                           ShowIcon="true" />
                    <Form Model="@changePhoneNumberDto" Layout="FormLayout.Vertical">
                        <ChildContent Context="formContext">
                            <FormItem Label="手机号码">
                                <Input Placeholder="留空以清除" @bind-Value="@formContext.PhoneNumber" />
                            </FormItem>
                            <FormItem Label="当前密码">
                                <InputPassword @bind-Value="@formContext.CurrentPassword" />
                            </FormItem>
                        </ChildContent>
                    </Form>
                </Modal>

                <section class="surface-card certification-records">
                    <div class="section-toolbar">
                        <div>
                            <span>认证记录</span>
                            <h2>专业资质认证申请</h2>
                            <p>历史申请和当前审核状态均保留在此处。</p>
                        </div>
                        <Button Type="ButtonType.Primary" OnClick="@(()=> createCertificationRequestDialog = true)">
                            <Icon Type="plus" Theme="IconThemeType.Outline" />
                            提交新申请
                        </Button>
                    </div>

                    <Table DataSource="ProfessionalCertificationRequestDtos" Size="TableSize.Small" ScrollX="960">
                        <ChildContent Context="requests">
                            <PropertyColumn Property="r=>r.RequestTime" Title="申请时间" />
                            <PropertyColumn Property="r=>r.IdentityType" Title="申请类别" />
                            <PropertyColumn Property="r=>r.ProcessedTime" Title="审核时间" />
                            <PropertyColumn Property="r=>r.ProcessDetails" Title="审核备注" />
                            <PropertyColumn Property="r=>r.Remarks" Title="认证备注" />
                            <PropertyColumn Property="r=>r.Status" Title="审核结果">
                                <EnumSelect TEnum="RequestStatus" Value="@requests.Status" Disabled />
                            </PropertyColumn>
                        </ChildContent>
                    </Table>
                </section>

                <Modal Title="@("专业资质认证申请")"
                       @bind-Visible="@createCertificationRequestDialog"
                       Width="1000"
                       MaxBodyHeight="calc(100dvh - 180px)"
                       OnCancel="InitCertificationRequestDialog"
                       OnOk="SubmitCertificationRequest"
                       ConfirmLoading="@certificationRequestSending">
                    <ProfessionalCertification ProfessionalIdentityDto="@professionalIdentityDto" OnFileSelected="HandleFileSelected" Filename="@(currentSelectedFile?.Name??string.Empty)" />
                </Modal>
            }
        </Authorized>
        <NotAuthorized>
            <Result Status="ResultStatus.Warning" Title="尚未登录" SubTitle="登录后才能查看账户与专业认证信息。" />
        </NotAuthorized>
    </AuthorizeView>
</section>

@code {
    private bool createCertificationRequestDialog = false;
    private UserInfoDto? UserInfo { get; set; }
    private List<ProfessionalCertificationRequestDto> ProfessionalCertificationRequestDtos { get; set; } = [];

    private ProfessionalIdentityDto professionalIdentityDto { get; set; } = new ProfessionalIdentityDto { IdentityType = string.Empty, InstitutionName = string.Empty };
    private IBrowserFile? currentSelectedFile;
    private bool certificationRequestSending = false;
    private readonly CancellationTokenSource lifetimeCancellation = new();
    private string? pendingUploadTicket;
    private bool changePasswordDialog;
    private bool changeEmailDialog;
    private bool changePhoneDialog;
    private bool accountOperationSending;
    private ChangePasswordDto changePasswordDto = new();
    private RequestEmailChangeDto requestEmailChangeDto = new();
    private ChangePhoneNumberDto changePhoneNumberDto = new();
    private ButtonProps AccountCancelButtonProps => new() { Disabled = accountOperationSending };

    private async Task ResendConfirmationAsync()
    {
        if (UserInfo is null)
        {
            return;
        }

        try
        {
            var result = await Account.ResendEmailConfirmationAsync(
                UserInfo.Email,
                lifetimeCancellation.Token);
            await Message.SuccessAsync(result.Message);
        }
        catch (OperationCanceledException) when (lifetimeCancellation.IsCancellationRequested)
        {
        }
        catch (Exception ex) when (ex is InvalidOperationException or HttpRequestException)
        {
            Logger.LogWarning(ex, "Unable to resend the account confirmation email.");
            await Message.ErrorAsync(ex.Message);
        }
    }

    private void OpenPasswordChange()
    {
        changePasswordDto = new ChangePasswordDto();
        changePasswordDialog = true;
    }

    private void ClosePasswordChange()
    {
        if (accountOperationSending)
        {
            return;
        }

        changePasswordDialog = false;
        changePasswordDto = new ChangePasswordDto();
    }

    private async Task SubmitPasswordChangeAsync()
    {
        if (!AccountFormValidation.TryValidate(changePasswordDto, out var validationMessage))
        {
            await Message.ErrorAsync(validationMessage);
            return;
        }

        accountOperationSending = true;
        try
        {
            var result = await Account.ChangePasswordAsync(
                changePasswordDto,
                lifetimeCancellation.Token);
            await Message.SuccessAsync(result.Message);
            ClosePasswordChange();
            await SignOutAfterSecurityChangeAsync();
        }
        catch (OperationCanceledException) when (lifetimeCancellation.IsCancellationRequested)
        {
        }
        catch (Exception ex) when (ex is InvalidOperationException or HttpRequestException)
        {
            Logger.LogWarning(ex, "Unable to change the account password.");
            await Message.ErrorAsync(ex.Message);
        }
        finally
        {
            accountOperationSending = false;
        }
    }

    private void OpenEmailChange()
    {
        requestEmailChangeDto = new RequestEmailChangeDto();
        changeEmailDialog = true;
    }

    private void CloseEmailChange()
    {
        if (accountOperationSending)
        {
            return;
        }

        changeEmailDialog = false;
        requestEmailChangeDto = new RequestEmailChangeDto();
    }

    private async Task SubmitEmailChangeAsync()
    {
        if (!AccountFormValidation.TryValidate(requestEmailChangeDto, out var validationMessage))
        {
            await Message.ErrorAsync(validationMessage);
            return;
        }

        accountOperationSending = true;
        try
        {
            var result = await Account.RequestEmailChangeAsync(
                requestEmailChangeDto,
                lifetimeCancellation.Token);
            await Message.SuccessAsync(result.Message);
            accountOperationSending = false;
            CloseEmailChange();
        }
        catch (OperationCanceledException) when (lifetimeCancellation.IsCancellationRequested)
        {
        }
        catch (Exception ex) when (ex is InvalidOperationException or HttpRequestException)
        {
            Logger.LogWarning(ex, "Unable to request an account email change.");
            await Message.ErrorAsync(ex.Message);
        }
        finally
        {
            accountOperationSending = false;
        }
    }

    private void OpenPhoneChange()
    {
        changePhoneNumberDto = new ChangePhoneNumberDto
        {
            PhoneNumber = UserInfo?.PhoneNumber
        };
        changePhoneDialog = true;
    }

    private void ClosePhoneChange()
    {
        if (accountOperationSending)
        {
            return;
        }

        changePhoneDialog = false;
        changePhoneNumberDto = new ChangePhoneNumberDto();
    }

    private async Task SubmitPhoneChangeAsync()
    {
        if (!AccountFormValidation.TryValidate(changePhoneNumberDto, out var validationMessage))
        {
            await Message.ErrorAsync(validationMessage);
            return;
        }

        accountOperationSending = true;
        try
        {
            var result = await Account.ChangePhoneNumberAsync(
                changePhoneNumberDto,
                lifetimeCancellation.Token);
            await Message.SuccessAsync(result.Message);
            ClosePhoneChange();
            await SignOutAfterSecurityChangeAsync();
        }
        catch (OperationCanceledException) when (lifetimeCancellation.IsCancellationRequested)
        {
        }
        catch (Exception ex) when (ex is InvalidOperationException or HttpRequestException)
        {
            Logger.LogWarning(ex, "Unable to change the account phone number.");
            await Message.ErrorAsync(ex.Message);
        }
        finally
        {
            accountOperationSending = false;
        }
    }

    private async Task SignOutAfterSecurityChangeAsync()
    {
        await UserSession.SignOutAsync();
        Navigator.NavigateTo("", replace: true);
    }

    private async Task SubmitCertificationRequest()
    {
        if (certificationRequestSending)
        {
            return;
        }

        certificationRequestSending = true;
        try
        {
            if (!TryValidate(professionalIdentityDto, out var validationMessage))
            {
                await Message.ErrorAsync(validationMessage);
                return;
            }

            if (currentSelectedFile is null)
            {
                await Message.ErrorAsync("请选择要上传的证明图片。");
                return;
            }

            await Message.InfoAsync("正在提交认证信息");
            if (pendingUploadTicket is null)
            {
                var httpClient = HttpClientFactory.CreateClient("Authorize");
                using var response = await httpClient.PostAsJsonAsync(
                    "User/CreateProfessionalIdentity",
                    professionalIdentityDto,
                    lifetimeCancellation.Token);
                if (!response.IsSuccessStatusCode)
                {
                    await Message.ErrorAsync("认证信息提交失败，请检查填写内容后重试。");
                    return;
                }

                var result = await response.Content.ReadFromJsonAsync<RegistrationResultDto>(
                    lifetimeCancellation.Token);
                if (result?.Success is not true)
                {
                    await Message.ErrorAsync(result?.Message ?? "认证信息提交失败。");
                    return;
                }

                if (string.IsNullOrWhiteSpace(result.UploadTicket))
                {
                    throw new InvalidOperationException("服务器没有返回有效的证明图片上传票据。");
                }

                pendingUploadTicket = result.UploadTicket;
            }

            await CertificateUpload.UploadAsync(
                pendingUploadTicket,
                currentSelectedFile,
                lifetimeCancellation.Token);
            pendingUploadTicket = null;
            await Message.SuccessAsync("认证信息提交成功");
            InitCertificationRequestDialog();
            await TryRefreshProfessionalIdentitiesAsync();
        }
        catch (OperationCanceledException) when (lifetimeCancellation.IsCancellationRequested)
        {
        }
        catch (Exception ex) when (ex is InvalidOperationException or HttpRequestException or IOException or NotSupportedException or System.Text.Json.JsonException)
        {
            Logger.LogWarning(ex, "Professional certification submission failed.");
            await Message.ErrorAsync(
                pendingUploadTicket is not null
                    ? "申请记录已创建，但图片上传失败；请保留当前窗口并再次点击提交重试上传。"
                    : ex is InvalidOperationException
                    ? ex.Message
                    : "认证信息或证明图片提交失败，请稍后重试。");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected professional certification submission error.");
            await Message.ErrorAsync("认证信息提交过程中发生异常，请稍后重试。");
        }
        finally
        {
            certificationRequestSending = false;
        }
    }

    private void InitCertificationRequestDialog()
    {
        professionalIdentityDto = new ProfessionalIdentityDto { IdentityType = string.Empty, InstitutionName = string.Empty };
        currentSelectedFile = null;
        pendingUploadTicket = null;
        certificationRequestSending = false;
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        currentSelectedFile = e.File;
    }

    private async Task GetProfile()
    {
        UserInfo = await Account.GetProfileAsync(lifetimeCancellation.Token);
    }

    private async Task GetProfessionalIdentities()
    {
        ProfessionalCertificationRequestDtos.Clear();
        var httpClient = HttpClientFactory.CreateClient("Authorize");
        try
        {
            var x = await httpClient.GetFromJsonAsync<List<ProfessionalCertificationRequestDto>>(
                "User/ProfessionalIdentity",
                lifetimeCancellation.Token);
            if (x?.Count > 0)
            {
                ProfessionalCertificationRequestDtos.AddRange(x);
            }
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            return;
        }
    }

    private async Task TryRefreshProfessionalIdentitiesAsync()
    {
        try
        {
            await GetProfessionalIdentities();
        }
        catch (OperationCanceledException) when (lifetimeCancellation.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Unable to refresh professional certification requests.");
            await Message.WarningAsync("认证信息已提交，但列表刷新失败；请重新打开用户中心确认结果。");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await GetProfile();
            await GetProfessionalIdentities();
        }
        catch (OperationCanceledException) when (lifetimeCancellation.IsCancellationRequested)
        {
        }
        catch (Exception ex) when (ex is InvalidOperationException or HttpRequestException or NotSupportedException or System.Text.Json.JsonException)
        {
            Logger.LogWarning(ex, "Unable to initialize the user center.");
            await Message.ErrorAsync("用户信息加载失败，请稍后重试。");
        }
    }

    private static bool TryValidate(object value, out string validationMessage)
    {
        var validationResults = new List<ValidationResult>();
        var isValid = Validator.TryValidateObject(
            value,
            new ValidationContext(value),
            validationResults,
            validateAllProperties: true);
        validationMessage = string.Join("；", validationResults.Select(result => result.ErrorMessage));
        return isValid;
    }

    public void Dispose()
    {
        lifetimeCancellation.Cancel();
        lifetimeCancellation.Dispose();
    }
}
