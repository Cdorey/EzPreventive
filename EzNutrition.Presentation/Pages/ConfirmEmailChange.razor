@page "/account/confirm-email-change"
@using EzNutrition.Presentation.Services
@using EzNutrition.Shared.Data.DTO
@implements IDisposable
@inject AccountService Account
@inject UserSessionService UserSession
@inject NavigationManager Navigator
@inject IJSRuntime JS
@inject ILogger<ConfirmEmailChange> Logger
<PageTitle>确认新邮箱</PageTitle>

<AccountActionCard Title="确认新的电子邮箱"
                   Description="为避免邮件安全扫描器误触发，邮箱不会自动修改；请核对后手动确认。"
                   IconType="swap">
    @if (completed)
    {
        <Result Status="ResultStatus.Success"
                Title="邮箱修改成功"
                SubTitle="@resultMessage">
            <Extra>
                <Button Type="ButtonType.Primary" OnClick="GoHome">重新登录</Button>
            </Extra>
        </Result>
    }
    else if (!HasValidLink)
    {
        <Result Status="ResultStatus.Error"
                Title="邮箱变更链接不完整"
                SubTitle="请使用发送到新邮箱的完整链接。">
            <Extra>
                <Button Type="ButtonType.Primary" OnClick="GoHome">返回登录</Button>
            </Extra>
        </Result>
    }
    else
    {
        <Alert Type="AlertType.Info"
               Message="即将修改账户邮箱"
               Description="@($"确认后，账户邮箱将修改为 {confirmation.NewEmail}，旧登录凭据会失效。")"
               ShowIcon="true" />
        @if (errorMessage is not null)
        {
            <Alert Message="@errorMessage" Type="AlertType.Error" ShowIcon="true" />
        }
        <div class="action-buttons">
            <Button Type="ButtonType.Primary" OnClick="ConfirmAsync" AutoLoading>确认修改邮箱</Button>
            <Button OnClick="GoHome">取消</Button>
        </div>
    }
</AccountActionCard>

@code {
    [Parameter, SupplyParameterFromQuery(Name = "userId")]
    public string? UserId { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "newEmail")]
    public string? NewEmail { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private readonly CancellationTokenSource lifetimeCancellation = new();
    private readonly ConfirmEmailChangeDto confirmation = new();
    private bool completed;
    private bool linkCaptured;
    private bool scrubQueryOnNextRender;
    private string? errorMessage;
    private string resultMessage = string.Empty;
    private bool HasValidLink =>
        !string.IsNullOrWhiteSpace(confirmation.UserId) &&
        !string.IsNullOrWhiteSpace(confirmation.NewEmail) &&
        !string.IsNullOrWhiteSpace(confirmation.Token);

    protected override void OnParametersSet()
    {
        if (linkCaptured)
        {
            return;
        }

        linkCaptured = true;
        confirmation.UserId = UserId ?? string.Empty;
        confirmation.NewEmail = NewEmail ?? string.Empty;
        confirmation.Token = Token ?? string.Empty;
        if (HasValidLink)
        {
            scrubQueryOnNextRender = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!scrubQueryOnNextRender)
        {
            return;
        }

        scrubQueryOnNextRender = false;
        try
        {
            await JS.InvokeVoidAsync("ezNutrition.scrubCurrentQuery");
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Unable to remove the email change token from the address bar.");
        }
    }

    private async Task ConfirmAsync()
    {
        errorMessage = null;
        try
        {
            var result = await Account.ConfirmEmailChangeAsync(
                confirmation,
                lifetimeCancellation.Token);
            await UserSession.SignOutAsync();
            resultMessage = result.Message;
            completed = true;
        }
        catch (OperationCanceledException) when (lifetimeCancellation.IsCancellationRequested)
        {
        }
        catch (Exception ex) when (ex is InvalidOperationException or HttpRequestException)
        {
            Logger.LogWarning(ex, "Email change confirmation failed in the browser.");
            errorMessage = ex.Message;
        }
    }

    private void GoHome() => Navigator.NavigateTo("");

    public void Dispose()
    {
        lifetimeCancellation.Cancel();
        lifetimeCancellation.Dispose();
    }
}
