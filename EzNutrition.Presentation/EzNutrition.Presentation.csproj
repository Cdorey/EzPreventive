<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Description>EzNutrition 各交互式客户端宿主共享的 Razor 工作台与远程服务适配。</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AntDesign" Version="1.6.2" />
    <PackageReference Include="Microsoft.AspNetCore.Authorization" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EzNutrition.Application\EzNutrition.Application.csproj" />
    <ProjectReference Include="..\EzNutrition.Archives.Contracts\EzNutrition.Archives.Contracts.csproj" />
    <ProjectReference Include="..\EzNutrition.Domain\EzNutrition.Domain.csproj" />
    <ProjectReference Include="..\EzNutrition.UI\EzNutrition.UI.csproj" />
    <ProjectReference Include="..\EzNutrition\Shared\EzNutrition.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EzNutrition.Client.Tests" />
  </ItemGroup>

</Project>
